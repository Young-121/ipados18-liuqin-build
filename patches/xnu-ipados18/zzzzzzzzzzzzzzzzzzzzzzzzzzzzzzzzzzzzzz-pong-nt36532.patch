+#define GENI_IF_DISABLE_RO      0x64
+#define FIFO_IF_DISABLE         (1u << 0)
+#define SE_GENI_M_CMD_CTRL_REG  0x604
+#define M_GENI_CMD_ABORT        (1u << 1)
+#define M_GENI_CMD_CANCEL       (1u << 2)
+#define M_GENI_DISABLE          (1u << 0)
+#define SE_GENI_M_GP_LENGTH     0x910
+#define M_GENI_CMD_ACTIVE       (1u << 0)
+
+/* One page of physically contiguous memory stages every SE-DMA transfer;
+ * TX and RX live 256 bytes apart so a cache-line flush never overlaps. */
+/* Two 16 KiB pages inside the 5 MiB low window: one for TX, one for RX, so a
+ * 256-byte firmware piece or a 65-byte frame fits in a single transfer. */
+#define TCH_DMA_TX_OFF          0x0000
+#define TCH_DMA_RX_OFF          0x4000
+#define TCH_DMA_MAX             0x3f00
+#define TCH_DMA_SIZE            (TCH_DMA_RX_OFF + TCH_DMA_MAX)
+
+/* Printed once, before anything else this driver does.  Every log line that
+ * follows can then be attributed to a build without guessing: a log whose
+ * stamp is missing or old is a log from an older image, not a new failure. */
+#define TCH_BUILD               "touch183 keys-spmi-map"
+
+/* Novatek NT36xxx SPI protocol (vendor nt36xxx driver, SPI variant). */
+/* The vendor driver (TWRP's nt36532_touch.ko) reads the trim id at 0x1fb104
+ * and gets "20 00 00 32 65 03" on this panel.  0x3f004 is the address the
+ * nabu harness used; on this part it answers 0xff. */
+#define NVT_CHIP_VER_TRIM_ADDR  0x1fb104u
+#define NVT_CHIP_VER_TRIM_NABU  0x3f004u
+#define NVT_EVENT_BUF_ADDR      0x125800u      /* NT36532: vendor map[0] */
+/* The vendor trim table lists the chip-info page at 0x1f64e for this part;
+ * 0x2fe78 was the nabu harness's event-buffer offset. */
+#define NVT_FWINFO_ADDR         0x125878u      /* event buffer + 0x78 */
+#define NVT_MAX_FINGERS         10
+#define NVT_POINT_LEN           65             /* event byte + 10 x 6 + 4 */
+#define NVT_BUF_MAX             320      /* 256-byte verify reads + overhead */
+/* The vendor's work function reads the event block with len = 109
+ * (one count byte plus 18 six-byte records). */
+#define NVT_EVENT_BLOCK_LEN     109
+#define NVT_TOUCH_W             1800           /* framebuffer, LiuqinHID.cpp */
+#define NVT_TOUCH_H             2880
+
+/* What the driver needs to remember between the probe and the poll thread. */
+struct liuqin_touch {
+	vm_offset_t se;                 /* SE4 registers */
+	vm_offset_t tlmm;               /* TLMM registers */
+	uint32_t    tx_fifo_depth;      /* FIFO words */
+	uint32_t    bytes_per_fifo_word;
+	uint32_t    div;                /* SE clock divider */
+	uint32_t    spi_hz;
+	bool        fifo_capable;      /* GENI_IF_DISABLE_RO says FIFO works */
+	bool        bitbang;            /* drive gpio16..19 as a software SPI */
+	bool        cs_high;            /* chip select is active high */
+	bool        page8;              /* page bytes as addr>>16 / addr>>8 */
+	uint32_t    dummy;              /* dummy bytes before the data (1) */
+	int         bb_cpol;            /* clock idle level */
+	int         bb_cpha;            /* sample on the trailing edge */
+	uint32_t    pin_clk, pin_mosi, pin_miso, pin_cs;
+	uint32_t    pin_reset;          /* gpio20, active low */
+	uint32_t    bb_pace_us;         /* half clock period, default 5 us */
+	vm_offset_t dma;                /* staging page for SE DMA */
+	uint64_t    dma_pa;
+	bool        use_dma;            /* transfers go through the SE's DMA */
+	vm_offset_t smmu;               /* apps_smmu global space 0 window */
+	int         smmu_smr;           /* SMR entry matching the SE, or -1 */
+	vm_offset_t smmu_cb;            /* the bypass context bank, 0 if none */
+	uint32_t    dma_tx_status;      /* last SE_DMA_TX/RX_IRQ_STAT */
+	uint32_t    dma_rx_status;
+	uint32_t    last_irq;           /* M_IRQ_STATUS of the last command */
+	uint32_t    first_irq;          /* first M_IRQ_STATUS read of it */
+	uint32_t    status_after_cmd;   /* GENI_STATUS right after M_CMD0 */
+	uint32_t    max_x, max_y;       /* Novatek report space */
+	bool        cs_manual;          /* SE accepts CS_ASSERT/CS_DEASSERT */
+	bool        swap;               /* exchange the controller's axes */
+	bool        flip_x, flip_y;
+};
+static struct liuqin_touch tch = {
+	.max_x = NVT_TOUCH_W,
+	.max_y = NVT_TOUCH_H,
+	.div = 16,
+	.cs_manual = true,
+};
+static void *liuqin_touch_chan;
+static unsigned tch_dma_count;
+/* 0: descriptor registers first, then M_CMD0 (what every Linux release before
+ * the 2024 rework did).  1: M_CMD0 first, then the descriptor registers, which
+ * is what upstream does today and the only ordering touch151 has not tried. */
+static int tch_dma_order;
+
+/*
+ * touch159's wire capture settled the data-path question: at 4.7 kHz the same
+ * SE transfers put "ff 3f 62" on MOSI and the panel answers the real read with
+ * "20 00 00 32 65 03" - correct data, correct TX, correct RX.  At 600 kHz the
+ * same read returns garbage, so what is left is timing: how long the page
+ * write is given to settle before the read's chip select, and how long after
+ * a chip-select command the first clock may come.  The wire capture had a
+ * printf between the two transactions; the driver has almost nothing.
+ */
+static unsigned tch_page_dly;           /* us between page write and read */
+static unsigned tch_cs_dly;             /* us after CS assert before data */
+/* Set once touch165's diag proves the TX-DMA + CPU-RX-FIFO path works. */
+static int tch_rx_via_fifo;
+/* touch166: the opcode used for a duplex transfer.  Zero selects the default,
+ * SPI_DUPLEX (3): touch166's log has the same read returning the ROM trim id
+ * with 3 and garbage with 7.  liuqintouchopcode=7 selects the vendor opcode
+ * again for a comparison boot. */
+static int tch_opcode;
+/* True once any engine-side receive route returns the ROM trim id. */
+static bool tch_rx_ok;
+/*
+ * touch168: a completed transfer whose DMA status bits are late.  touch167's
+ * DMA #8 reported M_CMD_DONE, no error bit and LEN_IN tx 8 rx 8, while
+ * TX/RX_DMA_DONE both read zero - and the very next command on the same engine
+ * worked, so the bytes had moved and only the status was missing.  Counting
+ * both new acceptance routes keeps the log honest about which one is used.
+ */
+static unsigned tch_dma_late;
+static unsigned tch_dma_lenin;
+/* Failure lines already printed: a download can fail hundreds of times and the
+ * ring log is small, so the first ones are printed and the rest suppressed. */
+static unsigned tch_dma_fail_lines;
+/* Last transfer the engine rejected, for the chunk writer's one-line verdict. */
+static uint32_t tch_dma_last_irq;
+static uint32_t tch_dma_last_len;
+static uint32_t tch_dma_last_cmd;
+/* touch170: cancels issued after a timeout.  A timeout leaves the command
+ * ACTIVE; the cancel is what keeps the retry from stacking on top of it. */
+static unsigned tch_dma_cancels;
+
+static uint32_t
+tch_duplex_opcode(void)
+{
+	return (tch_opcode != 0) ? (uint32_t)tch_opcode : SPI_DUPLEX;
+}
+
+static uint32_t
+tch_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+tch_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile ("dmb oshst" ::: "memory");
+}
+
+/* geni_se_irq_clear(): drop every pending interrupt source. */
+static void
+tch_irq_clear(void)
+{
+	tch_wr(tch.se, SE_GSI_EVENT_EN, 0);
+	tch_wr(tch.se, SE_GENI_M_IRQ_CLEAR, 0xffffffff);
+	tch_wr(tch.se, SE_GENI_S_IRQ_CLEAR, 0xffffffff);
+	tch_wr(tch.se, SE_DMA_TX_IRQ_CLR, 0xffffffff);
+	tch_wr(tch.se, SE_DMA_RX_IRQ_CLR, 0xffffffff);
+	tch_wr(tch.se, SE_IRQ_EN, 0xffffffff);
+}
+
+/* geni_se_select_mode(GENI_SE_FIFO): non-UART, so only the primary
+ * sequencer is interesting; DMA mode is off and the four FIFO interrupts
+ * that the polled transfer watches are on. */
+static void
+tch_fifo_mode(void)
+{
+	tch_irq_clear();
+	tch_wr(tch.se, SE_GENI_M_IRQ_EN, tch_rd(tch.se, SE_GENI_M_IRQ_EN) |
+	    M_CMD_DONE_EN | M_TX_FIFO_WATERMARK_EN |
+	    M_RX_FIFO_WATERMARK_EN | M_RX_FIFO_LAST_EN);
+	tch_wr(tch.se, SE_GENI_DMA_MODE_EN,
+	    tch_rd(tch.se, SE_GENI_DMA_MODE_EN) & ~GENI_DMA_MODE_EN);
+}
+
+/* geni_se_config_packing(), reduced to byte-aligned words (8 bits here):
+ * each 8-bit word is one packing vector, MSB first, and the FIFO word takes
+ * `pack_words` of them. */
+static void
+tch_config_packing(uint32_t bpw, uint32_t pack_words)
+{
+	uint32_t cfg[4] = { 0, 0, 0, 0 };
+	const uint32_t ceil_bpw = (bpw + 7) & ~7u;
+	const uint32_t iter = (ceil_bpw * pack_words) / 8;
+	const int idx_start = (int)bpw - 1;             /* msb_to_lsb */
+	int32_t temp_bpw = (int32_t)bpw;
+	int idx = idx_start;
+
+	if (iter == 0 || iter > 4) {
+		return;
+	}
+	for (uint32_t i = 0; i < iter; i++) {
+		const int len = (temp_bpw < 8 ? temp_bpw : 8) - 1;
+		cfg[i] = ((uint32_t)idx << 5) | (1u << 4) | ((uint32_t)len << 1);
+		if (temp_bpw <= 8) {
+			idx = (int)((i + 1) * 8) + idx_start;
+			temp_bpw = (int32_t)bpw;
+		} else {
+			idx -= 8;
+			temp_bpw -= 8;
+		}
+	}
+	cfg[iter - 1] |= 1u;                            /* PACKING_STOP_BIT */
+	tch_wr(tch.se, SE_GENI_TX_PACKING_CFG0, cfg[0] | (cfg[1] << 10));
+	tch_wr(tch.se, SE_GENI_TX_PACKING_CFG1, cfg[2] | (cfg[3] << 10));
+	tch_wr(tch.se, SE_GENI_RX_PACKING_CFG0, cfg[0] | (cfg[1] << 10));
+	tch_wr(tch.se, SE_GENI_RX_PACKING_CFG1, cfg[2] | (cfg[3] << 10));
+	/* Protocol words per FIFO entry: 0 = 4x8, 1 = 2x16, 2 = 1x32. */
+	tch_wr(tch.se, SE_GENI_BYTE_GRAN, (bpw / 16) & 3u);
+}
+
+/* Pull whatever the RX FIFO holds into rx[].  Called while a command runs so
+ * that a transfer longer than the FIFO cannot overflow it. */
+static void
+tch_drain_rx(uint8_t *rx, size_t rxlen, size_t *rxgot)
+{
+	uint32_t wc = tch_rd(tch.se, SE_GENI_RX_FIFO_STATUS) & RX_FIFO_WC_MSK;
+
+	while (wc-- > 0) {
+		const uint32_t word = tch_rd(tch.se, SE_GENI_RX_FIFOn);
+		for (uint32_t b = 0; b < tch.bytes_per_fifo_word; b++) {
+			if (*rxgot < rxlen) {
+				rx[(*rxgot)++] = (uint8_t)(word >> (8 * b));
+			}
+		}
+	}
+}
+
+static uint32_t
+tch_status(void)
+{
+	return tch_rd(tch.se, SE_GENI_M_IRQ_STATUS);
+}
+
+/* Issue one M_CMD0 opcode and wait for it, feeding the TX FIFO from tx[] and
+ * draining the RX FIFO into rx[] meanwhile.  Returns the final
+ * M_IRQ_STATUS; M_CMD_DONE_EN set means the command completed. */
+static uint32_t
+tch_run_cmd(uint32_t cmd, const uint8_t *tx, size_t txlen,
+    uint8_t *rx, size_t rxlen, size_t *rxgot, unsigned ms)
+{
+	const uint32_t errs = M_CMD_OVERRUN_EN | M_ILLEGAL_CMD_EN |
+	    M_CMD_FAILURE_EN | M_CMD_CANCEL_EN | M_CMD_ABORT_EN |
+	    M_RX_FIFO_RD_ERR_EN | M_RX_FIFO_WR_ERR_EN |
+	    M_TX_FIFO_RD_ERR_EN | M_TX_FIFO_WR_ERR_EN;
+	size_t txdone = 0;
+	uint32_t irq = 0;
+
+	tch_wr(tch.se, SE_GENI_M_CMD0, cmd);
+	tch.status_after_cmd = tch_rd(tch.se, SE_GENI_STATUS);
+	for (unsigned i = 0; i < ms * 20; i++) {
+		if (tx != NULL && txdone < txlen) {
+			const uint32_t wc = tch_rd(tch.se, SE_GENI_TX_FIFO_STATUS) & TX_FIFO_WC_MSK;
+			uint32_t room = tch.tx_fifo_depth > wc ? tch.tx_fifo_depth - wc : 0;
+
+			while (room > 0 && txdone < txlen) {
+				uint32_t word = 0;
+
+				for (uint32_t b = 0; b < tch.bytes_per_fifo_word && txdone < txlen; b++) {
+					word |= (uint32_t)tx[txdone++] << (8 * b);
+				}
+				tch_wr(tch.se, SE_GENI_TX_FIFOn, word);
+				room--;
+			}
+		}
+		if (rx != NULL) {
+			tch_drain_rx(rx, rxlen, rxgot);
+		}
+		irq = tch_status();
+		if (i == 0) {
+			tch.first_irq = irq;
+		}
+		if (irq & (M_CMD_DONE_EN | errs)) {
+			break;
+		}
+		delay(50);
+	}
+	if (rx != NULL) {
+		tch_drain_rx(rx, rxlen, rxgot);
+	}
+	tch_wr(tch.se, SE_GENI_M_IRQ_CLEAR, irq ? irq : 0xffffffff);
+	tch.last_irq = irq;
+	return irq;
+}
+
+/* One SPI transfer through the FIFOs: mode 0, 8-bit words, both directions
+ * when rx is given.  Only used when GENI_IF_DISABLE_RO says the FIFO exists. */
+static int
+tch_fifo_xfer(const uint8_t *tx, uint8_t *rx, size_t len)
+{
+	uint32_t cmd = 0;
+	size_t got = 0;
+
+	if (len == 0 || len > TRANS_LEN_MSK) {
+		return -1;
+	}
+	if (tx != NULL) {
+		tch_wr(tch.se, SE_SPI_TX_TRANS_LEN, (uint32_t)len & TRANS_LEN_MSK);
+	}
+	if (rx != NULL) {
+		tch_wr(tch.se, SE_SPI_RX_TRANS_LEN, (uint32_t)len & TRANS_LEN_MSK);
+	}
+	cmd = (tx != NULL && rx != NULL) ? SPI_TX_RX :
+	    (tx != NULL ? SPI_TX_ONLY : SPI_RX_ONLY);
+	tch_fifo_mode();
+	const uint32_t irq = tch_run_cmd((cmd << M_OPCODE_SHFT) | FRAGMENTATION,
+	    tx, tx != NULL ? len : 0, rx, rx != NULL ? len : 0, &got, 50);
+	if ((irq & M_CMD_DONE_EN) == 0) {
+		return -1;
+	}
+	if (rx != NULL && got < len) {
+		return -1;
+	}
+	return 0;
+}
+
+/*
+ * Software SPI on the four touch pads.
+ *
+ * This serial engine has no FIFO interface (GENI_IF_DISABLE_RO) and its own
+ * DMA wedges the interconnect on this port's memory map, so the pads are
+ * driven as plain GPIOs instead: mode 0, MSB first, clock stretching harmless.
+ * The TLMM register is one 0x1000 block per pin; its IO register is at +0x4
+ * with the output value in bit 1 and the input in bit 0 (SM8450 PINGROUP).
+ */
+/* Shadow copy of each pad's IO register; see bb_set(). */
+static uint32_t bb_shadow[6];           /* index pin - 16 */
+
+static void
+tch_bb_dir(uint32_t pin, bool out, int level)
+{
+	uint32_t io = tch_rd(tch.tlmm, TLMM_CTL(pin) + TLMM_IN_OUT);
+
+	io = (io & ~TLMM_OUT_BIT) | (level ? TLMM_OUT_BIT : 0);
+	tch_wr(tch.tlmm, TLMM_CTL(pin) + TLMM_IN_OUT, io);
+	if (pin - 16 < 6) {
+		bb_shadow[pin - 16] = io & ~TLMM_IN_BIT;
+	}
+	/* mux 0 (GPIO), no pull, 6 mA, output enable in bit 9 */
+	tch_wr(tch.tlmm, TLMM_CTL(pin), (out ? (1u << 9) : 0) | (2u << 6));
+}
+
+/*
+ * Shadow copy of each pad's IO register.  The bit-banged bus used to do a
+ * read-modify-write per edge, and on this port every TLMM access costs
+ * microseconds: five accesses per bit is what made a 245 KiB download take
+ * 84 seconds.  Writing the shadow needs no read at all.
+ */
+static inline uint32_t *
+bb_io(uint32_t pin)
+{
+	return (uint32_t *)(tch.tlmm + TLMM_CTL(pin) + TLMM_IN_OUT);
+}
+
+static inline void
+bb_set(uint32_t pin, int level)
+{
+	volatile uint32_t *io = (volatile uint32_t *)bb_io(pin);
+	const unsigned idx = pin - 16;
+
+	if (idx < 6) {
+		bb_shadow[idx] = (bb_shadow[idx] & ~TLMM_OUT_BIT) | (level ? TLMM_OUT_BIT : 0);
+		*io = bb_shadow[idx];
+	} else {
+		const uint32_t v = *io;
+
+		*io = (v & ~TLMM_OUT_BIT) | (level ? TLMM_OUT_BIT : 0);
+	}
+}
+
+static inline int
+bb_get(uint32_t pin)
+{
+	const uint32_t v = *(volatile uint32_t *)(tch.tlmm + TLMM_CTL(pin) + TLMM_IN_OUT);
+
+	return (v & TLMM_IN_BIT) != 0;
+}
+
+/*
+ * Pacing.  delay() costs about 16 us on this port no matter what is asked for,
+ * and the bit-bang called it three times per bit - that, not the pads, is why
+ * the bus ran at ~20 kHz.  A calibrated spin loop is a few hundred nanoseconds
+ * and makes the pace argument mean something.
+ */
+static uint32_t bb_spin_per_us = 60;    /* calibrated at bring-up */
+
+static void
+bb_calibrate(void)
+{
+	uint64_t t0, t1, ns = 0;
+	const uint32_t n = 20000;
+	int spin = 0;
+	volatile uint32_t sink = 0;
+
+	if (PE_parse_boot_argn("liuqintouchspin", &spin, sizeof(spin)) && spin > 0) {
+		bb_spin_per_us = (uint32_t)spin;
+		printf("LIUQIN TOUCH: bit-bang spin %u iterations/us (boot arg)\n",
+		    bb_spin_per_us);
+		return;
+	}
+	t0 = mach_absolute_time();
+	for (uint32_t i = 0; i < n; i++) {
+		__asm__ volatile ("nop" ::: "memory");
+		sink++;
+	}
+	t1 = mach_absolute_time();
+	absolutetime_to_nanoseconds(t1 - t0, &ns);
+	if (ns > 0 && sink == n) {
+		/* iterations per microsecond: n / (ns/1000) */
+		const uint64_t us = ns / 1000ull;
+		if (us > 0) {
+			bb_spin_per_us = (uint32_t)(n / us);
+		}
+		if (bb_spin_per_us < 4) {
+			bb_spin_per_us = 4;
+		}
+	}
+	printf("LIUQIN TOUCH: bit-bang spin %u iterations/us (%llu ns for %u nops)\n",
+	    bb_spin_per_us, ns, n);
+}
+
+static inline void
+bb_pace(void)
+{
+	if (tch.bb_pace_us != 0) {
+		uint32_t n = bb_spin_per_us * tch.bb_pace_us;
+
+		while (n-- != 0) {
+			__asm__ volatile ("nop" ::: "memory");
+		}
+	}
+}
+
+static void
+tch_bb_xfer(const uint8_t *tx, uint8_t *rx, size_t len)
+{
+	const int idle = tch.bb_cpol;           /* clock level between bits */
+	const int cpha = tch.bb_cpha;
+
+	for (size_t i = 0; i < len; i++) {
+		const uint8_t out = tx != NULL ? tx[i] : 0xff;
+		uint8_t in = 0;
+
+		for (int b = 7; b >= 0; b--) {
+			if (!cpha) {
+				bb_set(tch.pin_mosi, (out >> b) & 1);
+				bb_pace();
+			}
+			bb_set(tch.pin_clk, !idle);     /* leading edge */
+			bb_pace();
+			if (!cpha) {
+				in = (uint8_t)((in << 1) | (bb_get(tch.pin_miso) ? 1 : 0));
+			} else {
+				bb_set(tch.pin_mosi, (out >> b) & 1);
+			}
+			bb_set(tch.pin_clk, idle);      /* trailing edge */
+			bb_pace();
+			if (cpha) {
+				in = (uint8_t)((in << 1) | (bb_get(tch.pin_miso) ? 1 : 0));
+			}
+		}
+		if (rx != NULL) {
+			rx[i] = in;
+		}
+	}
+}
+
+/* SPI_CS_ASSERT (8) / SPI_CS_DEASSERT (9); the transfer itself does not
+ * toggle the line because CS_TOGGLE was cleared at init. */
+static int
+tch_cs(bool assert)
+{
+	if (tch.bitbang) {
+		const int active = tch.cs_high ? 1 : 0;
+
+		bb_set(tch.pin_cs, assert ? active : !active);
+		bb_pace();
+		bb_pace();
+		return 0;
+	}
+	/* CS is a command-table opcode with no data behind it, so it runs in
+	 * whichever mode the data path uses; switching to FIFO mode here used to
+	 * turn the DMA engine off under a transfer. */
+	tch_irq_clear();
+	if (!tch.use_dma) {
+		tch_fifo_mode();
+	}
+	const uint32_t irq = tch_run_cmd(((assert ? SPI_CS_ASSERT : SPI_CS_DEASSERT) << M_OPCODE_SHFT),
+	    NULL, 0, NULL, 0, NULL, 20);
+	if ((irq & M_CMD_DONE_EN) == 0) {
+		if (tch_dma_fail_lines < 24) {
+			tch_dma_fail_lines++;
+			printf("LIUQIN TOUCH: CS %s failed irq 0x%08x status 0x%08x\n",
+			    assert ? "assert" : "deassert", irq,
+			    tch_rd(tch.se, SE_GENI_STATUS));
+		}
+		return -1;
+	}
+	if (assert && tch_cs_dly != 0) {
+		delay(tch_cs_dly);
+	}
+	return 0;
+}
+
+static int tch_xfer(const uint8_t *tx, uint8_t *rx, size_t len);
+static void tch_nvt_bringup(void);
+static void liuqin_keys_start(void);
+static int tch_nvt_write8(uint32_t addr, uint8_t val);
+static void liuqin_touch_int_watch(void *arg, wait_result_t wr);
+static void liuqin_touch_reports_start(void);
+
+/* liuqin_boot_mark() clears liuqin_console_force when it returns, so inside a
+ * section that wants its lines drawn the flag has to be put back. */
+static void
+tch_visible_mark(const char *what)
+{
+	const int was = liuqin_console_force;
+
+	liuqin_boot_mark(what);
+	/* liuqin_boot_mark() clears the flag on its way out, and with
+	 * liuqinmarks=0 it does not set it again: the bring-up's lines after the
+	 * first mark then only reached the log ring.  Put back what the caller
+	 * asked for, which also makes the DMA steps visible on screen. */
+	liuqin_console_force = was;
+}
+
+/* What the bootloader left in the engine, and what it looks like after every
+ * step: the first touch4 boot could only tell us "irq 0x2", which is not
+ * enough to pick a fix. */
+static void
+tch_dump_state(const char *when)
+{
+	printf("LIUQIN TOUCH: %s SE4 status 0x%08x irq 0x%08x irqen 0x%08x ctrl 0x%08x cmd0 0x%08x gp_len 0x%08x\n",
+	    when, tch_rd(tch.se, SE_GENI_STATUS), tch_rd(tch.se, SE_GENI_M_IRQ_STATUS),
+	    tch_rd(tch.se, SE_GENI_M_IRQ_EN), tch_rd(tch.se, SE_GENI_M_CMD_CTRL_REG),
+	    tch_rd(tch.se, SE_GENI_M_CMD0), tch_rd(tch.se, SE_GENI_M_GP_LENGTH));
+	printf("LIUQIN TOUCH: %s SE4 clk 0x%08x sel 0x%08x out 0x%08x cgc 0x%08x gsi 0x%08x seirq 0x%08x ifdis 0x%08x\n",
+	    when, tch_rd(tch.se, GENI_SER_M_CLK_CFG), tch_rd(tch.se, SE_GENI_CLK_SEL),
+	    tch_rd(tch.se, GENI_OUTPUT_CTRL), tch_rd(tch.se, GENI_CGC_CTRL),
+	    tch_rd(tch.se, SE_GSI_EVENT_EN), tch_rd(tch.se, SE_IRQ_EN),
+	    tch_rd(tch.se, GENI_IF_DISABLE_RO));
+	printf("LIUQIN TOUCH: %s SE4 spi trans 0x%08x word 0x%08x cpha 0x%08x cpol 0x%08x demux 0x%08x slave 0x%08x\n",
+	    when, tch_rd(tch.se, SE_SPI_TRANS_CFG), tch_rd(tch.se, SE_SPI_WORD_LEN),
+	    tch_rd(tch.se, SE_SPI_CPHA), tch_rd(tch.se, SE_SPI_CPOL),
+	    tch_rd(tch.se, SE_SPI_DEMUX_SEL), tch_rd(tch.se, SE_SPI_SLAVE_EN));
+}
+
+/* One CS_ASSERT, reported in full: whether the SE latched the command
+ * (GENI_STATUS.M_GENI_CMD_ACTIVE), the first interrupt status it raised and
+ * the last one. */
+static int
+tch_cs_probe(const char *after)
+{
+	if (!tch.use_dma) {
+		tch_fifo_mode();
+	}
+	const uint32_t irq = tch_run_cmd(SPI_CS_ASSERT << M_OPCODE_SHFT,
+	    NULL, 0, NULL, 0, NULL, 20);
+
+	printf("LIUQIN TOUCH: CS assert %s: after-cmd 0x%08x first-irq 0x%08x irq 0x%08x\n",
+	    after, tch.status_after_cmd, tch.first_irq, irq);
+	return (irq & M_CMD_DONE_EN) ? 0 : -1;
+}
+
+/* One duplex byte through the real data path with CS deasserted: proves that
+ * the engine moves data at all without touching the chip. */
+static int
+tch_tx_probe(const char *after)
+{
+	uint8_t byte = 0xff;
+	uint8_t echo = 0x00;
+	const int err = tch_xfer(&byte, &echo, 1);
+
+	printf("LIUQIN TOUCH: TX probe %s: %s irq 0x%08x dma tx 0x%08x rx 0x%08x\n",
+	    after, err == 0 ? "ok" : "failed", tch.last_irq,
+	    tch.dma_tx_status, tch.dma_rx_status);
+	return err;
+}
+
+/* Is the bus usable, and does it need help with chip select?  The data path
+ * has to work; the CS commands are optional, because Qualcomm's own GENI SPI
+ * driver never sends them and lets the engine drive CS per transfer. */
+static int
+tch_probe_bus(const char *how)
+{
+	const bool cs_ok = tch_cs_probe(how) == 0;
+
+	if (cs_ok) {
+		tch.cs_manual = true;
+		(void)tch_cs(false);
+	} else {
+		tch.cs_manual = false;
+	}
+	if (tch_tx_probe(how) != 0) {
+		return -1;
+	}
+	if (!cs_ok) {
+		printf("LIUQIN TOUCH: transfers work, CS commands do not: CS per transfer\n");
+	}
+	return 0;
+}
+
+/* The first touch4 boot answered "no" to every command with M_CMD_OVERRUN,
+ * which means the master sequencer is either still busy with something the
+ * bootloader left behind or disabled.  Walk the ways out of that state,
+ * logging each one, and stop at the first that works.
+ *
+ * The first step is not a register poke: it is the other legal ordering of a
+ * DMA command (descriptor registers first, then M_CMD0, the order every
+ * release up to the 2024 rework used; the default attempt now runs the
+ * upstream one, command first).  It goes first among the pokes because every
+ * failed transfer leaves the sequencer wedged, so it wants the cleanest state
+ * the walk can offer.  reg == 0 means "no register write". */
+static int
+tch_se_start(void)
+{
+	static const struct {
+		uint32_t reg, val;
+		int order;              /* -1: keep, else force the DMA ordering */
+		const char *what;
+	} fixes[] = {
+		{ 0, 0, 0, "desc-first" },
+		{ SE_GENI_M_CMD_CTRL_REG, M_GENI_CMD_CANCEL, -1, "cancel" },
+		{ SE_GENI_M_CMD_CTRL_REG, M_GENI_CMD_ABORT, -1, "abort" },
+		{ SE_GENI_M_CMD_CTRL_REG, 0, -1, "clear-disable" },
+		{ SE_GENI_CFG_SEQ_START, START_TRIGGER, -1, "start-trigger" },
+	};
+
+	if (tch_probe_bus("as configured") == 0) {
+		return 0;
+	}
+	for (unsigned i = 0; i < sizeof(fixes) / sizeof(fixes[0]); i++) {
+		if (fixes[i].reg != 0) {
+			tch_wr(tch.se, fixes[i].reg, fixes[i].val);
+		}
+		if (fixes[i].order >= 0) {
+			tch_dma_order = fixes[i].order;
+		}
+		delay(2000);
+		printf("LIUQIN TOUCH: %s: status 0x%08x irq 0x%08x ctrl 0x%08x\n",
+		    fixes[i].what, tch_rd(tch.se, SE_GENI_STATUS),
+		    tch_rd(tch.se, SE_GENI_M_IRQ_STATUS),
+		    tch_rd(tch.se, SE_GENI_M_CMD_CTRL_REG));
+		if (tch_probe_bus(fixes[i].what) == 0) {
+			printf("LIUQIN TOUCH: SE4 accepts commands after %s\n", fixes[i].what);
+			return 0;
+		}
+	}
+	tch_dump_state("dead");
+	printf("LIUQIN TOUCH: SE4 rejects every command, bus not started\n");
+	return -1;
+}
+
+/* The QUP's DMA master reaches memory through the wrapper's AHB port.  Its
+ * register interface can look perfectly alive - every SE read answers - while
+ * that port is gated, and then the engine's first transaction never completes
+ * and the interconnect hangs with no panic.  The wrapper's clocks are bits
+ * 6..9 of GCC_QUPV3_WRAP0_CBCR (clk-qcom: one branch per clock, all
+ * BRANCH_HALT_VOTED), and the bit-banged path never needed any of them.
+ * Read, enable what is missing, read back.  liuqintouchqupclk=0 skips it. */
+static void
+tch_qup_dma_clocks(void)
+{
+	const uint32_t off = GCC_QUPV3_WRAP0_CBCR - 0x62000u;
+	const uint32_t want = QUP_CBCR_M_AHB | QUP_CBCR_S_AHB |
+	    QUP_CBCR_CORE | QUP_CBCR_CORE_2X;
+	int on = 1;
+	vm_offset_t gcc;
+	uint32_t v;
+
+	(void)PE_parse_boot_argn("liuqintouchqupclk", &on, sizeof(on));
+	if (on <= 0) {
+		printf("LIUQIN TOUCH: QUP DMA clocks left as they are\n");
+		return;
+	}
+	gcc = ml_io_map(GCC_PA + 0x62000u, 0x4000u);
+	if (gcc == 0) {
+		printf("LIUQIN TOUCH: GCC 0x%x map failed\n", GCC_PA + 0x62000u);
+		return;
+	}
+	v = tch_rd(gcc, off);
+	printf("LIUQIN TOUCH: QUP CBCR 0x%08x [m_ahb %d s_ahb %d core %d core2x %d "
+	    "s4 %d]\n", v, (v & QUP_CBCR_M_AHB) != 0, (v & QUP_CBCR_S_AHB) != 0,
+	    (v & QUP_CBCR_CORE) != 0, (v & QUP_CBCR_CORE_2X) != 0,
+	    (v & QUP_CBCR_S4) != 0);
+	if ((v & want) != want) {
+		tch_wr(gcc, off, v | want);
+		printf("LIUQIN TOUCH: QUP CBCR forced 0x%08x -> 0x%08x (AHB master for DMA)\n",
+		    v, tch_rd(gcc, off));
+	}
+}
+
+/*
+ * The engine-side question touch150 left open.  A QUPv3 serial engine that its
+ * bootloader strapped for DMA (GENI_IF_DISABLE_RO@0x64 = 1) has no FIFO
+ * interface; what it does with a data command is decided by
+ * SE_GENI_DMA_MODE_EN@0x258 and the event registers next to it.
+ *
+ * touch151 tried to force the "DMA interface enable" (SE_DMA_IF_EN@0x2004,
+ * geni_load_se_fw()) and touch151's first boot died on it: this wrapper reports
+ * QUP hw 3.0, which has no 0x2000 block at all, so that read is a synchronous
+ * external abort (esr 0x96000010, far = SE+0x2004), not a register.  The only
+ * mirror left is the one the same header documents as read-only,
+ * DMA_IF_EN_RO@0xe20, plus the two registers that actually select the data
+ * path: SE_GSI_EVENT_EN@0xe18 (GSI owns the engine) and SE_IRQ_EN@0xe1c.
+ *
+ * So: read them, prove whether SE_GSI_EVENT_EN can be cleared at all, and leave
+ * it cleared.  A write that does not stick means the SE is owned by the GSI
+ * block and no amount of SE-DMA programming can move a byte.
+ * liuqintouchdmaif=0 only reports.
+ */
+static void
+tch_se_dma_if(void)
+{
+	int on = 1;
+	uint32_t ro, gsi0, gsi1, seirq;
+
+	(void)PE_parse_boot_argn("liuqintouchdmaif", &on, sizeof(on));
+	ro = tch_rd(tch.se, DMA_IF_EN_RO);
+	gsi0 = tch_rd(tch.se, SE_GSI_EVENT_EN);
+	seirq = tch_rd(tch.se, SE_IRQ_EN);
+	if (on <= 0) {
+		printf("LIUQIN TOUCH: SE4 dma_if_en_ro 0x%08x gsi 0x%08x seirq 0x%08x "
+		    "(left alone)\n", ro, gsi0, seirq);
+		return;
+	}
+	tch_wr(tch.se, SE_GSI_EVENT_EN, 0);
+	gsi1 = tch_rd(tch.se, SE_GSI_EVENT_EN);
+	printf("LIUQIN TOUCH: SE4 dma_if_en_ro 0x%08x gsi 0x%08x -> 0x%08x (write %s) "
+	    "seirq 0x%08x ifdis 0x%08x\n", ro, gsi0, gsi1,
+	    gsi1 == 0 ? "took" : "IGNORED", seirq,
+	    tch_rd(tch.se, GENI_IF_DISABLE_RO));
+	if (gsi1 != 0) {
+		printf("LIUQIN TOUCH: SE4 GSI event enables do not clear: the engine "
+		    "belongs to the GSI block, SE DMA cannot be selected\n");
+	}
+}
+
+/* One page of staging memory for the SE DMA, physically contiguous because the
+ * engine is handed a physical address and is not cache coherent.
+ *
+ * The page is fixed, not allocated: the QUP's DMA only addresses 32-bit
+ * physical memory and the allocator hands out pages above 32 GiB on this
+ * port.  0x85200000 sits in the free window between cdsp_secure_heap and
+ * video_region; 0x85E00000 (34 MiB, below the 0x88000000 line) is the
+ * documented fallback, selectable at boot with liuqintouchdmaphys=0x85e00000
+ * so a freeze does not need a rebuild to test the other window. */
+static int
+tch_dma_alloc(void)
+{
+	if (tch.dma != 0) {
+		return 0;
+	}
+	/*
+	 * The QUP's DMA only addresses 32-bit physical memory, and the page the
+	 * allocator hands out lands at 0x8a0150000 (34.5 GiB) - the first
+	 * transfer then never completes and the machine wedges.  Use a fixed page
+	 * inside the free window the device tree leaves between
+	 * cdsp_secure_heap (ends 0x85200000) and video_region (0x85700000): that
+	 * range belongs to no reserved region and to no ADT bank, so neither the
+	 * firmware nor our own allocator can hand it to anyone else.
+	 */
+	{
+		int fixed = 0;
+
+		if (!PE_parse_boot_argn("liuqintouchdmaphys", &fixed, sizeof(fixed)) || fixed == 0) {
+			fixed = 0x85200000;
+		}
+		tch.dma_pa = (uint64_t)(uint32_t)fixed;
+		printf("LIUQIN TOUCH: DMA: mapping phys 0x%x, 2 pages\n", fixed);
+		tch.dma = (vm_offset_t)ml_io_map((vm_offset_t)tch.dma_pa, 2 * PAGE_SIZE);
+		printf("LIUQIN TOUCH: DMA: ml_io_map returned 0x%llx\n", (uint64_t)tch.dma);
+		if (tch.dma == 0) {
+			printf("LIUQIN TOUCH: cannot map the DMA page at 0x%llx\n", tch.dma_pa);
+			return -1;
+		}
+		/* Device memory: only aligned accesses are allowed (memset() faults
+		 * with an unaligned data abort on it). */
+		{
+			volatile uint64_t *zero = (volatile uint64_t *)tch.dma;
+
+			for (unsigned i = 0; i < 2 * PAGE_SIZE / sizeof(uint64_t); i++) {
+				zero[i] = 0;
+			}
+		}
+		printf("LIUQIN TOUCH: DMA page fixed at phys 0x%llx (%s)\n",
+		    tch.dma_pa, fixed == 0x85200000 ? "default window" : "requested");
+		/* Prove the page is backed before the engine reads it: a PA that is
+		 * not real memory makes the QUP's first transaction hang the bus
+		 * with no panic, and no SMMU or descriptor change would help. */
+		{
+			volatile uint32_t *probe = (volatile uint32_t *)tch.dma;
+			const uint32_t a = 0xa5a5a5a5u, b = 0x5a5a5a5au;
+			uint32_t r0, r1;
+
+			probe[0] = a;
+			probe[TCH_DMA_RX_OFF / 4] = b;
+			__asm__ volatile ("dsb sy" ::: "memory");
+			r0 = probe[0];
+			r1 = probe[TCH_DMA_RX_OFF / 4];
+			printf("LIUQIN TOUCH: DMA page self-test %s (0x%08x 0x%08x)\n",
+			    (r0 == a && r1 == b) ? "ok" : "MISMATCH", r0, r1);
+		}
+	}
+	if (tch.dma_pa == 0) {
+		printf("LIUQIN TOUCH: DMA page maps to physical 0\n");
+		return -1;
+	}
+	/* The engine's DMA FSMs may still hold the state the bootloader left
+	 * when it drove this SE over GPI DMA. */
+	tch_wr(tch.se, SE_DMA_TX_FSM_RST, 1);
+	tch_wr(tch.se, SE_DMA_RX_FSM_RST, 1);
+	tch.use_dma = true;
+	printf("LIUQIN TOUCH: DMA staging page at 0x%llx (phys 0x%llx, %u KiB)\n",
+	    (uint64_t)tch.dma, tch.dma_pa, (unsigned)(2 * PAGE_SIZE / 1024));
+	return 0;
+}
+
+/*
+ * apps_smmu (vendor DTB: soc/apps-smmu@15000000, "qcom,qsmmu-v500", 1 MiB).
+ * QUPv3_0's GENI SE - the wrapper that owns SE4 - carries
+ * iommus = <&apps_smmu 0x5a3 0>, so every SE DMA transaction carries stream
+ * id 0x5A3.
+ *
+ * Register map (measured on touch145/146, plus the device tree):
+ *
+ *   SCR0  0x0000   IDR0  0x0020
+ *   SMR   0x0800 + 4*n   VALID(31) | MASK[30:16] | ID[15:0]
+ *   S2CR  0x0c00 + 4*n   TYPE[17:16] (0 translate, 1 bypass, 2 fault),
+ *                        CBNDX[7:0]  - not type[1:0]/cb[15:8]
+ *
+ * The array holds IDR0[7:0] = 0x71 = 113 entries.  Reading entry 113 - one
+ * past the end - is what killed touch146 (FAR = window + 0x9c4, ESR
+ * 0x96000010, PC at the SMR load), so stay strictly below the count.
+ * All of it is global space 0; 0x8000+ is global space 1 and traps (touch145
+ * died on 0x1500968c, and GpuPowerBoard.h records the same for gr1), so the
+ * old "S2CR indexed by stream id at 0x8000" idea is gone for good.
+ *
+ * What touch146-gr0 read back: SMR[0] valid id 0, SMR[3] 0x84022800 = the
+ * display stream (DT: qcom,smmu_sde_unsec_cb is <&apps_smmu 0x2800 0x402>,
+ * exactly qcom,handoff-smrs = <0x2800 0x402>), and S2CR[i] = CBNDX i with
+ * type translate.  Nothing matched the QUP's 0x5A3, so the SE's DMA would be
+ * an unmatched transaction.  This function therefore (1) bypasses an
+ * existing match, (2) else programs an entry whose SMR is invalid (it
+ * matches nothing, so its S2CR is unused), (3) else reuses a redundant
+ * "valid, id 0, mask 0" entry - such an entry only ever matches stream 0,
+ * and the lowest one keeps that match.
+ *
+ * One 16 KiB window covers all of it.  tch_smmu_fix() must run *before*
+ * tch_dma_alloc(): the touch132 freeze differed from the readable touch135
+ * probe by touching the 0x85200000 staging page first.
+ *
+ * liuqintouchsmmu: 0 off, 1 report only, 2 report and (bypass | program).
+ */
+#define APPS_SMMU_PA    0x15000000u
+#define SMMU_SCR0       0x0000u
+#define SMMU_IDR1       0x0024u
+#define SMMU_IDR0       0x0020u
+#define SMMU_SMR(n)     (0x0800u + (n) * 4u)
+#define SMMU_S2CR(n)    (0x0c00u + (n) * 4u)
+#define SMMU_ENTRY_MAX  256u           /* sanity cap; real count is IDR0[7:0] */
+#define SMMU_WIN_SIZE   0x4000u        /* one 16 KiB page of device registers */
+#define SMMU_STREAM     0x5a3u
+#define SMR_VALID       0x80000000u
+#define SMR_ID(smr)     ((smr) & 0xffffu)
+#define SMR_MASK(smr)   (((smr) >> 16) & 0x7fffu)
+#define S2CR_TYPE_MSK   (3u << 16)
+#define S2CR_TYPE_BYPASS 1u
+#define S2CR_TYPE(s2cr) (((s2cr) >> 16) & 3u)
+#define S2CR_CB(s2cr)   ((s2cr) & 0xffu)
+#define CBAR_TYPE_MSK   (3u << 16)
+#define CBAR_TYPE_S1_S2_BYPASS 1u
+
+/* arm_smmu SMR semantics: VALID, then id equal to the stream id on every bit
+ * the mask does not ignore. */
+static bool
+tch_smr_matches(uint32_t smr, uint32_t sid)
+{
+	const uint32_t mask = SMR_MASK(smr);
+
+	if ((smr & SMR_VALID) == 0) {
+		return false;
+	}
+	return (((sid ^ smr) & 0xffffu) & ~mask) == 0;
+}
+
+
+/*
+ * qsmmu writes S2CR TYPE=BYPASS as TYPE=FAULT (measured: 0x00010000 came back
+ * 0x00020000), which is why the "just bypass the stream" plan can never work
+ * here.  Linux' arm-smmu-qcom handles the same quirk by reserving a context
+ * bank, setting CBAR to S1_TRANS_S2_BYPASS with SCTLR=0, and pointing the
+ * stream at that bank with TYPE=TRANS.  Do the same and return the bank, or
+ * 0xff when the geometry or the accesses do not work out.
+ *
+ * Geometry from IDR1 (arm-smmu.h): PAGESIZE bit31, NUMPAGENDXB [30:28],
+ * NUMCB [7:0]; GR1 page = 1 << pgshift, CBAR(n) = GR1 + 4*n,
+ * CB(n) = (numpage + n) << pgshift.
+ */
+static unsigned
+tch_smmu_bypass_cb(vm_offset_t gr0)
+{
+	int enable = 1;
+	uint32_t idr1, pgshift, numpage, ncb, cbndx, gr1_off, cb_off;
+	vm_offset_t gr1, cb;
+
+	(void)PE_parse_boot_argn("liuqintouchbypass", &enable, sizeof(enable));
+	if (enable <= 0) {
+		printf("LIUQIN TOUCH: SMMU bypass CB disabled by boot arg\n");
+		return 0xffu;
+	}
+	idr1 = tch_rd(gr0, SMMU_IDR1);
+	pgshift = (idr1 & (1u << 31)) ? 16u : 12u;
+	numpage = 1u << (((idr1 >> 28) & 7u) + 1u);
+	ncb = idr1 & 0xffu;
+	cbndx = (ncb > 1u) ? ncb - 1u : 77u;
+	gr1_off = (1u << pgshift);
+	cb_off = (numpage + cbndx) << pgshift;
+	printf("LIUQIN TOUCH: SMMU quirk: idr1 0x%08x (pgshift %u, numpage %u, numcb %u)"
+	    " -> bypass CB %u, CBAR at +0x%x, CB at +0x%x\n",
+	    idr1, pgshift, numpage, ncb, cbndx, gr1_off + 4u * cbndx, cb_off);
+	if (cb_off >= 0x100000u || gr1_off >= 0x100000u) {
+		/* The device tree says the block is 1 MiB; a CB outside it means the
+		 * IDR1 geometry is not what we think, so do not poke it. */
+		printf("LIUQIN TOUCH: SMMU CB/CBAR outside the 1 MiB block; not touching it\n");
+		return 0xffu;
+	}
+
+	gr1 = ml_io_map(APPS_SMMU_PA + gr1_off, PAGE_SIZE);
+	cb = ml_io_map(APPS_SMMU_PA + cb_off, PAGE_SIZE);
+	if (gr1 == 0 || cb == 0) {
+		printf("LIUQIN TOUCH: SMMU cannot map CBAR/CB (0x%llx/0x%llx)\n",
+		    (uint64_t)gr1, (uint64_t)cb);
+		return 0xffu;
+	}
+	printf("LIUQIN TOUCH: SMMU CBAR 0x%08x SCTLR 0x%08x (before)\n",
+	    tch_rd(gr1, 4u * cbndx), tch_rd(cb, 0));
+	tch_wr(gr1, 4u * cbndx, CBAR_TYPE_S1_S2_BYPASS << 16);
+	tch_wr(cb, 0, 0);
+	printf("LIUQIN TOUCH: SMMU CBAR 0x%08x SCTLR 0x%08x (after)\n",
+	    tch_rd(gr1, 4u * cbndx), tch_rd(cb, 0));
+	/* Kept so a failed transfer can say whether the stream faulted and at
+	 * which address: FSR@0x58, FAR@0x60, FSYNR0@0x68 (arm-smmu.h).  A fault
+	 * left over from an earlier probe would make that dump a lie, and FSR is
+	 * write-one-to-clear, so read it out and drop it now. */
+	{
+		const uint32_t fsr = tch_rd(cb, 0x58);
+
+		if (fsr != 0) {
+			const uint32_t far = tch_rd(cb, 0x60);
+
+			tch_wr(cb, 0x58, fsr);
+			printf("LIUQIN TOUCH: SMMU cb had a stale fault fsr 0x%08x far 0x%08x, "
+			    "cleared\n", fsr, far);
+		}
+	}
+	tch.smmu_cb = cb;
+	return cbndx;
+}
+
+static void
+tch_smmu_fix(void)
+{
+	int mode = 1;
+	vm_offset_t gr0;
+	uint32_t scr0, idr0;
+	uint32_t hit_smr = 0, hit_s2cr = 0;
+	unsigned nsmr, valid = 0, free_slots = 0, shown = 0, sid0 = 0;
+	unsigned free_at = SMMU_ENTRY_MAX, spare_at = SMMU_ENTRY_MAX;
+	unsigned sid0_first = SMMU_ENTRY_MAX;
+	int hit = -1;
+
+	(void)PE_parse_boot_argn("liuqintouchsmmu", &mode, sizeof(mode));
+	if (mode <= 0) {
+		return;
+	}
+	gr0 = ml_io_map(APPS_SMMU_PA, SMMU_WIN_SIZE);
+	if (gr0 == 0) {
+		printf("LIUQIN TOUCH: SMMU: cannot map 0x%x, DMA path continues without it\n",
+		    APPS_SMMU_PA);
+		return;
+	}
+	tch.smmu = gr0;
+	tch.smmu_smr = -1;
+	scr0 = tch_rd(gr0, SMMU_SCR0);
+	idr0 = tch_rd(gr0, SMMU_IDR0);
+	nsmr = idr0 & 0xffu;
+	printf("LIUQIN TOUCH: SMMU gr0 scr0 0x%08x idr0 0x%08x, %u entries "
+	    "(SMR@0x800 S2CR@0xc00)\n", scr0, idr0, nsmr);
+	if (nsmr == 0 || nsmr > SMMU_ENTRY_MAX) {
+		printf("LIUQIN TOUCH: SMMU implausible entry count, leaving it alone\n");
+		return;
+	}
+
+	for (unsigned i = 0; i < nsmr; i++) {
+		const uint32_t smr = tch_rd(gr0, SMMU_SMR(i));
+		const uint32_t s2cr = tch_rd(gr0, SMMU_S2CR(i));
+		const bool v = (smr & SMR_VALID) != 0;
+
+		if (v) {
+			valid++;
+		}
+		if (!v) {
+			/* No valid SMR: the entry matches nothing, so its S2CR is
+			 * unused and the slot is ours to take.  (Its S2CR being
+			 * non-zero is not a reason to skip it - that mistake is what
+			 * made touch147 leave the table alone.) */
+			free_slots++;
+			if (free_at == SMMU_ENTRY_MAX) {
+				free_at = i;
+			}
+		}
+		if (v && SMR_ID(smr) == 0 && SMR_MASK(smr) == 0) {
+			sid0++;
+			/* Matches stream 0 only; the first one keeps that match. */
+			if (sid0_first == SMMU_ENTRY_MAX) {
+				sid0_first = i;
+			} else {
+				spare_at = i;
+			}
+		}
+		if (v && SMR_ID(smr) != 0 && shown < 12) {
+			printf("LIUQIN TOUCH: SMMU [%3u] SMR 0x%08x id 0x%x mask 0x%x, "
+			    "S2CR 0x%08x type %u cb %u\n", i, smr, SMR_ID(smr),
+			    SMR_MASK(smr), s2cr, S2CR_TYPE(s2cr), S2CR_CB(s2cr));
+			shown++;
+		}
+		if (hit < 0 && tch_smr_matches(smr, SMMU_STREAM)) {
+			hit = (int)i;
+			hit_smr = smr;
+			hit_s2cr = s2cr;
+		}
+	}
+	printf("LIUQIN TOUCH: SMMU %u entries: %u valid (%u match only stream 0), "
+	    "%u free\n", nsmr, valid, sid0, free_slots);
+
+	if (hit >= 0) {
+		tch.smmu_smr = hit;
+		printf("LIUQIN TOUCH: SMMU stream 0x%x matches SMR[%d] id 0x%x mask 0x%x, "
+		    "S2CR 0x%08x type %u cb %u\n", SMMU_STREAM, hit, SMR_ID(hit_smr),
+		    SMR_MASK(hit_smr), hit_s2cr, S2CR_TYPE(hit_s2cr), S2CR_CB(hit_s2cr));
+		if (mode < 2) {
+			return;
+		}
+		if (S2CR_TYPE(hit_s2cr) == S2CR_TYPE_BYPASS) {
+			printf("LIUQIN TOUCH: SMMU stream already bypasses, nothing to write\n");
+			return;
+		}
+		printf("LIUQIN TOUCH: SMMU writing bypass to S2CR[%d] (0x%08x -> 0x%08x)\n",
+		    hit, hit_s2cr,
+		    (hit_s2cr & ~S2CR_TYPE_MSK) | (S2CR_TYPE_BYPASS << 16));
+		tch_wr(gr0, SMMU_S2CR((unsigned)hit),
+		    (hit_s2cr & ~S2CR_TYPE_MSK) | (S2CR_TYPE_BYPASS << 16));
+		printf("LIUQIN TOUCH: SMMU S2CR[%d] now 0x%08x\n", hit,
+		    tch_rd(gr0, SMMU_S2CR((unsigned)hit)));
+		return;
+	}
+
+	printf("LIUQIN TOUCH: SMMU no valid SMR matches stream 0x%x\n", SMMU_STREAM);
+	if (mode < 2) {
+		return;
+	}
+	/*
+	 * Nothing matches the SE's stream.  Program one entry for it: prefer a
+	 * completely untouched one; otherwise reuse a redundant stream-0 match
+	 * (stream 0 keeps its lowest entry, so that route does not change).
+	 * S2CR first, so the new match only appears once bypass is in place.
+	 */
+	{
+		unsigned slot, cbndx;
+
+		if (free_at < nsmr) {
+			slot = free_at;
+			printf("LIUQIN TOUCH: SMMU programming free entry %u (SMR %s)\n",
+			    slot, "invalid");
+		} else if (spare_at < nsmr) {
+			slot = spare_at;
+			printf("LIUQIN TOUCH: SMMU no untouched entry; reusing redundant "
+			    "stream-0 match at %u (stream 0 keeps entry %u)\n",
+			    slot, sid0_first);
+		} else {
+			printf("LIUQIN TOUCH: SMMU no free or spare entry; leaving the "
+			    "table alone\n");
+			return;
+		}
+		cbndx = tch_smmu_bypass_cb(gr0);
+		if (cbndx >= 0xffu) {
+			printf("LIUQIN TOUCH: SMMU no bypass context bank; not "
+			    "programming the stream\n");
+			return;
+		}
+		printf("LIUQIN TOUCH: SMMU writing S2CR[%u] = 0x%08x (translate via "
+		    "bypass CB %u), SMR[%u] = 0x%08x\n", slot, cbndx, cbndx, slot,
+		    SMR_VALID | SMMU_STREAM);
+		tch_wr(gr0, SMMU_S2CR(slot), cbndx);
+		tch_wr(gr0, SMMU_SMR(slot), SMR_VALID | SMMU_STREAM);
+		tch.smmu_smr = (int)slot;
+		printf("LIUQIN TOUCH: SMMU readback SMR 0x%08x S2CR 0x%08x\n",
+		    tch_rd(gr0, SMMU_SMR(slot)), tch_rd(gr0, SMMU_S2CR(slot)));
+	}
+}
+
+/* geni_se_select_mode(GENI_SE_DMA): the SE moves the data itself.
+ *
+ * The mode switch is more than the one bit: geni_se_irq_clear() writes 0 to
+ * SE_GSI_EVENT_EN in every mode change, geni_se_select_dma_mode() drops the
+ * FIFO watermark enables, and only then does GENI_DMA_MODE_EN come on.  Every
+ * attempt up to touch150 set the bit and left the bootloader's
+ * SE_GSI_EVENT_EN = 0xf in place, i.e. the sequencer stayed in GSI mode and
+ * handed the command to the GSI block, which has no TRE ring here.
+ *
+ * touch166: SE_IRQ_EN is no longer zero.  spi_geni_init() reaches
+ * geni_se_select_mode(GENI_SE_DMA), and geni_se_select_dma_mode() starts with
+ * geni_se_irq_clear(), which writes 0xffffffff to SE_IRQ_EN and never touches
+ * it again - a Linux SE-DMA transfer therefore runs with every SE interrupt
+ * enable set, DMA_RX_IRQ_EN (bit 0) included.  This port polls and the QUP
+ * line is not enabled at the GIC, so nothing reaches the CPU either way, but
+ * those bits are the engine's own DMA event enables: a receive that moves
+ * bytes while SE_DMA_RX_IRQ_STAT stays 0 is what a cleared DMA_RX_IRQ_EN looks
+ * like from the outside. */
+static void
+tch_dma_mode(void)
+{
+	uint32_t v;
+
+	tch_irq_clear();
+	tch_wr(tch.se, SE_IRQ_EN, 0xffffffffu);
+	v = tch_rd(tch.se, SE_GENI_M_IRQ_EN);
+	tch_wr(tch.se, SE_GENI_M_IRQ_EN, v & ~(M_CMD_DONE_EN |
+	    M_TX_FIFO_WATERMARK_EN | M_RX_FIFO_WATERMARK_EN | M_RX_FIFO_LAST_EN));
+	tch_wr(tch.se, SE_GENI_DMA_MODE_EN,
+	    tch_rd(tch.se, SE_GENI_DMA_MODE_EN) | GENI_DMA_MODE_EN);
+}
+
+static void
+tch_dma_abort(void)
+{
+	tch_wr(tch.se, SE_GENI_M_CMD_CTRL_REG, M_GENI_CMD_ABORT);
+	for (unsigned i = 0; i < 200; i++) {
+		if (tch_status() & M_CMD_ABORT_EN) {
+			break;
+		}
+		delay(50);
+	}
+	tch_wr(tch.se, SE_GENI_M_IRQ_CLEAR, 0xffffffff);
+}
+
+/*
+ * The staging page is mapped Device (VM_WIMG_IO): the CPU does not cache it, so
+ * no cache maintenance is needed and byte accesses are the only ones that are
+ * always aligned.  memset()/memcpy() on it faulted once already (clang emits
+ * wide stores), and flush_dcache64() takes a *physical* address and goes through
+ * phystokv_range(), which panics for a page outside the ADT's DRAM bank - that
+ * panic is what touch126 hit right after "DMA page fixed".
+ */
+static void
+tch_dma_put(uint32_t off, const uint8_t *src, size_t len)
+{
+	volatile uint8_t *p = (volatile uint8_t *)(tch.dma + off);
+
+	for (size_t i = 0; i < len; i++) {
+		p[i] = src[i];
+	}
+}
+
+static void
+tch_dma_get(uint32_t off, uint8_t *dst, size_t len)
+{
+	volatile uint8_t *p = (volatile uint8_t *)(tch.dma + off);
+
+	for (size_t i = 0; i < len; i++) {
+		dst[i] = p[i];
+	}
+}
+
+static void
+tch_dma_clear(uint32_t off, size_t len)
+{
+	volatile uint8_t *p = (volatile uint8_t *)(tch.dma + off);
+
+	for (size_t i = 0; i < len; i++) {
+		p[i] = 0;
+	}
+}
+
+/*
+ * geni_se_tx_init_dma() / geni_se_rx_init_dma(): the descriptor lives in
+ * registers, so the engine needs the pointer, the attribute and the length
+ * before it can fetch anything.  RX is not an EOT buffer, TX is.
+ */
+static void
+tch_dma_arm(bool tx, bool rx, uint64_t tx_pa, uint64_t rx_pa, size_t len)
+{
+	if (rx) {
+		tch_wr(tch.se, SE_DMA_RX_IRQ_CLR, 0xffffffff);
+		tch_wr(tch.se, SE_DMA_RX_IRQ_EN_SET, DMA_IRQ_EN);
+		tch_wr(tch.se, SE_DMA_RX_PTR_L, (uint32_t)rx_pa);
+		tch_wr(tch.se, SE_DMA_RX_PTR_H, (uint32_t)(rx_pa >> 32));
+		tch_wr(tch.se, SE_DMA_RX_ATTR, 0);
+		tch_wr(tch.se, SE_DMA_RX_LEN, (uint32_t)len);
+	}
+	if (tx) {
+		tch_wr(tch.se, SE_DMA_TX_IRQ_CLR, 0xffffffff);
+		tch_wr(tch.se, SE_DMA_TX_IRQ_EN_SET, DMA_IRQ_EN);
+		tch_wr(tch.se, SE_DMA_TX_PTR_L, (uint32_t)tx_pa);
+		tch_wr(tch.se, SE_DMA_TX_PTR_H, (uint32_t)(tx_pa >> 32));
+		tch_wr(tch.se, SE_DMA_TX_ATTR, GENI_SE_DMA_EOT_BUF);
+		tch_wr(tch.se, SE_DMA_TX_LEN, (uint32_t)len);
+	}
+}
+
+/*
+ * One SPI transfer through the serial engine's own DMA engine: what an SE with
+ * FIFO_IF_DISABLE set needs (geni_se_tx/rx_init_dma and the command).  Both
+ * orderings are in Linux: every release up to the 2024 rework arms the
+ * descriptor registers and then writes SE_GENI_M_CMD0, while upstream writes
+ * the command first and arms the descriptor behind it.  The default is the
+ * upstream one; liuqintouchdmaorder=0 and the "desc-first" step of the probe
+ * walk select the other without a rebuild.
+ */
+/*
+ * touch164 settled it: with the RX DMA disarmed the RX FIFO fills (wc 2 for an
+ * 8-byte read) and the CPU can read its words, while the RX DMA writes
+ * "10 00 00 00 02 01 aa aa" no matter what.  So TX keeps going through the
+ * engine's DMA - which the wire capture proved byte exact - and the received
+ * bytes are pulled straight out of the FIFO while the command runs, the same
+ * way the FIFO-mode path does it.
+ */
+static int
+tch_dma_fifo_xfer(const uint8_t *tx, uint8_t *rx, size_t len)
+{
+	const uint32_t cmd = (tx != NULL && rx != NULL) ? tch_duplex_opcode() :
+	    (tx != NULL ? SPI_TX_ONLY : SPI_RX_ONLY);
+	size_t got = 0;
+	uint32_t irq = 0;
+	unsigned i;
+
+	if (tch.dma == 0 || len == 0 || len > TCH_DMA_MAX) {
+		return -1;
+	}
+	if (tch_rx_via_fifo && rx != NULL) {
+		return tch_dma_fifo_xfer(tx, rx, len);
+	}
+	if (tx != NULL) {
+		tch_dma_put(TCH_DMA_TX_OFF, tx, len);
+	}
+	tch_wr(tch.se, SE_SPI_TX_TRANS_LEN, tx != NULL ? (uint32_t)len : 0);
+	tch_wr(tch.se, SE_SPI_RX_TRANS_LEN, rx != NULL ? (uint32_t)len : 0);
+	tch_dma_mode();
+	tch_wr(tch.se, SE_GENI_M_CMD0, (cmd << M_OPCODE_SHFT) | FRAGMENTATION);
+	/* RX deliberately not armed: the FIFO must keep the bytes. */
+	tch_dma_arm(tx != NULL, false, tch.dma_pa + TCH_DMA_TX_OFF, 0, len);
+
+	for (i = 0; i < 50 * 100; i++) {
+		if (rx != NULL) {
+			tch_drain_rx(rx, len, &got);
+		}
+		irq = tch_status();
+		if (irq & (M_CMD_DONE_EN | TCH_IRQ_ERRS)) {
+			break;
+		}
+		delay(10);
+	}
+	if (rx != NULL) {
+		tch_drain_rx(rx, len, &got);
+	}
+	tch_wr(tch.se, SE_GENI_M_IRQ_CLEAR, irq ? irq : 0xffffffff);
+	tch.last_irq = irq;
+	if ((irq & M_CMD_DONE_EN) == 0 || (irq & TCH_IRQ_ERRS) != 0) {
+		return -1;
+	}
+	if (rx != NULL && got < len) {
+		return -1;
+	}
+	return 0;
+}
+
+static int
+tch_dma_xfer(const uint8_t *tx, uint8_t *rx, size_t len)
+{
+	const uint64_t tx_pa = tch.dma_pa + TCH_DMA_TX_OFF;
+	const uint64_t rx_pa = tch.dma_pa + TCH_DMA_RX_OFF;
+	const uint32_t cmd = (tx != NULL && rx != NULL) ? tch_duplex_opcode() :
+	    (tx != NULL ? SPI_TX_ONLY : SPI_RX_ONLY);
+	uint32_t txst = 0, rxst = 0, irq = 0;
+	uint32_t txin = 0, rxin = 0, dbg_mid = 0, txin_mid = 0, rxin_mid = 0;
+	bool ok;
+	unsigned i, budget;
+	uint32_t prog[3] = { 0, 0, 0 };
+
+	if (tch.dma == 0 || len == 0 || len > TCH_DMA_MAX) {
+		return -1;
+	}
+	if (tx != NULL) {
+		tch_dma_put(TCH_DMA_TX_OFF, tx, len);
+	}
+	if (rx != NULL) {
+		tch_dma_clear(TCH_DMA_RX_OFF, len);
+	}
+	tch_wr(tch.se, SE_SPI_TX_TRANS_LEN, tx != NULL ? (uint32_t)len : 0);
+	tch_wr(tch.se, SE_SPI_RX_TRANS_LEN, rx != NULL ? (uint32_t)len : 0);
+
+	/* geni_se_select_mode(GENI_SE_DMA): the mode is not part of the command
+	 * and has to be in place before either ordering starts.  tch_dma_mode()
+	 * is also what takes the engine out of the bootloader's GSI event mode
+	 * and proves, in the line below, whether that write stuck. */
+	tch_dma_mode();
+	if (tch_dma_order == 0) {
+		tch_dma_arm(tx != NULL, rx != NULL, tx_pa, rx_pa, len);
+	}
+	tch_dma_count++;
+	if (tch_dma_count <= 8) {
+		printf("LIUQIN TOUCH: DMA #%u %s len %u tx 0x%llx rx 0x%llx dma_mode "
+		    "0x%08x gsi 0x%08x seirq 0x%08x\n",
+		    tch_dma_count, cmd == SPI_TX_RX ? "tx+rx" : (tx != NULL ? "tx" : "rx"),
+		    (unsigned)len, tx != NULL ? tx_pa : 0, rx != NULL ? rx_pa : 0,
+		    tch_rd(tch.se, SE_GENI_DMA_MODE_EN), tch_rd(tch.se, SE_GSI_EVENT_EN),
+		    tch_rd(tch.se, SE_IRQ_EN));
+		if (tch_dma_count <= 3 && tx != NULL) {
+			uint8_t t[8] = { 0 };
+
+			tch_dma_get(TCH_DMA_TX_OFF, t, sizeof(t));
+			printf("LIUQIN TOUCH: DMA #%u TX page %02x %02x %02x %02x "
+			    "%02x %02x %02x %02x\n", tch_dma_count, t[0], t[1], t[2],
+			    t[3], t[4], t[5], t[6], t[7]);
+		}
+	}
+
+	if (tch_dma_count <= 8) {
+		if (tch_dma_count == 1) {
+			/* The point of this run: what the stream looks like at the
+			 * moment the engine starts, not only what tch_smmu_fix()
+			 * read a few hundred microseconds earlier. */
+			if (tch.smmu != 0 && tch.smmu_smr >= 0) {
+				printf("LIUQIN TOUCH: SMMU SMR[%d] before DMA #1 is 0x%08x "
+				    "(S2CR 0x%08x)\n", tch.smmu_smr,
+				    tch_rd(tch.smmu, SMMU_SMR((unsigned)tch.smmu_smr)),
+				    tch_rd(tch.smmu, SMMU_S2CR((unsigned)tch.smmu_smr)));
+			} else {
+				printf("LIUQIN TOUCH: SMMU no matching stream entry, DMA #1 "
+				    "runs with the table as the bootloader left it\n");
+			}
+			printf("LIUQIN TOUCH: DMA #1 config: dma_mode_en 0x%08x "
+			    "general_cfg 0x%08x status 0x%08x\n",
+			    tch_rd(tch.se, SE_GENI_DMA_MODE_EN),
+			    tch_rd(tch.se, SE_DMA_GENERAL_CFG),
+			    tch_rd(tch.se, SE_GENI_STATUS));
+		}
+		printf("LIUQIN TOUCH: DMA #%u issuing opcode %u, %s (the transfer starts "
+		    "here)\n", tch_dma_count, (unsigned)cmd, tch_dma_order ?
+		    "command before descriptor" : "descriptor before command");
+	}
+	tch_wr(tch.se, SE_GENI_M_CMD0, (cmd << M_OPCODE_SHFT) | FRAGMENTATION);
+	if (tch_dma_order != 0) {
+		tch_dma_arm(tx != NULL, rx != NULL, tx_pa, rx_pa, len);
+	}
+	tch.status_after_cmd = tch_rd(tch.se, SE_GENI_STATUS);
+	/*
+	 * touch170: the wait has to follow the length.  touch169 handed 16128
+	 * bytes to one command - 215 ms of SPI at 600 kHz - and waited
+	 * 1000 * 50 us, so every attempt "failed" at LEN_IN 5504..6208
+	 * (73..83 ms at 600 kHz) with the command still ACTIVE, no error bit and
+	 * the counter still climbing: the engine was shifting the bytes, the loop
+	 * gave up first.  One poll costs 50 us plus seven register reads, so the
+	 * budget is the wire time in 50 us units plus 20 ms of slack.
+	 */
+	{
+		uint64_t wire_us = tch.spi_hz != 0 ?
+		    (uint64_t)len * 8u * 1000000u / tch.spi_hz : 0;
+
+		budget = (unsigned)(wire_us / 50u) + 400u;
+		if (budget < 1000) {
+			budget = 1000;
+		}
+		if (budget > 100000) {
+			budget = 100000;
+		}
+	}
+	for (i = 0; i < budget; i++) {
+		txst = tx != NULL ? tch_rd(tch.se, SE_DMA_TX_IRQ_STAT) : 0;
+		rxst = rx != NULL ? tch_rd(tch.se, SE_DMA_RX_IRQ_STAT) : 0;
+		txin = tx != NULL ? tch_rd(tch.se, SE_DMA_TX_LEN_IN) : 0;
+		rxin = rx != NULL ? tch_rd(tch.se, SE_DMA_RX_LEN_IN) : 0;
+		/* Three progress points, so a later timeout says whether the engine
+		 * was advancing (rate too slow) or stuck (bus/panel). */
+		if (i == budget / 4) {
+			prog[0] = txin;
+		} else if (i == budget / 2) {
+			prog[1] = txin;
+		} else if (i == (budget * 3) / 4) {
+			prog[2] = txin;
+		}
+		irq = tch_status();
+		if (i == 0) {
+			tch.first_irq = irq;
+		}
+		if (i == 20) {
+			/* 1 ms in: did the engine's data path start at all, before
+			 * any timeout cleanup can hide it? */
+			dbg_mid = tch_rd(tch.se, SE_DMA_DEBUG_REG0);
+			txin_mid = txin;
+			rxin_mid = rxin;
+		}
+		if (irq & TCH_IRQ_ERRS) {
+			break;
+		}
+		/* The command, not the DMA byte counter, is what completes a
+		 * transfer: SE_DMA_TX_LEN_IN reaches the programmed length as soon
+		 * as the engine has *fetched* the bytes, while the SPI still has to
+		 * shift them out (256 B at 600 kHz is 4.3 ms; LEN_IN said 256 after
+		 * 1.75 ms).  touch152 returned on LEN_IN, started the next command
+		 * while the previous one was still clocking - the panel saw half a
+		 * transaction (garbage IDs) and every second command died with
+		 * M_CMD_OVERRUN (irq 0x2).  M_CMD_DONE is the end of the shift. */
+		if (irq & M_CMD_DONE_EN) {
+			break;
+		}
+		delay(50);
+	}
+	if (tch_dma_count <= 8) {
+		printf("LIUQIN TOUCH: DMA #%u came back: status 0x%08x irq 0x%08x tx 0x%08x "
+		    "rx 0x%08x len_in tx %u rx %u after %u polls\n", tch_dma_count,
+		    tch_rd(tch.se, SE_GENI_STATUS), irq, txst, rxst, txin, rxin, i);
+	}
+	tch.dma_tx_status = txst;
+	tch.dma_rx_status = rxst;
+	tch.last_irq = irq;
+	tch_dma_last_irq = irq;
+	tch_dma_last_len = (uint32_t)len;
+	tch_dma_last_cmd = cmd;
+	ok = (irq & M_CMD_DONE_EN) != 0 && (irq & TCH_IRQ_ERRS) == 0 &&
+	    (tx == NULL || (txst & TX_DMA_DONE) != 0) &&
+	    (rx == NULL || (rxst & RX_DMA_DONE) != 0);
+	/*
+	 * touch168: the status bits can land after the command completion.  Poll
+	 * them for another 2 ms, and if they never appear, fall back on what the
+	 * engine cannot fake: the command is done, no error bit fired, and both
+	 * LEN_IN counters reached the length - every TX byte was fetched from
+	 * memory and every RX byte was written back to it.  touch167 lost the
+	 * firmware download to exactly this: chunk 0 "write failed" twice while
+	 * the counters said the bytes had gone out.  Callers verify the data
+	 * (chunk read-back, firmware CRC), so a wrong acceptance cannot ship a
+	 * corrupt image without saying so.
+	 */
+	if (!ok && (irq & M_CMD_DONE_EN) != 0 && (irq & TCH_IRQ_ERRS) == 0) {
+		for (unsigned late = 0; late < 40 && !ok; late++) {
+			delay(50);
+			txst = tx != NULL ? tch_rd(tch.se, SE_DMA_TX_IRQ_STAT) : 0;
+			rxst = rx != NULL ? tch_rd(tch.se, SE_DMA_RX_IRQ_STAT) : 0;
+			ok = (tx == NULL || (txst & TX_DMA_DONE) != 0) &&
+			    (rx == NULL || (rxst & RX_DMA_DONE) != 0);
+			if (ok) {
+				tch_dma_late++;
+				if (tch_dma_late <= 4) {
+					printf("LIUQIN TOUCH: DMA #%u status latched %u "
+					    "polls after the command (tx 0x%08x rx "
+					    "0x%08x)\n", tch_dma_count, late + 1,
+					    txst, rxst);
+				}
+			}
+		}
+		if (!ok && (tx == NULL || txin == len) &&
+		    (rx == NULL || rxin >= len)) {
+			ok = true;
+			tch_dma_lenin++;
+			if (tch_dma_lenin <= 4) {
+				printf("LIUQIN TOUCH: DMA #%u accepted on command done + "
+				    "len_in (cmd %u len %u, tx %u rx %u, status tx "
+				    "0x%08x rx 0x%08x)\n", tch_dma_count, cmd,
+				    (unsigned)len, txin, rxin, txst, rxst);
+			}
+		}
+	}
+	if (tx != NULL && txst != 0) {
+		tch_wr(tch.se, SE_DMA_TX_IRQ_CLR, txst);
+	}
+	if (rx != NULL && rxst != 0) {
+		tch_wr(tch.se, SE_DMA_RX_IRQ_CLR, rxst);
+	}
+	if (irq != 0) {
+		tch_wr(tch.se, SE_GENI_M_IRQ_CLEAR, irq);
+	}
+	if (!ok) {
+		if (tch_dma_fail_lines < 24) {
+			tch_dma_fail_lines++;
+			printf("LIUQIN TOUCH: DMA #%u failed: cmd %u len %u status 0x%08x "
+			    "irq 0x%08x tx 0x%08x rx 0x%08x len_in tx %u rx %u after %u "
+			    "of %u polls, dma_mode_en 0x%08x general_cfg 0x%08x\n",
+			    tch_dma_count, cmd, (unsigned)len,
+			    tch_rd(tch.se, SE_GENI_STATUS), irq, txst, rxst, txin, rxin,
+			    i, budget, tch_rd(tch.se, SE_GENI_DMA_MODE_EN),
+			    tch_rd(tch.se, SE_DMA_GENERAL_CFG));
+			printf("LIUQIN TOUCH: DMA #%u tx progress at 25/50/75%% of "
+			    "the wait: %u %u %u of %u\n", tch_dma_count, prog[0],
+			    prog[1], prog[2], (unsigned)len);
+		}
+		/*
+		 * touch170: leave the engine in a defined state before the caller
+		 * retries.  A timeout leaves the command ACTIVE (GENI_STATUS bit 0)
+		 * with its bytes still on the wire; issuing the retry on top of it is
+		 * how a chunk ends up half written twice.  M_GENI_CMD_CANCEL is the
+		 * SPI core's own path (geni_se_cancel_m_cmd) and returns once the
+		 * engine drops ACTIVE.
+		 */
+		if ((tch_rd(tch.se, SE_GENI_STATUS) & M_GENI_CMD_ACTIVE) != 0) {
+			unsigned n;
+			uint32_t st;
+			const char *how;
+
+			tch_wr(tch.se, SE_GENI_M_CMD_CTRL_REG, M_GENI_CMD_CANCEL);
+			for (n = 0; n < 400; n++) {
+				if ((tch_rd(tch.se, SE_GENI_STATUS) &
+				    M_GENI_CMD_ACTIVE) == 0) {
+					break;
+				}
+				delay(50);
+			}
+			st = tch_rd(tch.se, SE_GENI_STATUS);
+			how = (st & M_GENI_CMD_ACTIVE) != 0 ? "did not clear" : "cleared";
+			tch_dma_cancels++;
+			if (tch_dma_cancels <= 8) {
+				printf("LIUQIN TOUCH: DMA #%u timed out with the command "
+				    "active; cancel %s after %u polls (status "
+				    "0x%08x, %u total)\n", tch_dma_count, how, n, st,
+				    tch_dma_cancels);
+			}
+			tch_wr(tch.se, SE_GENI_M_IRQ_CLEAR, 0xffffffffu);
+		}
+		/*
+		 * What separates "the engine never asked for memory" from "the
+		 * memory side said no": the DMA state machine and how many bytes
+		 * each direction actually moved, the staging contents (RX is
+		 * zeroed before the command, so a written byte proves the DMA ran
+		 * even if its completion never arrived), and the context bank's
+		 * fault registers.  Only the first few attempts, to keep the ring
+		 * log readable.
+		 */
+		if (tch_dma_count <= 3) {
+			uint8_t txb[4], rxb[4];
+			const uint32_t dbg = tch_rd(tch.se, SE_DMA_DEBUG_REG0);
+
+			tch_dma_get(TCH_DMA_TX_OFF, txb, sizeof(txb));
+			tch_dma_get(TCH_DMA_RX_OFF, rxb, sizeof(rxb));
+			printf("LIUQIN TOUCH: DMA #%u state: debug 0x%08x (tx_active %u "
+			    "rx_active %u) len_in tx %u rx %u irq_en tx 0x%x rx 0x%x\n",
+			    tch_dma_count, dbg, (dbg & DMA_TX_ACTIVE) != 0,
+			    (dbg & DMA_RX_ACTIVE) != 0,
+			    tch_rd(tch.se, SE_DMA_TX_LEN_IN),
+			    tch_rd(tch.se, SE_DMA_RX_LEN_IN),
+			    tch_rd(tch.se, SE_DMA_TX_IRQ_EN),
+			    tch_rd(tch.se, SE_DMA_RX_IRQ_EN));
+			printf("LIUQIN TOUCH: DMA #%u at 1 ms: debug 0x%08x len_in tx %u "
+			    "rx %u\n", tch_dma_count, dbg_mid, txin_mid, rxin_mid);
+			if ((irq & M_CMD_DONE_EN) == 0) {
+				printf("LIUQIN TOUCH: DMA #%u no M_CMD_DONE: status 0x%08x "
+				    "irq 0x%08x tx 0x%08x rx 0x%08x gsi 0x%08x\n", tch_dma_count,
+				    tch_rd(tch.se, SE_GENI_STATUS), irq, txst, rxst,
+				    tch_rd(tch.se, SE_GSI_EVENT_EN));
+			} else if ((tx != NULL && (txst & TX_DMA_DONE) == 0) ||
+			    (rx != NULL && (rxst & RX_DMA_DONE) == 0)) {
+				printf("LIUQIN TOUCH: DMA #%u command done, DMA status short: "
+				    "tx 0x%08x rx 0x%08x\n", tch_dma_count, txst, rxst);
+			}
+			printf("LIUQIN TOUCH: DMA #%u staging: tx %02x %02x %02x %02x "
+			    "rx %02x %02x %02x %02x\n", tch_dma_count,
+			    txb[0], txb[1], txb[2], txb[3],
+			    rxb[0], rxb[1], rxb[2], rxb[3]);
+			if (tch.smmu_cb != 0) {
+				printf("LIUQIN TOUCH: SMMU cb fsr 0x%08x far 0x%08x "
+				    "fsynr0 0x%08x\n", tch_rd(tch.smmu_cb, 0x58),
+				    tch_rd(tch.smmu_cb, 0x60), tch_rd(tch.smmu_cb, 0x68));
+			}
+		}
+		if (tx != NULL) {
+			tch_wr(tch.se, SE_DMA_TX_FSM_RST, 1);
+		}
+		if (rx != NULL) {
+			tch_wr(tch.se, SE_DMA_RX_FSM_RST, 1);
+		}
+		tch_dma_abort();
+		return -1;
+	}
+	if (rx != NULL) {
+		tch_dma_get(TCH_DMA_RX_OFF, rx, len);
+	}
+	return 0;
+}
+
+static int
+tch_xfer(const uint8_t *tx, uint8_t *rx, size_t len)
+{
+	if (tch.bitbang) {
+		if (len == 0 || len > 256) {
+			return -1;
+		}
+		tch_bb_xfer(tx, rx, len);
+		return 0;
+	}
+	return tch.fifo_capable ? tch_fifo_xfer(tx, rx, len) : tch_dma_xfer(tx, rx, len);
+}
+
+/*
+ * One owner of the bus at a time.  Bring-up runs before the report thread
+ * exists, but recovery re-downloads the firmware while that thread reads the
+ * event buffer every 10 ms.  Two interleaved chip-select windows and page
+ * commands return garbage to both: in the touch127 log every post-reset
+ * download read a bogus BLD descriptor ("ilm des 0x2f74a2") and wrote an image
+ * that never booted, while the report thread's own reads returned 0xff.  The
+ * lock makes one register access atomic; tch_fw_active keeps the report thread
+ * off the bus for the whole download, where a single 64 KiB chunk already
+ * holds the bus for about a second.
+ */
+static volatile UInt32 tch_spi_owner;
+static volatile int tch_fw_active;
+
+static bool
+tch_spi_acquire(void)
+{
+	for (int i = 0; i < 4000; i++) {
+		if (OSCompareAndSwap(0, 1, &tch_spi_owner)) {
+			return true;
+		}
+		delay(500);             /* half a millisecond per try, ~2 s max */
+	}
+	return false;
+}
+
+static void
+tch_spi_release(void)
+{
+	(void)OSCompareAndSwap(1, 0, &tch_spi_owner);
+}
+
+/* Novatek page/address framing: three bytes set the page, then the address
+ * with bit 7 clear selects a read, the part returns one dummy byte and then
+ * the data.  Mirrors nvt_spi_read() in the vendor driver (and the
+ * tools/touch-novatek harness). */
+static int
+tch_nvt_read_locked(uint32_t addr, uint8_t *out, size_t len)
+{
+	uint8_t page[3];
+	uint8_t tx[NVT_BUF_MAX];
+	uint8_t rx[NVT_BUF_MAX];
+	int err = -1;
+	const size_t overhead = 1 + tch.dummy;         /* address + dummies */
+
+	if (len + overhead > sizeof(tx) || len == 0) {
+		return -1;
+	}
+	if (tch.cs_manual && tch_cs(true) != 0) {
+		return -1;
+	}
+	page[0] = 0xff;                                 /* set page */
+	if (tch.page8) {
+		/* The vendor NT36xxx driver's page register takes bits 23:16 and
+		 * 15:8; the nabu harness used the SPI 15/7 split instead. */
+		page[1] = (uint8_t)((addr >> 16) & 0xff);
+		page[2] = (uint8_t)((addr >> 8) & 0xff);
+	} else {
+		page[1] = (uint8_t)((addr >> 15) & 0xff);
+		page[2] = (uint8_t)((addr >> 7) & 0xff);
+	}
+	/*
+	 * The vendor does this as two SPI messages: nvt_set_page() goes out as
+	 * its own CTP_SPI_WRITE (chip select asserted and released around the
+	 * three bytes) and only then does CTP_SPI_READ send the address.  Keeping
+	 * the page write inside the read's chip-select window leaves the page
+	 * unlatched, and every read then comes from the default page.
+	 */
+	if (tch_cs(true) != 0) {
+		return -1;
+	}
+	err = tch_xfer(page, NULL, sizeof(page));
+	if (tch_cs(false) != 0) {
+		err = -1;
+	}
+	if (err != 0) {
+		return -1;
+	}
+	/* touch159: the same read through the same engine answers with the real
+	 * trim id when the page write is given a long gap (the wire capture had
+	 * a printf in between) and with garbage when it is not. */
+	if (tch_page_dly != 0) {
+		delay(tch_page_dly);
+	}
+
+	if (tch_cs(true) != 0) {
+		return -1;
+	}
+	memset(tx, 0, len + overhead);
+	memset(rx, 0, len + overhead);
+	tx[0] = (uint8_t)(addr & 0x7f);                 /* address, read */
+	err = tch_xfer(tx, rx, len + overhead);
+	if (tch_cs(false) != 0) {
+		err = -1;
+	}
+	if (err == 0) {
+		memcpy(out, rx + overhead, len);
+	}
+	if (tch.cs_manual && tch_cs(false) != 0) {
+		err = -1;
+	}
+	return err;
+}
+
+static int
+tch_nvt_read(uint32_t addr, uint8_t *out, size_t len)
+{
+	int err;
+
+	if (!tch_spi_acquire()) {
+		return -1;
+	}
+	err = tch_nvt_read_locked(addr, out, len);
+	tch_spi_release();
+	return err;
+}
+
+/* gpio16..19 pad levels as a 4-bit mask (bit0 = gpio16).  A pad muxed to qup4
+ * still reports the pin level in TLMM GPIO_IN_OUT bit 0, which is the only way
+ * to see whether the engine's chip select actually reaches the panel. */
+static uint32_t
+tch_pads(void)
+{
+	uint32_t v = 0;
+
+	if (tch.tlmm == 0) {
+		return 0xffffffffu;
+	}
+	for (uint32_t pin = 16; pin <= 19; pin++) {
+		if (tch_rd(tch.tlmm, TLMM_CTL(pin) + TLMM_IN_OUT) & 1u) {
+			v |= 1u << (pin - 16);
+		}
+	}
+	return v;
+}
+
+/*
+ * A poor man's logic analyser.  The engine's loopback is dead on this SE
+ * (FIFO interface disabled: both the DMA and the FIFO loopback return zeros)
+ * and the panel only answers - wrongly - so the last witness is the wire
+ * itself.  With the SPI clock at its slowest (19.2 MHz / 4095 = 4.7 kHz,
+ * 213 us per bit) the CPU can sample the pads while the engine shifts and
+ * rebuild what actually went out on MOSI and came back on MISO.
+ */
+static void
+tch_wire_capture(bool tx_only, const char *what, const uint8_t *pat, size_t len,
+    int variant)
+{
+	uint8_t txb[8] = { 0 }, rxb[8] = { 0 };
+	uint8_t fill[24], se_rx[24];
+	const size_t maxbits = len * 8;
+	size_t nbits = 0;
+	uint32_t prev, v;
+	unsigned spins = 0;
+
+	if (tch.tlmm == 0 || len == 0 || len > sizeof(txb)) {
+		return;
+	}
+	tch.div = 4095;
+	tch_wr(tch.se, GENI_SER_M_CLK_CFG, (4095u << CLK_DIV_SHFT) | SER_CLK_EN);
+
+	memset(fill, 0xee, sizeof(fill));
+	tch_dma_put(TCH_DMA_TX_OFF, pat, len);
+	/* 0xee instead of zeros: if the engine's RX DMA lands on a different
+	 * offset than the one we read, the untouched 0xee bytes show it. */
+	tch_dma_put(TCH_DMA_RX_OFF, fill, sizeof(fill));
+	(void)tch_cs(true);
+	tch_dma_mode();
+	tch_wr(tch.se, SE_SPI_TX_TRANS_LEN, (uint32_t)len);
+	tch_wr(tch.se, SE_SPI_RX_TRANS_LEN, tx_only ? 0u : (uint32_t)len);
+	if (variant == 1) {
+		/* FIFO-mode watermarks (13/14 of a 16-deep FIFO) may be what stops
+		 * the RX DMA from triggering on a short read: drop them to 1. */
+		tch_wr(tch.se, SE_GENI_RX_WATERMARK_REG, 1);
+		tch_wr(tch.se, SE_GENI_RX_RFR_WATERMARK_REG, 1);
+	}
+	tch_wr(tch.se, SE_GENI_M_CMD0,
+	    ((tx_only ? SPI_TX_ONLY : SPI_TX_RX) << M_OPCODE_SHFT) | FRAGMENTATION);
+	tch_dma_arm(true, !tx_only, tch.dma_pa + TCH_DMA_TX_OFF,
+	    tch.dma_pa + TCH_DMA_RX_OFF, len);
+	if (variant == 2) {
+		/* EOT on the RX buffer (Linux leaves it 0, but so is everything
+		 * here that turned out to be a guess). */
+		tch_wr(tch.se, SE_DMA_RX_ATTR, GENI_SE_DMA_EOT_BUF);
+	}
+	if (variant != 0) {
+		printf("LIUQIN TOUCH: capture variant %d: wm %u/%u attr 0x%08x\n",
+		    variant, tch_rd(tch.se, SE_GENI_RX_WATERMARK_REG),
+		    tch_rd(tch.se, SE_GENI_RX_RFR_WATERMARK_REG),
+		    tch_rd(tch.se, SE_DMA_RX_ATTR));
+	}
+
+	prev = tch_pads();
+	/* ~200k samples at ~2 us each covers a 13.6 ms transfer many times
+	 * over; a hung engine costs at most a fifth of a second. */
+	while (spins++ < 200000u) {
+		v = tch_pads();
+		/* rising CLK edge is the mode-0 sample point for both lines */
+		if (!(prev & 0x4u) && (v & 0x4u) && nbits < maxbits) {
+			if (v & 0x2u) {
+				txb[nbits >> 3] |= (uint8_t)(1u << (7 - (nbits & 7)));
+			}
+			if (v & 0x1u) {
+				rxb[nbits >> 3] |= (uint8_t)(1u << (7 - (nbits & 7)));
+			}
+			nbits++;
+		}
+		prev = v;
+	}
+	(void)tch_cs(false);
+	tch_wr(tch.se, SE_GENI_M_IRQ_CLEAR, 0xffffffff);
+
+	printf("LIUQIN TOUCH: wire %s tx", what);
+	for (size_t i = 0; i < len; i++) {
+		printf(" %02x", txb[i]);
+	}
+	printf(" (%u bits)\n", (unsigned)nbits);
+	if (!tx_only) {
+		printf("LIUQIN TOUCH: wire %s rx", what);
+		for (size_t i = 0; i < len; i++) {
+			printf(" %02x", rxb[i]);
+		}
+		printf("\n");
+		/* The same transfer as the engine's RX DMA saw it.  If these two
+		 * lines differ, the wire is right and the engine's capture is
+		 * wrong - which is exactly what touch161's speed sweep says. */
+		tch_dma_get(TCH_DMA_RX_OFF, se_rx, sizeof(se_rx));
+		printf("LIUQIN TOUCH: dma  %s rx", what);
+		for (size_t i = 0; i < sizeof(se_rx); i++) {
+			printf(" %02x", se_rx[i]);
+		}
+		printf(" (len_in %u irq 0x%08x)\n",
+		    tch_rd(tch.se, SE_DMA_RX_LEN_IN),
+		    tch_rd(tch.se, SE_DMA_RX_IRQ_STAT));
+	}
+
+	if (variant == 1) {
+		tch_wr(tch.se, SE_GENI_RX_WATERMARK_REG, tch.tx_fifo_depth - 3);
+		tch_wr(tch.se, SE_GENI_RX_RFR_WATERMARK_REG, tch.tx_fifo_depth - 2);
+	}
+	tch.div = 32;
+	tch_wr(tch.se, GENI_SER_M_CLK_CFG, ((32u & CLK_DIV_MSK) << CLK_DIV_SHFT) | SER_CLK_EN);
+	if (variant == 0) {
+		printf("LIUQIN TOUCH: rx cfg len %u attr 0x%08x gran %u pack0 0x%08x "
+		    "pack1 0x%08x fifo_stat 0x%08x\n",
+		    tch_rd(tch.se, SE_DMA_RX_LEN), tch_rd(tch.se, SE_DMA_RX_ATTR),
+		    tch_rd(tch.se, SE_GENI_BYTE_GRAN),
+		    tch_rd(tch.se, SE_GENI_RX_PACKING_CFG0),
+		    tch_rd(tch.se, SE_GENI_RX_PACKING_CFG1),
+		    tch_rd(tch.se, SE_GENI_RX_FIFO_STATUS));
+	}
+}
+
+/*
+ * Does the engine's RX FIFO receive anything at all?  Clock the real read
+ * command with the TX DMA armed but the RX DMA *not* armed: nothing drains the
+ * FIFO, so RX_FIFO_STATUS and the FIFO registers themselves answer the
+ * question that the DMA cannot - if the words are there, the RX data path is
+ * good and only the DMA read side is broken (and the CPU could read the FIFO
+ * directly); if the FIFO stays empty, RX never reaches it and the engine's
+ * data path really is GSI-only.
+ */
+static void
+tch_rx_fifo_test(void)
+{
+	uint8_t tx[8] = { 0 };
+	uint32_t prev, v, wc, i;
+	size_t nbits = 0;
+	unsigned spins = 0;
+
+	if (tch.tlmm == 0) {
+		return;
+	}
+	tx[0] = (uint8_t)(NVT_CHIP_VER_TRIM_ADDR & 0x7f);
+	tch.div = 4095;
+	tch_wr(tch.se, GENI_SER_M_CLK_CFG, (4095u << CLK_DIV_SHFT) | SER_CLK_EN);
+
+	tch_dma_put(TCH_DMA_TX_OFF, tx, sizeof(tx));
+	(void)tch_cs(true);
+	tch_dma_mode();
+	tch_wr(tch.se, SE_SPI_TX_TRANS_LEN, (uint32_t)sizeof(tx));
+	tch_wr(tch.se, SE_SPI_RX_TRANS_LEN, (uint32_t)sizeof(tx));
+	tch_wr(tch.se, SE_GENI_M_CMD0, (SPI_TX_RX << M_OPCODE_SHFT) | FRAGMENTATION);
+	/* RX DMA deliberately not armed: tch_dma_arm(tx, rx=false, ...) */
+	tch_dma_arm(true, false, tch.dma_pa + TCH_DMA_TX_OFF, 0, sizeof(tx));
+
+	prev = tch_pads();
+	while (spins++ < 200000u) {
+		v = tch_pads();
+		if (!(prev & 0x4u) && (v & 0x4u) && nbits < sizeof(tx) * 8) {
+			nbits++;
+		}
+		prev = v;
+	}
+	/* FIFO status before anything can drain it (the RX DMA never ran). */
+	wc = tch_rd(tch.se, SE_GENI_RX_FIFO_STATUS);
+	printf("LIUQIN TOUCH: rx fifo after clocking (no rx dma): stat 0x%08x wc %u "
+	    "(%u bits on the wire)\n", wc, wc & RX_FIFO_WC_MSK, (unsigned)nbits);
+	wc &= RX_FIFO_WC_MSK;
+	for (i = 0; i < wc && i < 8u; i++) {
+		printf("LIUQIN TOUCH: rx fifo word %u = 0x%08x\n", i,
+		    tch_rd(tch.se, SE_GENI_RX_FIFOn));
+	}
+	/* touch166: the word count after the reads separates "the shifter really
+	 * received zeros" from "the CPU cannot read this FIFO at all".  With
+	 * SE_FIFO_IF_DISABLE set (the bootloader flashed this SE for GSI) the
+	 * FIFO reads return 0 and the count never moves. */
+	wc = tch_rd(tch.se, SE_GENI_RX_FIFO_STATUS) & RX_FIFO_WC_MSK;
+	printf("LIUQIN TOUCH: rx fifo wc after draining: %u (%s)\n", wc,
+	    wc == 0 ? "the words above were the real FIFO contents" :
+	    "the reads drained nothing - CPU FIFO access is disabled");
+	(void)tch_cs(false);
+	tch_wr(tch.se, SE_GENI_M_IRQ_CLEAR, 0xffffffff);
+
+	tch.div = 32;
+	tch_wr(tch.se, GENI_SER_M_CLK_CFG, ((32u & CLK_DIV_MSK) << CLK_DIV_SHFT) | SER_CLK_EN);
+}
+
+/*
+ * touch166: one place that answers "can this engine receive at all".
+ *
+ * touch165 proved the receive side is the only broken half: the transmit DMA
+ * is byte exact on the wire, the panel answers, and yet every byte the engine
+ * reports as received is zero.  Two things can still be wrong - the pad is not
+ * the serial input the SPI firmware samples, or the engine's receive block is
+ * not enabled - and each has a different test:
+ *
+ *  A. duplex opcode 3 (what spi-geni-qcom builds) instead of 7 (what the
+ *     vendor firmware in this SE was flashed for);
+ *  B. SE_SPI_LOOPBACK, which feeds the engine's own MOSI straight back into
+ *     the receiver and bypasses the pad entirely: if loopback returns our
+ *     pattern, the receive path is good and only the pad is in the way;
+ *  C. the FIFO word count after a drain, printed by tch_rx_fifo_test().
+ *
+ * Returns true when a route returned the ROM trim id, and leaves that route
+ * selected for the rest of the boot.
+ */
+static bool
+tch_rx_route_test(void)
+{
+	static const unsigned opcodes[2] = { 3, 7 };
+	static const uint8_t pat[4] = { 0xde, 0xad, 0xbe, 0xef };
+	uint8_t id[6];
+	bool ok = false;
+	unsigned keep = 0;
+
+	tch_rx_via_fifo = 0;
+	for (unsigned i = 0; i < 2; i++) {
+		memset(id, 0, sizeof(id));
+		tch_opcode = (int)opcodes[i];
+		const int err = tch_nvt_read(NVT_CHIP_VER_TRIM_ADDR, id, sizeof(id));
+
+		printf("LIUQIN TOUCH: rx route A%u opcode %u: %02x %02x %02x %02x %02x %02x "
+		    "(%s)\n", i, opcodes[i], id[0], id[1], id[2], id[3], id[4], id[5],
+		    err != 0 ? "read failed" :
+		    (id[4] == 0x65 && id[5] == 0x03) ? "MATCH" : "no match");
+		if (err == 0 && id[4] == 0x65 && id[5] == 0x03 && !ok) {
+			ok = true;
+			keep = opcodes[i];
+		}
+	}
+
+	/* B: internal loopback.  The engine shifts its own MOSI back in, so the
+	 * answer is known exactly - 0xde 0xad 0xbe 0xef out, the same back.
+	 * Only meaningful with a duplex opcode that receives, which is why
+	 * touch166 ran it with 7 and learned nothing: 3 is the default now. */
+	tch_opcode = (int)SPI_DUPLEX;
+	tch_wr(tch.se, SE_SPI_LOOPBACK, 1);
+	{
+		uint8_t rb[4] = { 0 };
+		const int err = tch_dma_xfer(pat, rb, sizeof(pat));
+		const uint32_t irq = tch_rd(tch.se, SE_DMA_RX_IRQ_STAT);
+
+		printf("LIUQIN TOUCH: rx route B loopback tx de ad be ef -> rx %02x %02x %02x "
+		    "%02x (err %d, rx dma irq 0x%08x len_in %u fifo 0x%08x)\n",
+		    rb[0], rb[1], rb[2], rb[3], err, irq,
+		    tch_rd(tch.se, SE_DMA_RX_LEN_IN),
+		    tch_rd(tch.se, SE_GENI_RX_FIFO_STATUS));
+	}
+	tch_wr(tch.se, SE_SPI_LOOPBACK, 0);
+
+	tch_opcode = ok ? (int)keep : 0;
+	tch_rx_ok = ok;
+	return ok;
+}
+
+/*
+ * Before trusting any panel read, prove the engine's own data path and see
+ * where the chip select lands.  touches 129..153 never separated "the SE
+ * moves bytes correctly" from "the panel hears the SE": a DMA that completes
+ * with tx/rx DMA_DONE says nothing about the pads.  The ROM trim id is the
+ * reference ("20 00 00 32 65 03" on every bit-banged boot), so the last part
+ * walks the two orderings and three clock dividers and keeps the first that
+ * returns it.
+ */
+static void
+tch_dma_diag(void)
+{
+	uint32_t idle, cs_on, cs_off;
+
+	printf("LIUQIN TOUCH: SE cfg loopback 0x%08x inv 0x%08x trans 0x%08x\n",
+	    tch_rd(tch.se, SE_SPI_LOOPBACK), tch_rd(tch.se, SE_SPI_DEMUX_OUTPUT_INV),
+	    tch_rd(tch.se, SE_SPI_TRANS_CFG));
+	idle = tch_pads();
+	(void)tch_cs(true);
+	cs_on = tch_pads();
+	(void)tch_cs(false);
+	cs_off = tch_pads();
+	printf("LIUQIN TOUCH: pads 16..19 idle 0x%x assert 0x%x release 0x%x "
+	    "(bit0 16/miso, bit1 17/mosi, bit2 18/clk, bit3 19/cs)\n",
+	    idle, cs_on, cs_off);
+
+	tch_wr(tch.se, SE_SPI_LOOPBACK, 1);
+	tch_wr(tch.se, SE_SPI_LOOPBACK, 1);
+	printf("LIUQIN TOUCH: loopback reg written 1, reads 0x%08x\n",
+	    tch_rd(tch.se, SE_SPI_LOOPBACK));
+	tch_wr(tch.se, SE_SPI_LOOPBACK, 0);
+
+	/* touch166: the three-way receive test runs first, because its answer
+	 * decides whether the rest of this walk is worth anything - and because
+	 * it is the only step that can still change the outcome of the boot. */
+	(void)tch_rx_route_test();
+
+	/* CS trace across one full read: the page write and the read are two
+	 * commands and FRAGMENTATION has to hold the line between them, the way
+	 * the pads path keeps CS asserted for the whole window. */
+	{
+		uint8_t page[3], tx[8], rx[8] = { 0 };
+		uint32_t p[5];
+
+		p[0] = tch_pads();
+		(void)tch_cs(true);
+		p[1] = tch_pads();
+		page[0] = 0xff;
+		page[1] = (uint8_t)((NVT_CHIP_VER_TRIM_ADDR >> 15) & 0xff);
+		page[2] = (uint8_t)((NVT_CHIP_VER_TRIM_ADDR >> 7) & 0xff);
+		(void)tch_xfer(page, NULL, 3);
+		p[2] = tch_pads();
+		memset(tx, 0, sizeof(tx));
+		tx[0] = (uint8_t)(NVT_CHIP_VER_TRIM_ADDR & 0x7f);
+		(void)tch_xfer(tx, rx, sizeof(rx));
+		p[3] = tch_pads();
+		(void)tch_cs(false);
+		p[4] = tch_pads();
+		printf("LIUQIN TOUCH: CS trace idle 0x%x assert 0x%x after-page 0x%x "
+		    "after-read 0x%x release 0x%x rx %02x %02x %02x %02x %02x %02x\n",
+		    p[0], p[1], p[2], p[3], p[4],
+		    rx[2], rx[3], rx[4], rx[5], rx[6], rx[7]);
+	}
+
+	{
+		static const uint32_t divs[] = { 32, 128, 8 };
+		bool found = false;
+
+		for (unsigned d = 0; d < 3 && !found; d++) {
+			tch.div = divs[d];
+			tch_wr(tch.se, GENI_SER_M_CLK_CFG,
+			    ((tch.div & CLK_DIV_MSK) << CLK_DIV_SHFT) | SER_CLK_EN);
+			for (unsigned order = 0; order < 2 && !found; order++) {
+				uint8_t id[6] = { 0 };
+				int err;
+
+				tch_dma_order = (int)order;
+				err = tch_nvt_read(NVT_CHIP_VER_TRIM_ADDR, id, sizeof(id));
+				printf("LIUQIN TOUCH: trim id %s div %u: "
+				    "%02x %02x %02x %02x %02x %02x (%s)\n",
+				    order ? "cmd-first" : "desc-first", divs[d],
+				    id[0], id[1], id[2], id[3], id[4], id[5],
+				    err != 0 ? "read failed" :
+				    (id[4] == 0x65 && id[5] == 0x03) ? "MATCH" : "no match");
+				if (err == 0 && id[4] == 0x65 && id[5] == 0x03) {
+					found = true;
+				}
+			}
+		}
+		if (!found) {
+			/* Ground truth on the pads: does the panel still answer the
+			 * bit-banged path the way it has for months?  If not, the
+			 * engine's transfers wedged it and the reset below matters;
+			 * if yes, the fault is inside the engine's data path. */
+			if (tch.tlmm != 0) {
+				uint8_t id[6] = { 0 };
+				uint8_t raw[9] = { 0 };
+
+				tch.div = 32;
+				tch_wr(tch.se, GENI_SER_M_CLK_CFG,
+				    ((tch.div & CLK_DIV_MSK) << CLK_DIV_SHFT) | SER_CLK_EN);
+				/* The FIFO interface feeds the same shift register
+				 * without the DMA engine: if the panel answers this
+				 * path correctly, the shift/clock/CS path is fine and
+				 * the fault is the DMA->FIFO delivery; if it answers
+				 * wrongly too, the shift path itself is broken. */
+				tch.fifo_capable = true;
+				{
+					uint8_t fid[6] = { 0 };
+					const int ferr = tch_nvt_read(NVT_CHIP_VER_TRIM_ADDR,
+					    fid, sizeof(fid));
+
+					printf("LIUQIN TOUCH: FIFO-path trim id %02x %02x %02x "
+					    "%02x %02x %02x (%s)\n", fid[0], fid[1], fid[2],
+					    fid[3], fid[4], fid[5],
+					    ferr != 0 ? "read failed" :
+					    (fid[4] == 0x65 && fid[5] == 0x03) ?
+					    "MATCH" : "no match");
+				}
+				tch.fifo_capable = false;
+				/* Does the page write survive?  Reading with an explicit
+				 * page-0 write vs the real page: if both return the same,
+				 * the TX-only page write is being lost and every read hits
+				 * the default page. */
+				{
+					uint8_t p0[3] = { 0xff, 0x00, 0x00 };
+					uint8_t tx8[8] = { 0 };
+					uint8_t rr[8] = { 0 };
+
+					tx8[0] = (uint8_t)(NVT_CHIP_VER_TRIM_ADDR & 0x7f);
+					(void)tch_cs(true);
+					(void)tch_xfer(p0, NULL, 3);
+					(void)tch_cs(false);
+					(void)tch_cs(true);
+					(void)tch_xfer(tx8, rr, 8);
+					(void)tch_cs(false);
+					printf("LIUQIN TOUCH: page-0 read rx %02x %02x %02x %02x "
+					    "%02x %02x %02x %02x\n", rr[0], rr[1], rr[2], rr[3],
+					    rr[4], rr[5], rr[6], rr[7]);
+				}
+				/* Last witness: what the pins actually carry.  touch158
+				 * proved the duplex path is byte exact on the wire
+				 * (a5 5a 3c c3 0f f0 11 88); what is left is whether
+				 * a TX-only command - the page write - shifts its bytes
+				 * at all, and what the panel really says back to the
+				 * real read command. */
+				{
+					static const uint8_t pat8[8] = { 0xa5, 0x5a, 0x3c,
+						0xc3, 0x0f, 0xf0, 0x11, 0x88 };
+					uint8_t page3[3] = { 0xff, 0, 0 };
+					uint8_t cmd8[8] = { 0 };
+
+					page3[1] = (uint8_t)((NVT_CHIP_VER_TRIM_ADDR >> 15) & 0xff);
+					page3[2] = (uint8_t)((NVT_CHIP_VER_TRIM_ADDR >> 7) & 0xff);
+					cmd8[0] = (uint8_t)(NVT_CHIP_VER_TRIM_ADDR & 0x7f);
+					printf("LIUQIN TOUCH: wire capture at %u Hz\n",
+					    SE_CLK_HZ / 4095);
+					tch_wire_capture(false, "duplex", pat8, 8, 0);
+					tch_wire_capture(true, "txonly", page3, 3, 0);
+					tch_wire_capture(false, "readcmd", cmd8, 8, 0);
+					tch_wire_capture(false, "readcmd-wm1", cmd8, 8, 1);
+					tch_wire_capture(false, "readcmd-attr1", cmd8, 8, 2);
+					tch_rx_fifo_test();
+					/* The same read, now with the CPU draining the RX
+					 * FIFO instead of the RX DMA. */
+					{
+						uint8_t id[6] = { 0 };
+						int err;
+						bool hit;
+
+						tch_rx_via_fifo = 1;
+						tch.div = 32;
+						tch_wr(tch.se, GENI_SER_M_CLK_CFG,
+						    (32u << CLK_DIV_SHFT) | SER_CLK_EN);
+						tch_dma_order = 1;
+						err = tch_nvt_read(NVT_CHIP_VER_TRIM_ADDR, id,
+						    sizeof(id));
+						hit = err == 0 && id[4] == 0x65 && id[5] == 0x03;
+						printf("LIUQIN TOUCH: tx-dma + cpu rx fifo: %02x %02x "
+						    "%02x %02x %02x %02x (%s)\n", id[0], id[1],
+						    id[2], id[3], id[4], id[5],
+						    err != 0 ? "read failed" :
+						    hit ? "MATCH - keeping it" : "no match");
+						if (!hit) {
+							tch_rx_via_fifo = 0;
+						}
+					}
+				}
+				/* The delay matrix failed (all four groups), so the gap is
+				 * not the cause - what is left is the clock itself, or the
+				 * first byte's delivery at speed.  Two tests, both decisive:
+				 * (a) the engine's own read at slower clocks: if it answers
+				 * correctly at 4.7 kHz, the SE path is sound and only the rate
+				 * is in the way; (b) the same read with the descriptors armed
+				 * *before* the command (desc-first) and the page write sent as
+				 * duplex (opcode 7), which pre-arms TX - the thing that makes
+				 * the first byte reliable at speed - without the TX-only
+				 * desc-first hang. */
+				{
+					static const uint32_t divs2[] = { 4095, 512, 128, 32 };
+					bool kept = false;
+
+					tch_page_dly = 0;
+					tch_cs_dly = 0;
+					tch_dma_order = 1;
+					for (unsigned i = 0; i < 4 && !kept; i++) {
+						uint8_t id[6] = { 0 };
+						int err;
+
+						tch.div = divs2[i];
+						tch_wr(tch.se, GENI_SER_M_CLK_CFG,
+						    ((tch.div & CLK_DIV_MSK) << CLK_DIV_SHFT) | SER_CLK_EN);
+						err = tch_nvt_read(NVT_CHIP_VER_TRIM_ADDR, id, sizeof(id));
+						printf("LIUQIN TOUCH: se read div %u (%u Hz): %02x %02x %02x "
+						    "%02x %02x %02x (%s)\n", tch.div, SE_CLK_HZ / tch.div,
+						    id[0], id[1], id[2], id[3], id[4], id[5],
+						    err != 0 ? "read failed" :
+						    (id[4] == 0x65 && id[5] == 0x03) ? "MATCH" : "no match");
+						if (err == 0 && id[4] == 0x65 && id[5] == 0x03) {
+							kept = true;
+						}
+					}
+					if (kept) {
+						tch.spi_hz = SE_CLK_HZ / tch.div;
+						printf("LIUQIN TOUCH: keeping div %u (%u Hz)\n",
+						    tch.div, tch.spi_hz);
+					} else {
+						tch.div = 32;
+						tch_wr(tch.se, GENI_SER_M_CLK_CFG,
+						    ((tch.div & CLK_DIV_MSK) << CLK_DIV_SHFT) | SER_CLK_EN);
+					}
+				}
+				/* (b) descriptor-first duplex at 600 kHz. */
+				{
+					uint8_t page[3], tx[8] = { 0 }, rx[8] = { 0 }, scr[3] = { 0 };
+					int err;
+
+					page[0] = 0xff;
+					page[1] = (uint8_t)((NVT_CHIP_VER_TRIM_ADDR >> 15) & 0xff);
+					page[2] = (uint8_t)((NVT_CHIP_VER_TRIM_ADDR >> 7) & 0xff);
+					tx[0] = (uint8_t)(NVT_CHIP_VER_TRIM_ADDR & 0x7f);
+					tch.div = 32;
+					tch_wr(tch.se, GENI_SER_M_CLK_CFG,
+					    ((32u & CLK_DIV_MSK) << CLK_DIV_SHFT) | SER_CLK_EN);
+					tch_dma_order = 0;
+					(void)tch_cs(true);
+					(void)tch_xfer(page, scr, 3);
+					(void)tch_cs(false);
+					(void)tch_cs(true);
+					err = tch_xfer(tx, rx, 8);
+					(void)tch_cs(false);
+					printf("LIUQIN TOUCH: desc-first duplex: %02x %02x %02x %02x %02x "
+					    "%02x %02x %02x (%s)\n", rx[0], rx[1], rx[2], rx[3], rx[4],
+					    rx[5], rx[6], rx[7],
+					    err != 0 ? "xfer failed" :
+					    (rx[6] == 0x65 && rx[7] == 0x03) ? "MATCH at rx[6..7]" : "no match");
+					tch_dma_order = 1;
+				}
+				/* Before switching the mux, one raw look at what the
+				 * engine captures: the whole RX of an 8-byte read
+				 * (skip nothing) and of a 9-byte double-address read -
+				 * the shift pattern, if any, shows up directly. */
+				{
+					uint8_t page[3], tx[9];
+
+					page[0] = 0xff;
+					page[1] = (uint8_t)((NVT_CHIP_VER_TRIM_ADDR >> 15) & 0xff);
+					page[2] = (uint8_t)((NVT_CHIP_VER_TRIM_ADDR >> 7) & 0xff);
+					memset(tx, 0, sizeof(tx));
+					tx[0] = (uint8_t)(NVT_CHIP_VER_TRIM_ADDR & 0x7f);
+					(void)tch_cs(true);
+					(void)tch_xfer(page, NULL, 3);
+					(void)tch_cs(false);
+					(void)tch_cs(true);
+					(void)tch_xfer(tx, raw, 8);
+					(void)tch_cs(false);
+					printf("LIUQIN TOUCH: raw read8 rx %02x %02x %02x %02x "
+					    "%02x %02x %02x %02x\n", raw[0], raw[1], raw[2],
+					    raw[3], raw[4], raw[5], raw[6], raw[7]);
+					tx[1] = tx[0];
+					memset(raw, 0, sizeof(raw));
+					(void)tch_cs(true);
+					(void)tch_xfer(page, NULL, 3);
+					(void)tch_cs(false);
+					(void)tch_cs(true);
+					(void)tch_xfer(tx, raw, 9);
+					(void)tch_cs(false);
+					printf("LIUQIN TOUCH: raw double-addr rx %02x %02x %02x "
+					    "%02x %02x %02x %02x %02x %02x\n", raw[0], raw[1],
+					    raw[2], raw[3], raw[4], raw[5], raw[6], raw[7],
+					    raw[8]);
+				}
+
+				bb_calibrate();
+				for (unsigned pin = 16; pin <= 19; pin++) {
+					tch_wr(tch.tlmm, TLMM_CTL(pin),
+					    (0u << 2) | (0u << 0) | (2u << 6));
+				}
+				tch.bitbang = true;
+				tch.cs_manual = true;
+				tch.bb_pace_us = 5;
+				tch.pin_cs = 19;
+				tch.pin_clk = 18;
+				tch.pin_mosi = 17;
+				tch.pin_miso = 16;
+				tch_bb_dir(19, true, 1);
+				tch_bb_dir(18, true, 0);
+				tch_bb_dir(17, true, 0);
+				tch_bb_dir(16, false, 0);
+				(void)tch_nvt_read(NVT_CHIP_VER_TRIM_ADDR, id, sizeof(id));
+				printf("LIUQIN TOUCH: pad-path trim id %02x %02x %02x %02x "
+				    "%02x %02x (%s)\n", id[0], id[1], id[2], id[3], id[4],
+				    id[5], id[4] == 0x65 && id[5] == 0x03 ?
+				    "panel alive" : "no answer");
+				tch.bitbang = false;
+				for (unsigned pin = 16; pin <= 19; pin++) {
+					tch_wr(tch.tlmm, TLMM_CTL(pin),
+					    (1u << 2) | (0u << 0) | (2u << 6));
+				}
+				/* A clean slate: the same reset the pads path does, then
+				 * ask through the engine once more. */
+				tch_bb_dir(20, true, 0);
+				delay(100 * 1000);
+				tch_bb_dir(20, true, 1);
+				delay(200 * 1000);
+				printf("LIUQIN TOUCH: gpio20 reset pulse done\n");
+				tch.div = 32;
+				tch_wr(tch.se, GENI_SER_M_CLK_CFG,
+				    ((tch.div & CLK_DIV_MSK) << CLK_DIV_SHFT) | SER_CLK_EN);
+				for (unsigned order = 0; order < 2 && !found; order++) {
+					uint8_t id2[6] = { 0 };
+					int err;
+
+					tch_dma_order = (int)order;
+					err = tch_nvt_read(NVT_CHIP_VER_TRIM_ADDR,
+					    id2, sizeof(id2));
+					printf("LIUQIN TOUCH: reset retry trim id %s div 32: "
+					    "%02x %02x %02x %02x %02x %02x (%s)\n",
+					    order ? "cmd-first" : "desc-first",
+					    id2[0], id2[1], id2[2], id2[3], id2[4], id2[5],
+					    err != 0 ? "read failed" :
+					    (id2[4] == 0x65 && id2[5] == 0x03) ?
+					    "MATCH" : "no match");
+					if (err == 0 && id2[4] == 0x65 && id2[5] == 0x03) {
+						found = true;
+					}
+				}
+			}
+		}
+		if (!found) {
+			tch.div = 32;
+			tch_wr(tch.se, GENI_SER_M_CLK_CFG,
+			    ((tch.div & CLK_DIV_MSK) << CLK_DIV_SHFT) | SER_CLK_EN);
+			printf("LIUQIN TOUCH: no ordering/clock/reset combination returned "
+			    "the ROM trim id\n");
+		} else {
+			tch.spi_hz = SE_CLK_HZ / tch.div;
+			printf("LIUQIN TOUCH: keeping %s, div %u (%u kHz)\n",
+			    tch_dma_order ? "cmd-first" : "desc-first", tch.div,
+			    tch.spi_hz / 1000);
+		}
+	}
+}
+
+/* Electrical check of the four pads before blaming the controller: drive each
+ * one and read its own pad back, then bias the three data pads — a pad the
+ * chip is driving does not follow the bias, a floating one does. */
+static void
+tch_bb_selftest(void)
+{
+	static const uint32_t pads[4] = { 16, 17, 18, 19 };
+
+	for (unsigned i = 0; i < 4; i++) {
+		tch_bb_dir(pads[i], true, 0);
+		delay(10);
+		const int lo = bb_get(pads[i]);
+		tch_bb_dir(pads[i], true, 1);
+		delay(10);
+		const int hi = bb_get(pads[i]);
+
+		printf("LIUQIN TOUCH: pad gpio%u out: drive0 reads %d, drive1 reads %d%s (ctl 0x%08x)\n",
+		    pads[i], lo, hi, (lo == 0 && hi == 1) ? "" : "  <-- does not follow",
+		    tch_rd(tch.tlmm, TLMM_CTL(pads[i])));
+		/* Same drive, sampled immediately and after 50 us: a slow rise or
+		 * a loaded line looks like a dead one if read too early. */
+		bb_set(pads[i], 1);
+		const int now = bb_get(pads[i]);
+		delay(50);
+		const int later = bb_get(pads[i]);
+
+		printf("LIUQIN TOUCH: pad gpio%u rise: immediately %d, after 50 us %d\n",
+		    pads[i], now, later);
+	}
+	for (unsigned i = 0; i < 4; i++) {
+		tch_wr(tch.tlmm, TLMM_CTL(pads[i]), (0u << 2) | (1u << 0) | (2u << 6));  /* pull-down */
+		delay(2000);
+		const int pd = bb_get(pads[i]);
+		tch_wr(tch.tlmm, TLMM_CTL(pads[i]), (0u << 2) | (3u << 0) | (2u << 6));  /* pull-up */
+		delay(2000);
+		const int pu = bb_get(pads[i]);
+
+		printf("LIUQIN TOUCH: pad gpio%u in: pull-down reads %d, pull-up reads %d (%s)\n",
+		    pads[i], pd, pu, (pd == 0 && pu == 1) ? "floating" : "driven");
+	}
+	/* The INT pad is driven by the controller and known to read 0 at rest;
+	 * it is the reference that the input path itself works. */
+	printf("LIUQIN TOUCH: pad gpio21 in: %d (INT, expect 0) io 0x%08x ctl 0x%08x\n",
+	    bb_get(21), tch_rd(tch.tlmm, TLMM_CTL(21) + TLMM_IN_OUT),
+	    tch_rd(tch.tlmm, TLMM_CTL(21)));
+}
+
+/* Find which pad is the clock, which is MOSI and which is MISO: nothing in the
+ * device tree names the roles, so try the six assignments and keep the one
+ * that answers with a Novatek trim id.  gpio19 is the chip select (the DT's
+ * qup_spi4_cs group) and stays one. */
+/* The vendor driver's chip-info page; the SPI trim id sits at 0x3f004, and
+ * older parts answer on the page address instead. */
+#define NVT_CHIP_INFO_PAGE      0x1f64eu
+
+/* One trim-id + FWINFO read with the current role assignment. */
+static int
+tch_probe_roles(const char *what, unsigned n)
+{
+	uint8_t id[6] = { 0 };
+	uint8_t old[6] = { 0 };
+	uint8_t fw[16] = { 0 };
+
+	(void)tch_nvt_read(NVT_CHIP_VER_TRIM_ADDR, id, sizeof(id));
+	(void)tch_nvt_read(NVT_CHIP_VER_TRIM_NABU, old, sizeof(old));
+	(void)tch_nvt_read(NVT_FWINFO_ADDR, fw, sizeof(fw));
+	bool id_ok = false;
+
+	for (size_t i = 0; i + 1 < sizeof(id); i++) {
+		if ((id[i] == 0x65 && id[i + 1] == 0x03) ||
+		    (old[i] == 0x65 && old[i + 1] == 0x03)) {
+			id_ok = true;
+		}
+	}
+	const bool ok = id_ok || (uint8_t)(fw[0] + fw[1]) == 0xff;
+
+	if (n != 0) {
+		printf("LIUQIN TOUCH: bitbang %u: cs gpio%u clk gpio%u mosi gpio%u miso gpio%u -> "
+		    "%02x %02x %02x %02x %02x %02x | page %02x %02x %02x %02x%s\n",
+		    n, tch.pin_cs, tch.pin_clk, tch.pin_mosi, tch.pin_miso,
+		    id[0], id[1], id[2], id[3], id[4], id[5],
+		    old[0], old[1], old[2], old[3], ok ? "  <-- ANSWER" : "");
+	} else {
+		printf("LIUQIN TOUCH: %s: cs gpio%u clk gpio%u mosi gpio%u miso gpio%u -> "
+		    "%02x %02x %02x %02x %02x %02x | page %02x %02x %02x %02x%s\n",
+		    what, tch.pin_cs, tch.pin_clk, tch.pin_mosi, tch.pin_miso,
+		    id[0], id[1], id[2], id[3], id[4], id[5],
+		    old[0], old[1], old[2], old[3], ok ? "  <-- ANSWER" : "");
+	}
+	return ok ? 0 : -1;
+}
+
+/* Configure the four pads for one role assignment (CS left deasserted). */
+static void
+tch_roles(uint32_t cs, uint32_t clk, uint32_t mosi, uint32_t miso)
+{
+	tch.pin_cs = cs;
+	tch.pin_clk = clk;
+	tch.pin_mosi = mosi;
+	tch.pin_miso = miso;
+	tch_bb_dir(tch.pin_cs, true, tch.cs_high ? 0 : 1);
+	tch_bb_dir(tch.pin_clk, true, 0);
+	tch_bb_dir(tch.pin_mosi, true, 0);
+	tch_bb_dir(tch.pin_miso, false, 0);
+}
+
+/* Every pad can be the chip select, the other three take the six
+ * clk/mosi/miso orders. */
+static int
+tch_sweep(bool cs_high, unsigned *combos)
+{
+	static const uint32_t pads[4] = { 16, 17, 18, 19 };
+	static const uint8_t perm[6][3] = {
+		{ 0, 1, 2 }, { 0, 2, 1 }, { 1, 0, 2 },
+		{ 1, 2, 0 }, { 2, 0, 1 }, { 2, 1, 0 },
+	};
+
+	tch.cs_high = cs_high;
+	if (cs_high) {
+		printf("LIUQIN TOUCH: sweeping again with chip select active high\n");
+	}
+	for (unsigned cs = 0; cs < 4; cs++) {
+		uint32_t data[3];
+		unsigned n = 0;
+
+		for (unsigned i = 0; i < 4; i++) {
+			if (i != cs) {
+				data[n++] = pads[i];
+			}
+		}
+		for (unsigned p = 0; p < 6; p++) {
+			tch_roles(pads[cs], data[perm[p][0]], data[perm[p][1]], data[perm[p][2]]);
+			(*combos)++;
+			/* The vendor driver resets the part into its bootloader
+			 * before the first read; on the wrong pins that write goes
+			 * nowhere, so do it again for every assignment. */
+			tch_nvt_bringup();
+			if (tch_probe_roles("bitbang", *combos) == 0) {
+				return 0;
+			}
+		}
+	}
+	return -1;
+}
+
+/* The vendor memory map puts the event buffer at 0x11a00 for this family
+ * (mainline nt36xxx: evtbuf 0x11a00, pipe0 0x10000, pipe1 0x12000,
+ * flash_csum 0x14000, flash_data 0x14002).  The state register is 0x60 in that
+ * page and reads 0xa0..0xaf when the firmware is running; FWINFO is 0x78.
+ * Read both that base and the old nabu one so the log shows which answers. */
+static void
+tch_dump_chip_state(void)
+{
+	static const uint32_t bases[] = { 0x11a00, 0x2fe00 };
+
+	for (unsigned i = 0; i < 2; i++) {
+		uint8_t st[4] = { 0 };
+		uint8_t fw[17] = { 0 };
+
+		(void)tch_nvt_read(bases[i] + 0x60, st, sizeof(st));
+		(void)tch_nvt_read(bases[i] + 0x78, fw, sizeof(fw));
+		printf("LIUQIN TOUCH: @0x%05x state %02x %02x %02x %02x | fw %02x %02x %02x %02x %02x "
+		    "%02x %02x %02x %02x (ver %02x/~%02x %s)\n",
+		    bases[i], st[0], st[1], st[2], st[3],
+		    fw[0], fw[1], fw[2], fw[3], fw[4], fw[5], fw[6], fw[7], fw[8],
+		    fw[1], fw[2],
+		    (uint8_t)(fw[1] + fw[2]) == 0xff ? "valid" : "unusable");
+	}
+}
+
+/* The firmware area (ADT memory map LIUQINFW, built by tools/mkfwarea.py from
+ * ~/liuqin-root/fw) carries novatek_nt36532_m81_fw_csot.bin now, the same
+ * 245760 bytes the vendor driver downloads after every handover. */
+#include "pong_touch_fw.h"
+static const void *liuqin_fw_get(const char *name, uint32_t *size) { (void)name; if (size) *size = pong_touch_fw_size; return pong_touch_fw_data; }
+
+static const uint8_t *
+tch_fw_image(uint32_t *size)
+{
+	const uint8_t *fw = liuqin_fw_get("novatek_nt36532_m81_fw_csot.bin", size);
+
+	if (fw == NULL) {
+		printf("LIUQIN TOUCH: touch firmware missing from the firmware area\n");
+		return NULL;
+	}
+	printf("LIUQIN TOUCH: touch firmware %u bytes at %p (%02x %02x %02x %02x %02x %02x)\n",
+	    *size, fw, fw[0], fw[1], fw[2], fw[3], fw[4], fw[5]);
+	return fw;
+}
+
+/* Firmware download, transcribed from the official Google novatek_touch module
+ * (nt36xxx_fw_update.c / nt36xxx_mem_map.h, kept in refs/novatek):
+ *
+ *   BOOT_RDY_ADDR = 0x1f141, POR_CD_ADDR = 0x1f61c, EVENT_BUF_ADDR = 0x11a00,
+ *   NVT_TRANSFER_LEN = 0xfc00, container = 12-byte ILM/DLM records from 0 and
+ *   16-byte info records from 0x30 (cascade uses end/2 for the info count).
+ */
+/* Cascade part: NT36523-family map.  The 0x1f1xx/0x1f6xx addresses belong to
+ * NT36525/NT36772 and never woke this chip. */
+/*
+ * The NT36532 has its own map.  Everything in the 0x3Fxxx block that the
+ * NT36523 family uses (and that this driver used until touch41) does not exist
+ * here: the part answers 0xff for those addresses, which is exactly what the
+ * descriptor read-back showed.  These values come from the vendor module
+ * itself (TWRP device tree, nt36532_touch.ko, NT36532_cascade_memory_map) and
+ * were checked against the offsets the module's own code reads:
+ *   boot_ready reads map+132/+136, tx_auto_copy +140, check_spi_dma_tx_info
+ *   +144, the descriptor writer +164/+152/+172 and +168/+156/+176, and the crc
+ *   reader +192 and +172/+176/+180/+184.
+ */
+#define NVT_BOOT_RDY_ADDR       0x1fb50du      /* map+132 */
+#define NVT_TX_AUTO_COPY_EN     0x1fc925u      /* map+140 */
+#define NVT_TX_AUTO_COPY_VAL    0x56u           /* hw_crc == 2 in the vendor module */
+#define NVT_SPI_DMA_TX_INFO     0x1fc914u      /* map+144 */
+#define NVT_SW_RESET_ADDR       0x1fb43eu      /* swrst_sif, vendor dmesg */
+/* crc_err_flag_addr=0x1fb535 in the vendor's own dmesg (NT36523's 0x3f135
+ * shifted by 0x1c4400, like every other address on this part).  When it is
+ * set the part reboots into a loop that answers 0xfc at the trim address and
+ * fills the report area with 0xfd; only 0xa5 written here stops it. */
+#define NVT_CRC_ERR_FLAG        0x1fb535u
+/* EVENT_MAP_HANDSHAKING_or_SUB_CMD_BYTE: event buffer + 0x51.  The vendor's
+ * probe clears it once (nvt_clear_fw_status) right after nvt_get_fw_info();
+ * a part that never sees the clear drops into its recovery loop a fixed ~18 s
+ * after boot, which is exactly when this driver's log turns to 0xfd. */
+#define NVT_FW_STATUS_BYTE      (NVT_EVENT_BASE + 0x51u)
+#define NVT_EVENT_BASE          0x125800u      /* map[0] */
+#define NVT_EVENT_RESET_STATE   (NVT_EVENT_BASE + 0x60u)
+#define NVT_EVENT_HOST_CMD      (NVT_EVENT_BASE + 0xd0u)
+#define NVT_BLD_ILM_DES         0x1fb528u      /* map+164 */
+#define NVT_BLD_DLM_DES         0x1fb52cu      /* map+168 */
+#define NVT_BLD_ILM_LEN         0x1fb518u      /* map+152 */
+#define NVT_BLD_DLM_LEN         0x1fb530u      /* map+156 */
+#define NVT_BLD_ILM_GCRC        0x1fb500u      /* map+172 */
+#define NVT_BLD_DLM_GCRC        0x1fb504u      /* map+176 */
+#define NVT_BLD_ILM_RCRC        0x1fb520u      /* map+180 */
+#define NVT_BLD_DLM_RCRC        0x1fb524u      /* map+184 */
+#define NVT_BLD_CRC_FLAGS       0x1fb533u      /* map+192: done | ilm | dlm */
+#define NVT_FW_CHUNK            0xfc00u
+
+static uint32_t
+tch_le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+	    ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+/* The BLD descriptor and length registers are three bytes wide, the checksum
+ * registers four. */
+static uint32_t
+tch_fw_read24(uint32_t addr)
+{
+	uint8_t b[3] = { 0 };
+
+	(void)tch_nvt_read(addr, b, sizeof(b));
+	return (uint32_t)b[0] | ((uint32_t)b[1] << 8) | ((uint32_t)b[2] << 16);
+}
+
+static uint32_t
+tch_fw_read32(uint32_t addr)
+{
+	uint8_t b[4] = { 0 };
+
+	(void)tch_nvt_read(addr, b, sizeof(b));
+	return tch_le32(b);
+}
+
+/* Milliseconds since an absolutetime stamp: on arm64 the timebase is not
+ * nanoseconds, so convert instead of dividing. */
+static uint32_t
+tch_ms_since(uint64_t t0)
+{
+	uint64_t ns = 0;
+
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	return (uint32_t)(ns / 1000000ull);
+}
+
+/* One section: chunks of NVT_FW_CHUNK, each a page write followed by a single
+ * chip-select window holding [sram | 0x80] and the payload. */
+static int
+tch_fw_chunk_write_locked(const uint8_t *data, uint32_t addr, uint32_t len)
+{
+	uint8_t page[3], hdr[1];
+	int err;
+
+	page[0] = 0xff;
+	page[1] = (uint8_t)((addr >> 15) & 0xff);
+	page[2] = (uint8_t)((addr >> 7) & 0xff);
+	if (tch_cs(true) != 0) {
+		return -1;
+	}
+	err = tch_xfer(page, NULL, sizeof(page));
+	if (tch_cs(false) != 0) {
+		err = -1;
+	}
+	if (err != 0) {
+		return -1;
+	}
+	if (tch_page_dly != 0) {
+		delay(tch_page_dly);
+	}
+	/*
+	 * The address phase is a write, and every Novatek write carries
+	 * bit 7: the vendor's CTP_SPI_WRITE() runs SPI_WRITE_MASK() on
+	 * buf[0], and it is used for the bulk SRAM payload exactly like
+	 * nvt_write_addr() uses it for one byte.  Without the bit the
+	 * part takes each chunk for a read, the SRAM keeps its previous
+	 * contents and the whole download "succeeds" while nothing lands.
+	 */
+	hdr[0] = (uint8_t)((addr & 0x7f) | 0x80);
+	if (tch_cs(true) != 0) {
+		return -1;
+	}
+	err = tch_xfer(hdr, NULL, 1);
+	/*
+	 * A chip-select window feeds the payload in pieces.  The pads take 256
+	 * bytes per call and no more; the engine's staging page holds
+	 * TCH_DMA_MAX (16128) per command, and touch167 showed that every extra
+	 * command is another chance to hit what made the download fail - 252
+	 * commands per 63 KiB chunk become four.
+	 */
+	for (uint32_t sent = 0; err == 0 && sent < len; ) {
+		const uint32_t piece = (tch.bitbang || tch.fifo_capable) ?
+		    256u : TCH_DMA_MAX;
+		uint32_t n = len - sent;
+
+		if (n > piece) {
+			n = piece;
+		}
+		err = tch_xfer(data + sent, NULL, n);
+		sent += n;
+	}
+	if (tch_cs(false) != 0) {
+		err = -1;
+	}
+	return err;
+}
+
+/*
+ * Write a section in chunks, checking each chunk before the next one goes out.
+ * The bit-banged bus drops a bit every few thousand bytes, and without this the
+ * only symptom was a wrong checksum two minutes later - with no way to tell
+ * which part of the image was corrupt.  A 16-byte read-back costs milliseconds
+ * and a wrong chunk is simply written again.
+ */
+static int
+tch_fw_write_sram_locked(const uint8_t *img, uint32_t sram, uint32_t size, uint32_t off)
+{
+	for (uint32_t done = 0; done < size; done += NVT_FW_CHUNK) {
+		const uint32_t addr = sram + done;
+		uint32_t len = size - done;
+		uint32_t check;
+		int err = -1;
+
+		if (len > NVT_FW_CHUNK) {
+			len = NVT_FW_CHUNK;
+		}
+		check = len >= 16 ? 16 : len;
+		for (int attempt = 1; attempt <= 2; attempt++) {
+			uint8_t back[16] = { 0 };
+
+			err = tch_fw_chunk_write_locked(img + off + done, addr, len);
+			if (err != 0) {
+				printf("LIUQIN TOUCH: fw chunk @0x%05x write failed "
+				    "(try %d, last dma cmd %u len %u irq 0x%08x)\n",
+				    addr, attempt, tch_dma_last_cmd,
+				    tch_dma_last_len, tch_dma_last_irq);
+				continue;
+			}
+			(void)tch_nvt_read_locked(addr, back, check);
+			if (memcmp(back, img + off + done, check) == 0) {
+				err = 0;
+				break;
+			}
+			/* The copy engine moves the chunk asynchronously: give it a
+			 * moment and look again before calling the chunk corrupt. */
+			delay(2 * 1000);
+			(void)tch_nvt_read_locked(addr, back, check);
+			if (memcmp(back, img + off + done, check) == 0) {
+				err = 0;
+				break;
+			}
+			err = 0;                /* rewritten below, the CRC has the last word */
+			printf("LIUQIN TOUCH: fw chunk @0x%05x read back %02x %02x %02x %02x, "
+			    "file %02x %02x %02x %02x (try %d)\n", addr,
+			    back[0], back[1], back[2], back[3],
+			    img[off + done], img[off + done + 1],
+			    img[off + done + 2], img[off + done + 3], attempt);
+		}
+		if (err != 0) {
+			return -1;
+		}
+	}
+	return 0;
+}
+
+static int
+tch_fw_write_sram(const uint8_t *img, uint32_t sram, uint32_t size, uint32_t off)
+{
+	int err;
+
+	if (!tch_spi_acquire()) {
+		return -1;
+	}
+	err = tch_fw_write_sram_locked(img, sram, size, off);
+	tch_spi_release();
+	return err;
+}
+
+/* Register write in the bootloader: page command then [reg | 0x80, data...],
+ * each as its own chip-select transaction (nvt_set_bld_crc_bank and friends). */
+static void
+tch_fw_reg_write_locked(uint32_t page_addr, uint32_t reg_addr, const uint8_t *data, size_t len)
+{
+	uint8_t page[3];
+	/* register byte plus up to 6 data bytes (the cascade reset-status clear
+	 * is a seven-byte write); the fortified memcpy panics on a five-byte
+	 * buffer, which is exactly what touch40 did. */
+	uint8_t buf[8];
+
+	page[0] = 0xff;
+	page[1] = (uint8_t)((page_addr >> 15) & 0xff);
+	page[2] = (uint8_t)((page_addr >> 7) & 0xff);
+	buf[0] = (uint8_t)((reg_addr & 0x7f) | 0x80);
+	memcpy(buf + 1, data, len);
+	if (tch_cs(true) != 0) {
+		return;
+	}
+	(void)tch_xfer(page, NULL, sizeof(page));
+	if (tch_cs(false) != 0) {
+		return;
+	}
+	if (tch_cs(true) != 0) {
+		return;
+	}
+	(void)tch_xfer(buf, NULL, len + 1);
+	(void)tch_cs(false);
+}
+
+static void
+tch_fw_reg_write(uint32_t page_addr, uint32_t reg_addr, const uint8_t *data, size_t len)
+{
+	if (!tch_spi_acquire()) {
+		return;
+	}
+	tch_fw_reg_write_locked(page_addr, reg_addr, data, len);
+	tch_spi_release();
+}
+
+/* ILM/DLM descriptors the cascade auto-copy engine needs before it will move
+ * the image: destination, length and golden checksum per section. */
+static void
+tch_fw_bld_bank(uint32_t des_addr, uint32_t sram, uint32_t len_addr,
+    uint32_t size, uint32_t cksum_addr, uint32_t crc)
+{
+	uint8_t v[4];
+
+	v[0] = (uint8_t)(sram & 0xff);
+	v[1] = (uint8_t)((sram >> 8) & 0xff);
+	v[2] = (uint8_t)((sram >> 16) & 0xff);
+	tch_fw_reg_write(des_addr, des_addr, v, 3);
+
+	v[0] = (uint8_t)(size & 0xff);
+	v[1] = (uint8_t)((size >> 8) & 0xff);
+	v[2] = (uint8_t)((size >> 16) & 0x01);
+	tch_fw_reg_write(des_addr, len_addr, v, 3);
+
+	v[0] = (uint8_t)(crc & 0xff);
+	v[1] = (uint8_t)((crc >> 8) & 0xff);
+	v[2] = (uint8_t)((crc >> 16) & 0xff);
+	v[3] = (uint8_t)((crc >> 24) & 0xff);
+	tch_fw_reg_write(des_addr, cksum_addr, v, 4);
+}
+
+static bool
+tch_fw_state_ready(void)
+{
+	uint8_t a = 0;
+
+	(void)tch_nvt_read(NVT_EVENT_RESET_STATE, &a, 1);
+	return a >= 0xa0 && a <= 0xaf;
+}
+
+/* The decisive "did the data land" read from nvt_read_bld_hw_crc(): the
+ * bootloader's CRC flags and the checksums it computed over ILM and DLM,
+ * against the golden values the container carries at 0x18 and 0x1c. */
+struct tch_fw_crc {
+	uint8_t  flags;                 /* bit2 done, bit0 ilm, bit1 dlm */
+	uint32_t ilm;
+	uint32_t dlm;
+};
+static struct tch_fw_crc tch_fw_crc;
+
+/* Set by the download: false when the checksums say the image is corrupt. */
+static bool tch_fw_crc_ok = true;
+
+/* Bit-bang pacing delay of the download in microseconds.  liuqintouchdlpace
+ * overrides it; a wrong checksum doubles it for the next attempt. */
+static uint32_t tch_dl_pace = 4;
+static unsigned tch_dl_retry;           /* rewrites after a failed read-back */
+
+static void
+tch_fw_read_crc(void)
+{
+	uint8_t f[2] = { 0 };
+
+	(void)tch_nvt_read(NVT_BLD_CRC_FLAGS, f, sizeof(f));
+	tch_fw_crc.flags = f[0];
+	tch_fw_crc.ilm = tch_fw_read32(NVT_BLD_ILM_RCRC);
+	tch_fw_crc.dlm = tch_fw_read32(NVT_BLD_DLM_RCRC);
+}
+
+/*
+ * nvt_stop_crc_reboot(): the part latches "CRC error" and then reboots into a
+ * loop that answers 0xfc at the trim address and fills the report area with
+ * 0xfd.  The vendor's escape is two idle commands (0xaa to the swrst address)
+ * followed by 0xa5 written to CRC_ERR_FLAG, verified by reading it back.
+ *
+ * touch170 wrote that 0xa5 to address 0x00000 - the first byte of ILM - and so
+ * never cleared the flag at all.  The flag is read here on every download and
+ * cleared if it is set, which is the only way to tell a stale latch (the part
+ * has been in the loop since some earlier boot) from a fresh failure.
+ */
+static void
+tch_crc_flag(const char *why, bool fix)
+{
+	uint8_t flag = 0, after = 0, id[4] = { 0 };
+	bool in_loop;
+	unsigned tries = 0;
+
+	(void)tch_nvt_read(NVT_CRC_ERR_FLAG, &flag, 1);
+	(void)tch_nvt_read(NVT_CHIP_VER_TRIM_ADDR, id, sizeof(id));
+	in_loop = id[0] == 0xfc ||
+	    (id[0] == 0xff && id[1] == 0xff && id[2] == 0xff);
+	if (!fix) {
+		printf("LIUQIN TOUCH: %s: crc flag 0x%02x, trim %02x %02x %02x %02x%s\n",
+		    why, flag, id[0], id[1], id[2], id[3],
+		    in_loop ? " (in the crc reboot loop)" : "");
+		return;
+	}
+	/*
+	 * The vendor's nvt_stop_crc_reboot(): the part has to be put back into
+	 * idle first (0xaa twice to the swrst address) and the flag cleared with
+	 * 0xa5, then read back to prove it took.  Without the idle commands the
+	 * write is swallowed, which is why touch170's write to 0x00000 - the
+	 * first byte of ILM, not the flag at all - never stopped anything.
+	 */
+	if (flag != 0xa5 || in_loop) {
+		for (tries = 0; tries < 5; tries++) {
+			(void)tch_nvt_write8(NVT_SW_RESET_ADDR, 0xaa);
+			(void)tch_nvt_write8(NVT_SW_RESET_ADDR, 0xaa);
+			delay(1000);
+			(void)tch_nvt_write8(NVT_CRC_ERR_FLAG, 0xa5);
+			(void)tch_nvt_read(NVT_CRC_ERR_FLAG, &after, 1);
+			if (after == 0xa5) {
+				break;
+			}
+		}
+	} else {
+		after = flag;
+	}
+	printf("LIUQIN TOUCH: %s: crc flag 0x%02x -> 0x%02x in %u tries, trim "
+	    "%02x %02x %02x %02x%s\n", why, flag, after, tries, id[0], id[1],
+	    id[2], id[3], in_loop ? " (was in the crc reboot loop)" : "");
+}
+
+/* The handshake byte the vendor clears in nvt_clear_fw_status(). */
+static uint8_t
+tch_fw_status_byte(void)
+{
+	uint8_t v = 0xff;
+
+	(void)tch_nvt_read(NVT_FW_STATUS_BYTE, &v, 1);
+	return v;
+}
+
+static unsigned tch_status_clears;
+/* touch176: driving the controller's INT pin from the host is opt-in. */
+static bool tch_int_poke_ok;
+
+static void
+tch_clear_fw_status(const char *why)
+{
+	uint8_t before = tch_fw_status_byte(), after = before;
+	unsigned i = 0;
+
+	for (i = 0; i < 20; i++) {
+		(void)tch_nvt_write8(NVT_FW_STATUS_BYTE, 0x00);
+		after = tch_fw_status_byte();
+		if (after == 0x00) {
+			break;
+		}
+		delay(10 * 1000);
+	}
+	printf("LIUQIN TOUCH: %s: fw status 0x51 0x%02x -> 0x%02x in %u clears\n",
+	    why, before, after, i + 1);
+}
+
+/* One line, printed right after the copy engine reports done, and repeated in
+ * the verdict: with the console interleaving this session has seen, the values
+ * have to fit on the lines that survive. */
+static void
+tch_fw_crc_line(uint32_t txinfo, unsigned polls, uint32_t ilm_exp, uint32_t dlm_exp)
+{
+	tch_fw_read_crc();
+	printf("LIUQIN TOUCH: fw dl crc pre: txinfo 0x%02x@%u done %u ilm %u dlm %u | "
+	    "ilm exp %08x got %08x | dlm exp %08x got %08x\n",
+	    txinfo, polls, (tch_fw_crc.flags >> 2) & 1u, tch_fw_crc.flags & 1u,
+	    (tch_fw_crc.flags >> 1) & 1u, ilm_exp, tch_fw_crc.ilm,
+	    dlm_exp, tch_fw_crc.dlm);
+}
+
+static int
+tch_fw_download_busy(void)
+{
+	uint32_t size = 0;
+	const uint8_t *fw = liuqin_fw_get("novatek_nt36532_m81_fw_csot.bin", &size);
+	uint32_t end, info_num, ovly_num, parts;
+	uint32_t ilm_sram, ilm_len, ilm_crc, dlm_sram, dlm_len, dlm_crc;
+	uint32_t written = 0, chunks = 0, fw_ilm_bin = 0, fw_dlm_bin = 0;
+	uint32_t saved_pace, txinfo, polls, boot_polls, secs;
+	uint8_t boot_a = 0;
+	bool cascade, spi_dma, have_header = false, ready = false;
+	unsigned sec_done = 0;
+	uint64_t t0;
+
+	if (fw == NULL) {
+		return -1;
+	}
+	end = tch_le32(fw);
+	info_num = (((end / 2) - 0x30) / 0x10) + 1;
+	ovly_num = (fw[0x28] & 0x10) ? (fw[0x28] & 0x0f) : 0;
+	parts = 2 + ovly_num + info_num;
+	cascade = ((fw[0x20] >> 1) & 1) != 0;
+	/*
+	 * nvt_download_firmware_hw_crc() only calls nvt_spi_dma_setup() when the
+	 * image asks for it (fwdata[0x29] bit 0), so the SPI DMA value at
+	 * 0x3f7d0 is not programmed for this firmware.  Logged, so an image that
+	 * does set the bit is obvious instead of silently mis-driven.
+	 */
+	spi_dma = (fw[0x29] & 0x01) != 0;
+	printf("LIUQIN TOUCH: fw dl: size %u end 0x%x cascade %u info %u parts %u spidma %u\n",
+	    size, end, cascade, info_num, parts, spi_dma);
+	/*
+	 * The download takes about a minute on the bit-banged bus and the
+	 * console is muted (liuqinmute), so without these marks the screen says
+	 * nothing while it runs - the touch39 boot was powered off 13 s before
+	 * the verdict for exactly that reason.  Boot marks are drawn even when
+	 * the console is muted, and they carry the decisive CRC values.
+	 */
+	tch_visible_mark("touch fw dl start");
+
+	/* A 245 KiB image at 100 kHz takes minutes; the part is happy at 9.6 MHz,
+	 * so tighten the bit-bang pacing for the transfer and restore it after. */
+	saved_pace = tch.bb_pace_us;
+	/* The bit-banged clock is *this* delay, not liuqintouchdiv (which only
+	 * sets the unused serial-engine divider): the "slow" builds never slowed
+	 * a single bit of the download.  4 us is the first setting that has not
+	 * produced a wrong ILM checksum. */
+	tch.bb_pace_us = tch_dl_pace;
+	if (tch.bitbang) {
+		printf("LIUQIN TOUCH: fw dl bit-bang pace %u us (2 us was the "
+		    "corrupt one)\n", tch_dl_pace);
+	}
+	/* touch168: say which bus the download actually runs on.  touch167's log
+	 * printed "bit-bang pace" while the engine was live, which made a DMA
+	 * failure look like a pads problem. */
+	printf("LIUQIN TOUCH: fw dl path %s\n", tch.bitbang ? "pads (bit-bang)" :
+	    (tch.fifo_capable ? "serial engine, FIFO" : "serial engine, DMA"));
+	t0 = mach_absolute_time();
+
+retry:
+	have_header = false;
+	tch.bb_pace_us = tch_dl_pace;
+	/*
+	 * touch168: start the per-transfer log over at every attempt.  The first
+	 * eight transfers of a download are the ones that failed in touch167, and
+	 * the counter had long passed eight during engine bring-up, so the log
+	 * that mattered was silent exactly where it was needed.
+	 */
+	tch_dma_count = 0;
+	/* touch171: a latched CRC error keeps the part in its reboot loop across
+	 * every download, so clear it (and show the trim answer) before the reset
+	 * that starts this attempt. */
+	tch_crc_flag("before download", true);
+	/* nvt_bootloader_reset(): 0x69 to the software-reset register (0x1fb43e on
+	 * this part, the vendor's swrst_sif address) - 0x00000, which the
+	 * NT36523-family flow uses, is not it. */
+	(void)tch_nvt_write8(NVT_SW_RESET_ADDR, 0x69);
+	delay(35 * 1000);
+
+	/* nvt_set_bld_hw_crc(): the auto-copy engine needs destination, length and
+	 * golden checksum for ILM (part 0) and DLM (part 1). */
+	ilm_sram = tch_le32(fw + 4);
+	ilm_len = tch_le32(fw + 8);
+	ilm_crc = tch_le32(fw + 0x18);
+	dlm_sram = tch_le32(fw + 16);
+	dlm_len = tch_le32(fw + 20);
+	dlm_crc = tch_le32(fw + 0x1c);
+	fw_ilm_bin = tch_le32(fw + 0);
+	fw_dlm_bin = tch_le32(fw + 12);
+	tch_fw_bld_bank(NVT_BLD_ILM_DES, ilm_sram, NVT_BLD_ILM_LEN, ilm_len,
+	    NVT_BLD_ILM_GCRC, ilm_crc);
+	tch_fw_bld_bank(NVT_BLD_DLM_DES, dlm_sram, NVT_BLD_DLM_LEN, dlm_len,
+	    NVT_BLD_DLM_GCRC, dlm_crc);
+	/* nvt_tx_auto_copy_mode(): after the descriptors, like the vendor module.
+	 * hw_crc == 2 on this part writes 0x56, not the 0x69 of the hw_crc == 1
+	 * parts. */
+	(void)tch_nvt_write8(NVT_TX_AUTO_COPY_EN, NVT_TX_AUTO_COPY_VAL);
+	/* The descriptor registers read back, so a broken register write path
+	 * shows up before the two-minute transfer instead of after it. */
+	printf("LIUQIN TOUCH: fw dl bld: ilm des 0x%06x len 0x%06x | dlm des 0x%06x len 0x%06x\n",
+	    tch_fw_read24(NVT_BLD_ILM_DES), tch_fw_read24(NVT_BLD_ILM_LEN),
+	    tch_fw_read24(NVT_BLD_DLM_DES), tch_fw_read24(NVT_BLD_DLM_LEN));
+
+	for (uint32_t i = 0; i < parts; i++) {
+		uint32_t bin, sram, len, nchunks;
+		uint64_t p0;
+
+		if (i < 2) {
+			bin = tch_le32(fw + i * 12);
+			sram = tch_le32(fw + 4 + i * 12);
+			len = tch_le32(fw + 8 + i * 12);
+		} else {
+			uint32_t pos = 0x30 + 0x10 * (i - 2);
+
+			/*
+			 * nvt_bin_header_parser(): on a cascade image the last
+			 * info record lives at end - 0x10 once the header record
+			 * (source offset below the header size) has been seen.
+			 * Reading 0x30 + 0x10 * n there gives a pseudo record
+			 * (src 0x200, len 0), so the real one - the second half
+			 * of the header, src 0x100 to SRAM 0x114208 - was never
+			 * written.
+			 */
+			if (have_header && cascade) {
+				pos = end - 0x10;
+			}
+			sram = tch_le32(fw + pos);
+			len = tch_le32(fw + pos + 4);
+			bin = tch_le32(fw + pos + 8);
+			if (bin < end && len != 0) {
+				have_header = true;
+			}
+		}
+		if (len == 0) {
+			continue;
+		}
+		if (bin + len + 1 > size) {
+			printf("LIUQIN TOUCH: fw dl part %u out of range (bin 0x%x len 0x%x)\n",
+			    i, bin, len);
+			tch.bb_pace_us = saved_pace;
+			tch_visible_mark("touch fw FAIL");
+			return -1;
+		}
+		nchunks = (len + 1 + NVT_FW_CHUNK - 1) / NVT_FW_CHUNK;
+		p0 = mach_absolute_time();
+		if (tch_fw_write_sram(fw, sram, len + 1, bin) != 0) {
+			printf("LIUQIN TOUCH: fw dl part %u @0x%05x write failed after %u chunks\n",
+			    i, sram, chunks);
+			tch.bb_pace_us = saved_pace;
+			tch_visible_mark("touch fw FAIL");
+			return -1;
+		}
+		written += len + 1;
+		chunks += nchunks;
+		printf("LIUQIN TOUCH: fw dl part %u @0x%05x len 0x%x bin 0x%x: %u chunk %u ms\n",
+		    i, sram, len + 1, bin, nchunks, tch_ms_since(p0));
+		{
+			char mark[24];
+
+			snprintf(mark, sizeof(mark), "touch fw sec %u",
+			    ++sec_done);
+			tch_visible_mark(mark);
+		}
+		if (i == 0) {
+			uint8_t back[8] = { 0 };
+
+			/* Straight SRAM read-back: the cheapest proof that the
+			 * payload reached the part, independent of the CRC
+			 * engine's idea of "done". */
+			(void)tch_nvt_read(ilm_sram, back, sizeof(back));
+			printf("LIUQIN TOUCH: fw dl readback @0x%05x: "
+			    "%02x %02x %02x %02x %02x %02x %02x %02x | file %02x %02x %02x %02x\n",
+			    ilm_sram, back[0], back[1], back[2], back[3],
+			    back[4], back[5], back[6], back[7],
+			    fw[bin], fw[bin + 1], fw[bin + 2], fw[bin + 3]);
+		} else if (i == 1) {
+			uint8_t back[16] = { 0 };
+
+			/* The DLM carries the panel parameters and is the block whose
+			 * checksum keeps coming back wrong: this read-back tells a bus
+			 * that dropped bytes from a CRC that disagrees with the image. */
+			(void)tch_nvt_read(dlm_sram, back, sizeof(back));
+			printf("LIUQIN TOUCH: fw dl dlm readback @0x%05x: "
+			    "%02x %02x %02x %02x %02x %02x %02x %02x | file %02x %02x %02x %02x %02x %02x %02x %02x\n",
+			    dlm_sram, back[0], back[1], back[2], back[3], back[4], back[5],
+			    back[6], back[7], fw[bin], fw[bin + 1], fw[bin + 2], fw[bin + 3],
+			    fw[bin + 4], fw[bin + 5], fw[bin + 6], fw[bin + 7]);
+		}
+	}
+
+	/* nvt_check_spi_dma_tx_info(): 200 tries, 1 ms apart, 0x00 means the
+	 * copy engine has moved the image into ILM and DLM. */
+	txinfo = 0xff;
+	for (polls = 0; polls < 200; polls++) {
+		uint8_t info[2] = { 0 };
+
+		(void)tch_nvt_read(NVT_SPI_DMA_TX_INFO, info, sizeof(info));
+		txinfo = info[0];
+		if (txinfo == 0x00) {
+			break;
+		}
+		delay(1000);
+	}
+	/*
+	 * Full read-back of both sections: the BLD CRC registers report the last
+	 * section written, so they cannot prove the image, and with the bit-bang
+	 * at its current speed this costs a couple of seconds.  Logged, not acted
+	 * on - a rewrite here would race the copy engine.
+	 */
+	{
+		uint32_t bad = 0, first = 0;
+		uint8_t blk[256];
+
+		printf("LIUQIN TOUCH: fw verify: reading the image back\n");
+		for (uint32_t off = 0; off < ilm_len; off += 0x1000) {
+			uint32_t n = ilm_len - off;
+
+			if (n > 128) {
+				n = 128;
+			}
+			if (tch_nvt_read(ilm_sram + off, blk, n) != 0) {
+				bad++;
+				if (!first) {
+					first = off;
+				}
+				continue;
+			}
+			for (uint32_t k = 0; k < n; k++) {
+				if (blk[k] != fw[fw_ilm_bin + off + k]) {
+					if (bad++ == 0) {
+						first = off + k;
+					}
+				}
+			}
+		}
+		for (uint32_t off = 0; off < dlm_len; off += 0x1000) {
+			uint32_t n = dlm_len - off;
+
+			if (n > 128) {
+				n = 128;
+			}
+			if (tch_nvt_read(dlm_sram + off, blk, n) != 0) {
+				bad++;
+				if (!first) {
+					first = 0x100000u + off;
+				}
+				continue;
+			}
+			for (uint32_t k = 0; k < n; k++) {
+				if (blk[k] != fw[fw_dlm_bin + off + k]) {
+					if (bad++ == 0) {
+						first = 0x100000u + off + k;
+					}
+				}
+			}
+		}
+		if (bad && tch_dl_retry < 3) {
+			tch_dl_retry++;
+			tch_dl_pace = tch_dl_pace < 32 ? tch_dl_pace * 2 : 32;
+			printf("LIUQIN TOUCH: fw verify: %u of %u bytes differ (first at SRAM "
+			    "0x%05x), rewriting at %u us\n", bad, ilm_len + dlm_len, first,
+			    tch_dl_pace);
+			tch_dma_count = 0;
+			goto retry;
+		}
+		if (bad) {
+			printf("LIUQIN TOUCH: fw verify: %u of %u bytes differ, first at SRAM "
+			    "0x%05x (giving up after %u rewrites)\n", bad, ilm_len + dlm_len,
+			    first, tch_dl_retry);
+			tch_visible_mark("touch fw verify BAD");
+		} else {
+			printf("LIUQIN TOUCH: fw verify: image identical to the file (%u bytes)\n",
+			    ilm_len + dlm_len);
+			tch_visible_mark("touch fw verify ok");
+		}
+	}
+
+	tch_fw_crc_line(txinfo, polls, ilm_crc, dlm_crc);
+	/* The bit-banged bus is marginal: when a transfer comes back with a wrong
+	 * checksum the data is corrupt, and retrying at the same clock just fails
+	 * again.  Remember it so the bring-up ladder can slow the bus down. */
+	{
+		uint8_t f = 0;
+
+		(void)tch_nvt_read(NVT_BLD_CRC_FLAGS, &f, 1);
+		tch_fw_crc_ok = (f & 0x04) != 0 && (f & 0x03) == 0x03;
+	}
+	{
+		char mark[40];
+
+		snprintf(mark, sizeof(mark), "touch fw crc done %u ilm %u dlm %u",
+		    (tch_fw_crc.flags >> 2) & 1u, tch_fw_crc.flags & 1u,
+		    (tch_fw_crc.flags >> 1) & 1u);
+		tch_visible_mark(mark);
+	}
+
+	/*
+	 * No nvt_bld_crc_enable() here: the vendor's own NT36532 download path
+	 * never writes a BLD CRC enable register (its nvt_update_firmware only
+	 * touches the descriptor, length, checksum and flag registers), and the
+	 * NT36523 family's 0x3f30e is not implemented on this part.
+	 */
+	/*
+	 * nvt_fw_crc_enable(): clear the reset status, then send the host
+	 * command that enables the firmware CRC.  The cascade parts use 7- and
+	 * 3-byte writes (the reset status is a six-byte record); the older ones
+	 * 2 and 2.
+	 */
+	{
+		static const uint8_t clr[6] = { 0 };
+		static const uint8_t crc_cmd[2] = { 0xae, 0x00 };
+		static const uint8_t clr1[1] = { 0 };
+		static const uint8_t crc_cmd1[1] = { 0xae };
+
+		if (cascade) {
+			tch_fw_reg_write(NVT_EVENT_BASE, NVT_EVENT_RESET_STATE,
+			    clr, sizeof(clr));
+			tch_fw_reg_write(NVT_EVENT_BASE, NVT_EVENT_HOST_CMD,
+			    crc_cmd, sizeof(crc_cmd));
+		} else {
+			tch_fw_reg_write(NVT_EVENT_BASE, NVT_EVENT_RESET_STATE,
+			    clr1, sizeof(clr1));
+			tch_fw_reg_write(NVT_EVENT_BASE, NVT_EVENT_HOST_CMD,
+			    crc_cmd1, sizeof(crc_cmd1));
+		}
+	}
+	/*
+	 * nvt_boot_ready(): a part with hardware CRC (this family reports
+	 * hw_crc = 2) only has the bit set and left set; clearing it and
+	 * writing POR_CD = 0xA0 is the non-CRC path.  We cleared it, which
+	 * cancels the boot request we just made.
+	 */
+	(void)tch_nvt_write8(NVT_BOOT_RDY_ADDR, 1);
+	delay(5 * 1000);
+
+	/* nvt_check_fw_reset_state(RESET_STATE_INIT): 0xa0..0xaf at
+	 * EVENT_BUF_ADDR | 0x60, which on this part is 0x125860. */
+	for (boot_polls = 0; boot_polls < 20; boot_polls++) {
+		uint8_t a[2] = { 0 };
+
+		(void)tch_nvt_read(NVT_EVENT_RESET_STATE, a, 1);
+		boot_a = a[0];
+		if (boot_a >= 0xa0 && boot_a <= 0xaf) {
+			ready = true;
+			break;
+		}
+		delay(10 * 1000);
+	}
+	secs = tch_ms_since(t0) / 1000;
+	tch.bb_pace_us = saved_pace;
+
+	/*
+	 * The vendor reads the BLD CRC registers only after a failed boot attempt
+	 * (nvt_download_firmware_hw_crc -> fail -> nvt_read_bld_hw_crc): the
+	 * bootloader fills ILM/DLM CRC flags and the R_ checksums when it tries to
+	 * start, so a read before boot_ready proves nothing.  Read them again here.
+	 */
+	tch_fw_read_crc();
+	/* What a fresh boot leaves behind: 0xa3 normal run and a clear crc flag are
+	 * what the vendor's probe expects before the part starts scanning. */
+	tch_crc_flag(ready ? "after boot" : "boot timed out", false);
+	/* nvt_clear_fw_status() - the vendor's probe does this straight after the
+	 * fw info read and never again; see the address comment above. */
+	if (ready) {
+		tch_clear_fw_status("after boot");
+	}
+
+	/* One verdict line that repeats what matters, because earlier lines can
+	 * be lost to console interleaving; the boot mark carries the answer to
+	 * the screen, where the muted console does not. */
+	tch_visible_mark(ready ? "touch fw BOOTED" : "touch fw did not boot");
+	printf("LIUQIN TOUCH: fw dl %s: %u B %u chunks %u s, txinfo 0x%02x@%u, "
+	    "crc post 0x%02x ilm %08x dlm %08x, state 0x%02x@125860 %u polls\n",
+	    ready ? "BOOTED" : "did not boot", written, chunks, secs, txinfo, polls,
+	    tch_fw_crc.flags, tch_fw_crc.ilm, tch_fw_crc.dlm, boot_a, boot_polls);
+	return ready ? 0 : -1;
+}
+
+/* The download owns the bus for its whole life: a register read from the
+ * report thread every 10 ms would otherwise interleave with the chunk
+ * transfers and corrupt both sides.  tch_fw_active lets that thread skip the
+ * bus while this runs instead of timing out on the lock. */
+static int
+tch_fw_download(void)
+{
+	int err;
+
+	tch_fw_active = 1;
+	err = tch_fw_download_busy();
+	tch_fw_active = 0;
+	return err;
+}
+
+/* Read the firmware state register (event 0x60) at both candidate bases; the
+ * vendor expects 0xa0..0xaf once the application firmware runs. */
+static void
+tch_fw_state(void)
+{
+	uint8_t a = 0;
+
+	(void)tch_nvt_read(NVT_EVENT_RESET_STATE, &a, 1);
+	printf("LIUQIN TOUCH: fw state 0x%02x @0x125860 (%s)\n",
+	    a, (a >= 0xa0 && a <= 0xaf) ? "running" : "not ready");
+}
+
+static void
+tch_read_id_line(const char *what)
+{
+	uint8_t id[6] = { 0 };
+	uint8_t fw[16] = { 0 };
+
+	(void)tch_nvt_read(NVT_CHIP_VER_TRIM_ADDR, id, sizeof(id));
+	(void)tch_nvt_read(NVT_FWINFO_ADDR, fw, sizeof(fw));
+	printf("LIUQIN TOUCH: id detail  %02x %02x %02x %02x %02x %02x (expect 20 00 00 32 65 03)\n",
+	    id[0], id[1], id[2], id[3], id[4], id[5]);
+	printf("LIUQIN TOUCH: %s: %02x %02x %02x %02x %02x %02x | fw %02x %02x%s\n",
+	    what, id[0], id[1], id[2], id[3], id[4], id[5], fw[0], fw[1],
+	    ((id[3] == 0x65 && id[4] == 0x03) || (uint8_t)(fw[0] + fw[1]) == 0xff) ?
+	    "  <-- ANSWER" : "");
+}
+
+/* On the discovered pins the controller answers, but the bytes are not stable
+ * between boots (83 80 3a 4f bb 9d then 83 81 3a 47 bb 9c) and one direct
+ * attempt read ff - a marginal read rather than a protocol mismatch.  Measure
+ * the knobs one at a time, all on cs17/clk18/mosi19/miso16, 15/7 page split. */
+static void
+tch_diag_matrix(void)
+{
+	tch_roles(19, 18, 17, 16);
+	tch.page8 = false;
+	/*
+	 * The controller needs one dummy byte between the address and the data:
+	 * with dummy = 0 the trim id comes back shifted by one byte
+	 * ("3f 20 00 00 32 65" instead of "20 00 00 32 65 03").
+	 */
+	tch.dummy = 1;
+	tch.bb_pace_us = 5;
+	tch.bb_cpol = 0;
+	tch.bb_cpha = 0;
+	tch_bb_dir(16, false, 0);                       /* MISO, no bias */
+
+	/*
+	 * SPI mode is the one knob never varied, and a wrong sampling edge
+	 * produces exactly what we have seen: plausible but boot-dependent
+	 * bytes.  Walk all four modes at two clock rates.
+	 */
+	for (unsigned slow = 0; slow < 2; slow++) {
+		const unsigned pace = slow ? 25 : 5;
+
+		tch.bb_pace_us = pace;
+		for (unsigned mode = 0; mode < 4; mode++) {
+			char label[64];
+
+			tch.bb_cpol = (mode >> 1) & 1;  /* the usual mode numbering */
+			tch.bb_cpha = mode & 1;
+			bb_set(tch.pin_clk, tch.bb_cpol);
+			tch_nvt_bringup();
+			snprintf(label, sizeof(label), "mode %u at %u us", mode, pace);
+			tch_read_id_line(label);
+		}
+	}
+	tch.bb_pace_us = 5;
+	tch.bb_cpol = 0;
+	tch.bb_cpha = 0;
+	bb_set(tch.pin_clk, 0);
+
+	/* A line the controller drives ignores a pull-up; a floating one reads 1 */
+	tch_wr(tch.tlmm, TLMM_CTL(16), (0u << 2) | (3u << 0) | (2u << 6));
+	delay(2000);
+	tch_nvt_bringup();
+	tch_read_id_line("MISO with pull-up");
+	tch_bb_dir(16, false, 0);
+
+	tch.dummy = 0;
+	tch_nvt_bringup();
+	tch_read_id_line("no dummy byte (shifted)");
+	tch.dummy = 1;
+}
+
+static int
+tch_bitbang_start(void)
+{
+	unsigned combos = 0;
+
+	bb_calibrate();
+	tch.bb_pace_us = 5;                             /* ~100 kHz, very forgiving */
+	(void)PE_parse_boot_argn("liuqintouchpace", &tch.bb_pace_us, sizeof(tch.bb_pace_us));
+	if (tch.bb_pace_us > 1000) {
+		tch.bb_pace_us = 1000;
+	}
+	tch.bitbang = true;
+	tch.cs_manual = true;
+	tch.cs_high = false;
+	tch.dummy = 1;
+	tch.pin_reset = 20;
+
+	/*
+	 * The touch reset is gpio20, which the mainline device tree does not
+	 * mention: the vendor overlay's pmx_ts_reset_suspend pulls it down and
+	 * mi_ts_active releases it.  Try the plausible reset shapes before
+	 * blaming anything else - the normal polarity with a long pulse, the
+	 * inverted one, and a release with the pads muxed to the QUP (in case the
+	 * die latches something at reset).
+	 */
+	tch_roles(19, 18, 17, 16);
+	tch_bb_dir(tch.pin_reset, true, 1);             /* deasserted, no pulse */
+	delay(20 * 1000);
+	printf("LIUQIN TOUCH: probing before any reset (gpio20 high, INT %d)\n", bb_get(21));
+	{
+		/*
+		 * The trim id lives in ROM and answers in both states, so it says
+		 * nothing about whether the application firmware is running.  The
+		 * chip-info page and the event buffer do: both are application
+		 * memory and read ff while the part sits in its bootloader.
+		 */
+		uint8_t ci[8] = { 0 };
+		uint8_t ev[8] = { 0 };
+
+		(void)tch_nvt_read(NVT_FWINFO_ADDR, ci, sizeof(ci));
+		(void)tch_nvt_read(NVT_EVENT_BUF_ADDR, ev, sizeof(ev));
+		printf("LIUQIN TOUCH: before reset: chip info %02x %02x %02x %02x | event %02x %02x %02x %02x\n",
+		    ci[0], ci[1], ci[2], ci[3], ev[0], ev[1], ev[2], ev[3]);
+		printf("LIUQIN TOUCH: application firmware %s\n",
+		    (uint8_t)(ci[0] + ci[1]) == 0xff ? "running" :
+		    (ci[0] != 0x00 && ci[0] != 0xff) ? "running (unexpected info)" :
+		    "not running - controller is in bootloader mode");
+	}
+	for (unsigned mode = 0; mode < 4; mode++) {
+		tch.bb_cpol = (mode >> 1) & 1;
+		tch.bb_cpha = mode & 1;
+		bb_set(tch.pin_clk, tch.bb_cpol);
+		if (tch_probe_roles("live probe", 900 + mode) == 0) {
+			printf("LIUQIN TOUCH: live controller answered in SPI mode %u\n", mode);
+			printf("LIUQIN TOUCH: bit-banged SPI: cs gpio%u clk gpio%u mosi gpio%u miso gpio%u\n",
+			    tch.pin_cs, tch.pin_clk, tch.pin_mosi, tch.pin_miso);
+			return 0;
+		}
+	}
+	tch.bb_cpol = 0;
+	tch.bb_cpha = 0;
+	bb_set(tch.pin_clk, 0);
+
+	tch_bb_dir(tch.pin_reset, true, 0);
+	delay(100 * 1000);
+	tch_bb_dir(tch.pin_reset, true, 1);
+	delay(200 * 1000);
+	printf("LIUQIN TOUCH: gpio20 100 ms low -> high (io 0x%08x), INT %d\n",
+	    tch_rd(tch.tlmm, TLMM_CTL(tch.pin_reset) + TLMM_IN_OUT), bb_get(21));
+	if (tch_probe_roles("reset low->high", 0) == 0) {
+		printf("LIUQIN TOUCH: bit-banged SPI: cs gpio%u clk gpio%u mosi gpio%u miso gpio%u\n",
+		    tch.pin_cs, tch.pin_clk, tch.pin_mosi, tch.pin_miso);
+		return 0;
+	}
+
+	tch_bb_dir(tch.pin_reset, true, 1);
+	delay(100 * 1000);
+	tch_bb_dir(tch.pin_reset, true, 0);
+	delay(200 * 1000);
+	printf("LIUQIN TOUCH: gpio20 100 ms high -> low (io 0x%08x), INT %d\n",
+	    tch_rd(tch.tlmm, TLMM_CTL(tch.pin_reset) + TLMM_IN_OUT), bb_get(21));
+	if (tch_probe_roles("reset high->low", 0) == 0) {
+		printf("LIUQIN TOUCH: bit-banged SPI: cs gpio%u clk gpio%u mosi gpio%u miso gpio%u\n",
+		    tch.pin_cs, tch.pin_clk, tch.pin_mosi, tch.pin_miso);
+		return 0;
+	}
+
+	tch_bb_dir(tch.pin_reset, true, 0);
+	for (uint32_t pin = 16; pin <= 19; pin++) {
+		tch_wr(tch.tlmm, TLMM_CTL(pin), (1u << 2) | (2u << 6));    /* qup4 */
+	}
+	delay(100 * 1000);
+	tch_bb_dir(tch.pin_reset, true, 1);
+	delay(200 * 1000);
+	tch_roles(19, 18, 17, 16);
+	printf("LIUQIN TOUCH: gpio20 released with the pads on qup4, INT %d\n", bb_get(21));
+	if (tch_probe_roles("reset released on qup4", 0) == 0) {
+		printf("LIUQIN TOUCH: bit-banged SPI: cs gpio%u clk gpio%u mosi gpio%u miso gpio%u\n",
+		    tch.pin_cs, tch.pin_clk, tch.pin_mosi, tch.pin_miso);
+		return 0;
+	}
+
+	/*
+	 * touch17's sweep found exactly one assignment that answers:
+	 * cs gpio17, clk gpio18, mosi gpio19, miso gpio16.  Start from it and
+	 * try both page-address splits before falling back to the sweep.
+	 */
+	/*
+	 * Probe before resetting anything.  If the controller is still running
+	 * its RAM firmware (ABL or a preceding TWRP boot loaded it), a reset pulse
+	 * discards it and the part goes silent - so release the reset line only,
+	 * and look for a live chip first.
+	 */
+	tch.page8 = false;
+	tch_nvt_bringup();
+	for (unsigned mode = 0; mode < 2; mode++) {
+		tch.page8 = (mode == 1);
+		printf("LIUQIN TOUCH: reading with the %s page split\n",
+		    tch.page8 ? "addr>>16/>>8" : "addr>>15/>>7");
+		if (tch_probe_roles("discovered pins", 0) == 0) {
+			printf("LIUQIN TOUCH: bit-banged SPI: cs gpio%u clk gpio%u mosi gpio%u miso gpio%u\n",
+			    tch.pin_cs, tch.pin_clk, tch.pin_mosi, tch.pin_miso);
+			return 0;
+		}
+	}
+	tch.page8 = false;
+	tch_bb_selftest();
+	tch_diag_matrix();
+
+	if (tch_sweep(false, &combos) == 0) {
+		return 0;
+	}
+	if (tch_sweep(true, &combos) == 0) {
+		return 0;
+	}
+	printf("LIUQIN TOUCH: none of the %u pad assignments answered with a Novatek id\n", combos);
+
+	/*
+	 * The die may simply be sitting in whatever state the bootloader left it
+	 * in.  gpio16 is the one pad held low by something external, so it is the
+	 * likely MISO; clock on gpio17 and MOSI on gpio18 then, and send the
+	 * vendor bring-up once before giving up.
+	 */
+	tch.cs_high = false;
+	tch_roles(19, 18, 17, 16);
+	printf("LIUQIN TOUCH: trying the vendor bring-up on cs19 clk18 mosi17 miso16\n");
+	tch_nvt_bringup();
+	if (tch_probe_roles("after bring-up", 0) == 0) {
+		printf("LIUQIN TOUCH: controller answered after the bring-up\n");
+		return 0;
+	}
+	printf("LIUQIN TOUCH: controller still silent after the bring-up\n");
+
+	thread_t watcher;
+
+	if (kernel_thread_start(liuqin_touch_int_watch, NULL, &watcher) == KERN_SUCCESS) {
+		thread_deallocate(watcher);
+	}
+	return -1;
+}
+
+/* Novatek write: page, then the address with bit 7 set and the data. */
+static int
+tch_nvt_write8_locked(uint32_t addr, uint8_t val)
+{
+	uint8_t page[3];
+	uint8_t tx[2];
+	int err;
+
+	page[0] = 0xff;
+	if (tch.page8) {
+		page[1] = (uint8_t)((addr >> 16) & 0xff);
+		page[2] = (uint8_t)((addr >> 8) & 0xff);
+	} else {
+		page[1] = (uint8_t)((addr >> 15) & 0xff);
+		page[2] = (uint8_t)((addr >> 7) & 0xff);
+	}
+	tx[0] = (uint8_t)((addr & 0x7f) | 0x80);
+	tx[1] = val;
+	if (tch_cs(true) != 0) {
+		return -1;
+	}
+	err = tch_xfer(page, NULL, sizeof(page));
+	if (tch_cs(false) != 0) {
+		err = -1;
+	}
+	if (err != 0) {
+		return -1;
+	}
+	if (tch_page_dly != 0) {
+		delay(tch_page_dly);
+	}
+
+	if (tch_cs(true) != 0) {
+		return -1;
+	}
+	err = tch_xfer(tx, NULL, sizeof(tx));
+	if (tch_cs(false) != 0) {
+		err = -1;
+	}
+	return err;
+}
+
+static int
+tch_nvt_write8(uint32_t addr, uint8_t val)
+{
+	int err;
+
+	if (!tch_spi_acquire()) {
+		return -1;
+	}
+	err = tch_nvt_write8_locked(addr, val);
+	tch_spi_release();
+	return err;
+}
+
+/* The vendor driver's bring-up, in its order: bootloader reset, software reset
+ * to idle, unlock.  It is what it does before trusting the bus when the id does
+ * not match, and the NT36532 answers it from ROM even when the RAM firmware is
+ * not running. */
+static void
+tch_nvt_bringup(void)
+{
+	(void)tch_nvt_write8(0x00000, 0x69);            /* bootloader reset */
+	delay(18 * 1000);                               /* vendor: 44728 udelay */
+	(void)tch_nvt_write8(0x00000, 0xa5);            /* software reset idle */
+	delay(15 * 1000);
+	(void)tch_nvt_write8(0x00000, 0x35);            /* unlock */
+	delay(10 * 1000);
+}
+
+static const char *
+tch_chip_name(const uint8_t id[6])
+{
+	/* The last three trim-id bytes are the model: 0x23 0x65 0x03 encodes
+	 * "2365" (NT36523), 0x32 0x65 0x03 "3265" (NT36532).  The mapping for
+	 * the 36532 follows the shape of the vendor's trim table, not a table
+	 * entry we have seen, so the raw bytes are logged as well. */
+	if (id[3] == 0x32 && id[4] == 0x65 && id[5] == 0x03) {
+		return "NT36532";
+	}
+	if (id[3] == 0x23 && id[4] == 0x65 && id[5] == 0x03) {
+		return "NT36523";
+	}
+	return NULL;
+}
+
+/* spi_geni_init() + setup_fifo_params(), in the same order as the Linux
+ * driver, then the Novatek trim id. */
+static int
+liuqin_touch_spi_setup(void)
+{
+	/* Capture what the bootloader left behind before touching anything:
+	 * a stale interrupt status or a disabled sequencer shows up here. */
+	tch_dump_state("before init");
+	const uint32_t fwrev = tch_rd(tch.se, GENI_FW_REVISION_RO);
+	const uint32_t proto = (fwrev & FW_REV_PROTOCOL_MSK) >> FW_REV_PROTOCOL_SHFT;
+
+	printf("LIUQIN TOUCH: SE4 GENI protocol %u (%s) fwrev 0x%08x\n", proto,
+	    proto == GENI_SE_SPI ? "SPI" : "not SPI", fwrev);
+	if (proto != GENI_SE_SPI) {
+		return -1;
+	}
+	vm_offset_t wrap = ml_io_map(QUP0_PA, QUP0_SIZE);
+	if (wrap == 0) {
+		printf("LIUQIN TOUCH: QUP wrapper map failed\n");
+		return -1;
+	}
+	const uint32_t hw = tch_rd(wrap, QUP_HW_VER_REG);
+	const uint32_t major = (hw >> 28) & 0xf;
+	const uint32_t minor = (hw >> 16) & 0xfff;
+	const uint32_t param0 = tch_rd(tch.se, SE_HW_PARAM_0);
+	const uint32_t param1 = tch_rd(tch.se, SE_HW_PARAM_1);
+	const uint32_t depth_msk = ((major == 3 && minor >= 10) || major > 3) ?
+	    FIFO_DEPTH_MSK_256 : FIFO_DEPTH_MSK;
+	const uint32_t width = (param0 & TX_FIFO_WIDTH_MSK) >> TX_FIFO_WIDTH_SHFT;
+
+	tch.tx_fifo_depth = (param0 & depth_msk) >> FIFO_DEPTH_SHFT;
+	printf("LIUQIN TOUCH: QUP hw 0x%08x (v%u.%u) TX fifo %u words x %u bit, RX fifo %u words\n",
+	    hw, major, minor, tch.tx_fifo_depth, width,
+	    (param1 & depth_msk) >> FIFO_DEPTH_SHFT);
+	if (width == 0 || tch.tx_fifo_depth < 4) {
+		printf("LIUQIN TOUCH: unusable FIFO geometry, SPI not started\n");
+		return -1;
+	}
+	tch.bytes_per_fifo_word = width / 8;
+	if (tch.bytes_per_fifo_word == 0) {
+		tch.bytes_per_fifo_word = 1;
+	}
+
+	/* geni_se_init(se, tx_fifo_depth - 3, tx_fifo_depth - 2) and
+	 * geni_se_io_init()/geni_se_io_set_mode(). */
+	tch_irq_clear();
+	tch_wr(tch.se, GENI_CGC_CTRL, tch_rd(tch.se, GENI_CGC_CTRL) | DEFAULT_CGC_EN);
+	tch_wr(tch.se, SE_DMA_GENERAL_CFG,
+	    tch_rd(tch.se, SE_DMA_GENERAL_CFG) | DMA_GENERAL_CFG_DEFAULT);
+	tch_wr(tch.se, GENI_OUTPUT_CTRL, DEFAULT_IO_OUTPUT_CTRL_MSK);
+	tch_wr(tch.se, GENI_FORCE_DEFAULT_REG, FORCE_DEFAULT);
+	tch_wr(tch.se, SE_IRQ_EN, tch_rd(tch.se, SE_IRQ_EN) | SE_IRQ_EN_DEFAULT);
+	tch_wr(tch.se, SE_GENI_DMA_MODE_EN,
+	    tch_rd(tch.se, SE_GENI_DMA_MODE_EN) & ~GENI_DMA_MODE_EN);
+	tch_wr(tch.se, SE_GSI_EVENT_EN, 0);
+	tch_wr(tch.se, SE_GENI_RX_WATERMARK_REG, tch.tx_fifo_depth - 3);
+	tch_wr(tch.se, SE_GENI_RX_RFR_WATERMARK_REG, tch.tx_fifo_depth - 2);
+	tch_wr(tch.se, SE_GENI_M_IRQ_EN,
+	    tch_rd(tch.se, SE_GENI_M_IRQ_EN) | M_COMMON_GENI_M_IRQ_EN);
+	tch_wr(tch.se, SE_GENI_S_IRQ_EN,
+	    tch_rd(tch.se, SE_GENI_S_IRQ_EN) | S_COMMON_GENI_S_IRQ_EN);
+
+	/* FIFO mode, and "we always control CS manually". */
+	tch_fifo_mode();
+	tch_wr(tch.se, SE_SPI_TRANS_CFG, tch_rd(tch.se, SE_SPI_TRANS_CFG) & ~CS_TOGGLE);
+
+	/* setup_fifo_params(): 8-bit words, SPI mode 0, chip select 0. */
+	const uint32_t pack_words = (width % 8) ? 1 : width / 8;
+	tch_config_packing(8, pack_words);
+	tch_wr(tch.se, SE_SPI_WORD_LEN, (8 - MIN_WORD_LEN) & WORD_LEN_MSK);
+	/*
+	 * SE_SPI_LOOPBACK: bit 0 is the enable (the engine feeds its own MOSI
+	 * back into MISO), higher bits select the self-test source.  Written as
+	 * a raw value so a run can ask for a bit the driver does not know yet,
+	 * e.g. liuqintouchloopback=3.  A DMA that completes in loopback but not
+	 * against the panel separates "staging page/descriptors" from "SPI
+	 * slave side" (DMA_HANDOFF step 4).  Default 0 = pads, as before.
+	 */
+	{
+		int loopback = 0;
+
+		(void)PE_parse_boot_argn("liuqintouchloopback", &loopback, sizeof(loopback));
+		tch_wr(tch.se, SE_SPI_LOOPBACK, (uint32_t)loopback);
+		if (loopback != 0) {
+			printf("LIUQIN TOUCH: SE SPI loopback 0x%x written to 0x22c "
+			    "(MOSI fed back into MISO)\n", (unsigned)loopback);
+		}
+	}
+	tch_wr(tch.se, SE_SPI_DEMUX_SEL, 0);
+	tch_wr(tch.se, SE_SPI_CPHA, 0);
+	tch_wr(tch.se, SE_SPI_CPOL, 0);
+	tch_wr(tch.se, SE_SPI_DEMUX_OUTPUT_INV, 0);
+
+	/* geni_spi_set_clock_and_bw(): the SE clock is BI_TCXO (19.2 MHz) with
+	 * no prescaler, so SER_M_CLK_CFG's divider is the whole story. */
+	tch_wr(tch.se, SE_GENI_CLK_SEL, 0);
+	tch_wr(tch.se, GENI_SER_M_CLK_CFG, ((tch.div & CLK_DIV_MSK) << CLK_DIV_SHFT) | SER_CLK_EN);
+	tch.spi_hz = SE_CLK_HZ / tch.div;
+	printf("LIUQIN TOUCH: SPI master mode 0, 8-bit words, CS0, %u kHz (19.2 MHz / %u), "
+	    "fifo %u byte/word, trans_cfg 0x%08x slave_en 0x%08x\n",
+	    tch.spi_hz / 1000, tch.div, tch.bytes_per_fifo_word,
+	    tch_rd(tch.se, SE_SPI_TRANS_CFG), tch_rd(tch.se, SE_SPI_SLAVE_EN));
+	tch_visible_mark("touch spi cfg");
+	tch.fifo_capable = (tch_rd(tch.se, GENI_IF_DISABLE_RO) & FIFO_IF_DISABLE) == 0;
+	printf("LIUQIN TOUCH: FIFO interface %s (if_disable 0x%08x)\n",
+	    tch.fifo_capable ? "present" : "disabled", tch_rd(tch.se, GENI_IF_DISABLE_RO));
+	{
+		/* The bit has always read 1 here, but the FIFO path has never
+		 * actually been exercised: force it once and see whether the engine
+		 * moves bytes (liuqintouchfifo=1).  A hardware-timed SPI transfer
+		 * without DMA also means no apps_smmu stream in the way. */
+		int force_fifo = 0;
+
+		(void)PE_parse_boot_argn("liuqintouchfifo", &force_fifo, sizeof(force_fifo));
+		if (force_fifo && !tch.fifo_capable) {
+			printf("LIUQIN TOUCH: liuqintouchfifo=1, using the FIFO engine anyway\n");
+			tch.fifo_capable = true;
+		}
+	}
+	tch_dump_state("after init");
+
+	if (!tch.fifo_capable) {
+		/*
+		 * The FIFO interface has never moved a byte (GENI_IF_DISABLE_RO
+		 * says it is present, but every transfer has been bit-banged),
+		 * and the SE's own DMA froze the machine on the first opcode in
+		 * touch129.  Two suspects have been removed since: the staging
+		 * page is no longer whatever the allocator hands out above 32 GiB
+		 * but a fixed low page (0x85200000), and the SE's apps_smmu
+		 * stream 0x5a3 can now be forced to bypass.  Drive the four pads
+		 * as GPIOs by default; liuqintouchdma=1 enters the retry path.
+		 */
+		int use_dma = 0;
+
+		(void)PE_parse_boot_argn("liuqintouchdma", &use_dma, sizeof(use_dma));
+		if (!use_dma) {
+			printf("LIUQIN TOUCH: SE DMA not usable here, using bit-banged SPI\n");
+			tch_visible_mark("touch bitbang probe");
+			return tch_bitbang_start();
+		}
+		printf("LIUQIN TOUCH: liuqintouchdma=1, trying SE DMA again\n");
+		/* Only reachable when the pads are the only way in, so the engine's
+		 * data path is the thing under test.  The default is what upstream
+		 * spi-geni-qcom does today (M_CMD0 first, descriptor behind it);
+		 * liuqintouchdmaorder=0 selects the older descriptor-first order,
+		 * and the probe walk flips it if the first attempt moves nothing. */
+		{
+			int order = 1;
+
+			(void)PE_parse_boot_argn("liuqintouchdmaorder", &order, sizeof(order));
+			tch_dma_order = (order != 0);
+		}
+		/*
+		 * The AHB master clock first: touch147 hung with the SMMU probe
+		 * entirely skipped (liuqintouchsmmu=0), so the DMA path itself is
+		 * suspect, and a gated wrapper AHB port is exactly a no-panic hang
+		 * that leaves the register interface working.
+		 */
+		tch_qup_dma_clocks();
+		/* The engine-side half of the same question: an SE strapped for DMA
+		 * (GENI_IF_DISABLE_RO = 1) whose DMA interface enable is clear holds
+		 * a data command forever, which is exactly what touch150 logged. */
+		tch_se_dma_if();
+		/*
+		 * Order is the whole point of the 2026-10-27 handoff: report and
+		 * fix the stream the SE will use, and only then map/zero the
+		 * staging page.  touch132 did it the other way round and froze on
+		 * the first DMA opcode with no register read to show for it.
+		 */
+		tch_smmu_fix();
+		if (tch_dma_alloc() != 0) {
+			return -1;
+		}
+		/*
+		 * Only the pad path ever set these: the SE path inherited
+		 * dummy = 0 from the struct, so every read was one byte short and
+		 * one byte early - the framing the pad path needed a dummy byte for.
+		 */
+		tch.dummy = 1;
+		tch.page8 = false;
+		/*
+		 * touch167: the walk is off by default.  It costs about 78 s of
+		 * boot time and every step of it leaves the sequencer and the panel
+		 * somewhere this driver then has to recover from - touch166 found
+		 * the answer (duplex opcode 3) late in the walk, and the very next
+		 * read still came back ff because the state was gone.  The answer
+		 * is baked in now, so a normal boot is: reset the panel, read the
+		 * trim id, done.  liuqintouchdiag=1 brings the walk back.
+		 */
+		{
+			int diag = 0;
+			int opcode = 0;
+
+			(void)PE_parse_boot_argn("liuqintouchdiag", &diag, sizeof(diag));
+			(void)PE_parse_boot_argn("liuqintouchopcode", &opcode, sizeof(opcode));
+			if (opcode == (int)SPI_TX_RX || opcode == (int)SPI_DUPLEX) {
+				tch_opcode = opcode;
+				printf("LIUQIN TOUCH: liuqintouchopcode=%d, duplex opcode %u\n",
+				    opcode, tch_duplex_opcode());
+			}
+			if (diag) {
+				tch_dma_diag();
+				tch_visible_mark("touch bus probe");
+			}
+		}
+		/* A clean engine and a clean panel: this is the read that decides
+		 * the boot.  The engine is left exactly as the DMA commands want it
+		 * (opcode 3, command before descriptor, 600 kHz) and the panel gets
+		 * the same bring-up sequence the pads path has always used. */
+		tch.cs_manual = true;
+		tch_dma_order = 1;
+		tch.div = 32;
+		tch_wr(tch.se, GENI_SER_M_CLK_CFG,
+		    ((32u & CLK_DIV_MSK) << CLK_DIV_SHFT) | SER_CLK_EN);
+		tch_irq_clear();
+		tch_nvt_bringup();
+		for (unsigned try = 1; try <= 3; try++) {
+			uint8_t id[6] = { 0 };
+
+			tch_rx_ok = tch_nvt_read(NVT_CHIP_VER_TRIM_ADDR, id, sizeof(id)) == 0 &&
+			    id[4] == 0x65 && id[5] == 0x03;
+			printf("LIUQIN TOUCH: engine bring-up %u: %02x %02x %02x %02x %02x %02x "
+			    "(%s, opcode %u)\n", try, id[0], id[1], id[2], id[3], id[4],
+			    id[5], tch_rx_ok ? "panel answered" : "no answer",
+			    tch_duplex_opcode());
+			if (tch_rx_ok) {
+				break;
+			}
+			/* One more reset before giving up on the engine: a panel left
+			 * mid-transfer by the bootloader answers nothing until its
+			 * reset line has been pulsed again. */
+			tch_nvt_bringup();
+			delay(20 * 1000);
+		}
+		if (tch_rx_ok) {
+			printf("LIUQIN TOUCH: SE4 receive is live (duplex opcode %u, "
+			    "div %u, %u kHz)\n", tch_duplex_opcode(), tch.div,
+			    (SE_CLK_HZ / tch.div) / 1000);
+			printf("LIUQIN TOUCH: SE4 running, chip select %s\n",
+			    tch.cs_manual ? "by hand" : "driven by the engine");
+			return 0;
+		}
+		{
+			/*
+			 * touch166: no engine-side receive route returns the ROM
+			 * trim id while the pads carry the panel's answer byte for
+			 * byte.  Rather than spend another boot on the receive half,
+			 * run the whole stack on the pads: the trim id, the firmware
+			 * download and the frame reads are all proven there, and the
+			 * upload is the only thing that ever needed the engine's
+			 * speed.  The pads are selected here and stay selected.
+			 */
+			printf("LIUQIN TOUCH: no engine receive route works, running the "
+			    "whole stack on the pads (bit-bang)\n");
+			tch.dma = 0;
+			tch.use_dma = false;
+			tch.fifo_capable = false;
+			tch.bitbang = true;
+			tch.cs_manual = true;
+			tch.cs_high = false;
+			tch.bb_pace_us = 5;
+			tch.bb_cpol = 0;
+			tch.bb_cpha = 0;
+			tch.dummy = 1;
+			tch.page8 = false;
+			tch.pin_cs = 19;
+			tch.pin_clk = 18;
+			tch.pin_mosi = 17;
+			tch.pin_miso = 16;
+			bb_calibrate();
+			for (uint32_t pin = 16; pin <= 19; pin++) {
+				tch_wr(tch.tlmm, TLMM_CTL(pin),
+				    (0u << 2) | (0u << 0) | (2u << 6));
+			}
+			tch_bb_dir(19, true, 1);
+			tch_bb_dir(18, true, 0);
+			tch_bb_dir(17, true, 0);
+			tch_bb_dir(16, false, 0);
+			tch.div = 32;
+			tch_visible_mark("touch pads rise");
+			return 0;
+		}
+	}
+
+	tch_visible_mark("touch bus probe");
+	if (tch_se_start() != 0) {
+		printf("LIUQIN TOUCH: SE4 engine did not start, falling back to bit-bang\n");
+		tch.fifo_capable = false;
+		tch.use_dma = false;
+		return tch_bitbang_start();
+	}
+	printf("LIUQIN TOUCH: SE4 running, chip select %s\n",
+	    tch.cs_manual ? "by hand" : "driven by the engine");
+	return 0;
+}
+
+static void tch_dump_event_page(unsigned n);
+
+/* Returns true when the controller answered with data we can trust (a Novatek
+ * trim id or a self-consistent FWINFO), so garbage never reaches the HID
+ * layer as "touch". */
+static bool
+tch_novatek_info(void)
+{
+	uint8_t id[6] = { 0 };
+	int have_id = tch_nvt_read(NVT_CHIP_VER_TRIM_ADDR, id, sizeof(id)) == 0;
+
+	if (have_id && !(id[4] == 0x65 && id[5] == 0x03)) {
+		uint8_t alt[6] = { 0 };
+
+		if (tch_nvt_read(NVT_CHIP_VER_TRIM_NABU, alt, sizeof(alt)) == 0 &&
+		    alt[4] == 0x65 && alt[5] == 0x03) {
+			memcpy(id, alt, sizeof(id));
+		}
+	}
+	const char *name = have_id ? tch_chip_name(id) : NULL;
+
+	{
+		uint32_t fw_size = 0;
+
+		(void)tch_fw_image(&fw_size);
+		tch_fw_state();
+	}
+	tch_dump_chip_state();
+	printf("LIUQIN TOUCH: Novatek trim id %02x %02x %02x %02x %02x %02x (%s) irq 0x%08x\n",
+	    id[0], id[1], id[2], id[3], id[4], id[5],
+	    have_id ? (name != NULL ? name : "unknown id") : "read failed",
+	    tch.last_irq);
+
+	bool valid = have_id && name != NULL;
+
+	/*
+	 * The application firmware does not survive the handover: ABL and a
+	 * reboot leave the part in its bootloader, which answers register reads
+	 * but never scans.  Download the image from the firmware area unless the
+	 * chip already reports a running firmware.
+	 */
+	if (have_id) {
+		/* The part sometimes stays in its bootloader after the handover
+		 * (state 0xfc); retrying the download is what makes bring-up
+		 * reliable.  Each attempt is logged with the state it reached. */
+		for (int attempt = 1; attempt <= 3; attempt++) {
+			uint8_t st = 0;
+
+			if (tch_fw_state_ready()) {
+				break;
+			}
+			(void)tch_nvt_read(NVT_EVENT_RESET_STATE, &st, 1);
+			printf("LIUQIN TOUCH: bring-up attempt %d, state 0x%02x, spi div %u\n",
+			    attempt, st, tch.div);
+			tch_fw_download();
+			if (!tch_fw_crc_ok && tch_dl_pace < 32) {
+				/* The last transfer was corrupt.  Doubling the serial-engine
+				 * divider does nothing on the bit-banged path, so slow the
+				 * pacing delay itself and try again. */
+				tch_dl_pace *= 2;
+				printf("LIUQIN TOUCH: firmware checksum bad, slowing the "
+				    "bit-banged download to %u us\n", tch_dl_pace);
+			}
+			(void)tsleep(&liuqin_touch_chan, PZERO, "liuqinfw", hz / 2);
+			(void)tch_nvt_read(NVT_EVENT_RESET_STATE, &st, 1);
+			printf("LIUQIN TOUCH: attempt %d state now 0x%02x (%s)\n", attempt, st,
+			    (st >= 0xa0 && st <= 0xaf) ? "running" : "not ready");
+			if (st >= 0xa0 && st <= 0xaf) {
+				break;
+			}
+		}
+	}
+
+	uint8_t fw[16] = { 0 };
+	if (tch_nvt_read(NVT_FWINFO_ADDR, fw, sizeof(fw)) == 0) {
+		/*
+		 * This map puts the panel geometry somewhere other than fw[4..7]
+		 * (they read 0x4650/0x7800 here), but the version byte and its
+		 * complement and the 38/60 sensor counts are exactly where the
+		 * acceptance values in docs/TOUCH_FW_RE.md say they are, so that
+		 * is the validity test; the report space stays the panel size.
+		 */
+		const uint32_t max_x = ((uint32_t)fw[4] << 8) | fw[5];
+		const uint32_t max_y = ((uint32_t)fw[6] << 8) | fw[7];
+		const bool ver_ok = ((fw[0] + fw[1]) & 0xff) == 0xff;
+		/*
+		 * These are the touch *sensor* counts (18000 x 30720 on this
+		 * panel), ten times the 1800x2880 display; the driver scales
+		 * them, so the old "<= 4096" test threw the right values away.
+		 */
+		const bool geom_ok = max_x > 100 && max_y > 100 &&
+		    max_x <= 65535 && max_y <= 65535;
+		const bool num_ok = fw[2] > 0 && fw[2] < 200 && fw[3] > 0 && fw[3] < 200;
+
+		if (geom_ok) {
+			tch.max_x = max_x;
+			tch.max_y = max_y;
+		}
+		valid = ver_ok;
+		printf("LIUQIN TOUCH: fwinfo %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x "
+		    "%02x %02x %02x %02x %02x %02x (ver 0x%02x%s, %ux%u sensors,%s geometry)\n",
+		    fw[0], fw[1], fw[2], fw[3], fw[4], fw[5], fw[6], fw[7],
+		    fw[8], fw[9], fw[10], fw[11], fw[12], fw[13], fw[14], fw[15],
+		    fw[0], ver_ok ? " ok" : " MISMATCH", fw[2], fw[3],
+		    geom_ok ? " sensor space" : " using the panel size");
+		printf("LIUQIN TOUCH: report space %ux%u, %u fingers, chip 0x%02x (%s)\n",
+		    tch.max_x, tch.max_y, fw[9], fw[14],
+		    num_ok ? "sensor counts match the panel" : "sensor counts odd");
+	} else {
+		printf("LIUQIN TOUCH: fwinfo read failed, report space %ux%u\n",
+		    tch.max_x, tch.max_y);
+	}
+	return valid;
+}
+
+static uint32_t
+tch_scale(uint32_t v, uint32_t max, uint32_t out)
+{
+	const uint32_t r = max ? (uint32_t)(((uint64_t)v * out) / max) : 0;
+
+	return r >= out ? out - 1 : r;
+}
+
+/* A frame with no finger record at all is not news: the buffer can read back
+ * as zeros or 0xff between reports, and treating that as a lift would release
+ * a finger that is still down.  Novatek sends an explicit release record
+ * (event 3) when a finger lifts, so real lifts always decode. */
+/*
+ * Record layout of this part, from the vendor module's nvt_ts_work_func: the
+ * records start at the event buffer itself (stride 6), byte 0 is
+ * (id << 3) | event, and x and y are big-endian 16-bit values at +1 and +3 -
+ * not the packed x/y of the older nt36xxx parts.  The vendor also rejects
+ * event 0 and anything above 2 (3 is a release, reported through the slot
+ * tracking instead).
+ */
+static unsigned
+tch_rec_id(const uint8_t *frame, int i)
+{
+	return frame[6 * i] >> 3;
+}
+
+static unsigned
+tch_rec_event(const uint8_t *frame, int i)
+{
+	return frame[6 * i] & 7u;
+}
+
+static unsigned
+tch_rec_x(const uint8_t *frame, int i)
+{
+	return ((unsigned)frame[6 * i + 1] << 8) | frame[6 * i + 2];
+}
+
+static unsigned
+tch_rec_y(const uint8_t *frame, int i)
+{
+	return ((unsigned)frame[6 * i + 3] << 8) | frame[6 * i + 4];
+}
+
+static bool
+tch_frame_valid(const uint8_t *frame)
+{
+	for (int i = 0; i < NVT_MAX_FINGERS; i++) {
+		const unsigned id = tch_rec_id(frame, i);
+		const unsigned event = tch_rec_event(frame, i);
+
+		if (id >= 1 && id <= NVT_MAX_FINGERS && event >= 1 && event <= 3) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/* One frame: 65 bytes at 0x2fe00, event byte first, then ten 6-byte records
+ * (id << 3 | event, x high, y high, x low nibble << 4 | y low nibble,
+ * weight, pressure).  Finger ids are 1-based and become HID slots 0..9.
+ * Returns how many fingers the frame reports. */
+/*
+ * Does the flashed root really carry the injected library and the plist that
+ * asks for it?  Nothing in user space can tell us until the library runs, so the
+ * kernel looks (vnode_lookup + a size query) and says so in the log.
+ */
+static void tch_probe_injection_files(void);
+
+/* Called from liuqin_ufs.c right after the root is mounted. */
+void
+liuqin_touch_probe_files(void)
+{
+	tch_probe_injection_files();
+}
+
+static void
+tch_probe_injection_files(void)
+{
+	static const char *const paths[] = {
+		"/usr/lib/libliuqintouch.dylib",
+		"/System/Library/LaunchDaemons/com.apple.backboardd.plist",
+		"/System/Library/xpc/launchd.plist",
+		"/usr/libexec/backboardd",
+	};
+
+	for (unsigned i = 0; i < sizeof(paths) / sizeof(paths[0]); i++) {
+		vnode_t vp = NULLVP;
+		struct vnode_attr va;
+		errno_t err = vnode_lookup(paths[i], 0, &vp, vfs_context_current());
+
+		if (err != 0 || vp == NULLVP) {
+			printf("LIUQIN INPUT: %s missing (%d)\n", paths[i], err);
+			continue;
+		}
+		VATTR_INIT(&va);
+		VATTR_WANTED(&va, va_data_size);
+		if (vnode_getattr(vp, &va, vfs_context_current()) == 0) {
+			/* The first bytes say whether the file really is the binary we
+			 * flashed (dyld refuses a file it cannot read as Mach-O). */
+			unsigned char magic[8] = { 0 };
+			int resid = 0;
+
+			if (vn_rdwr(UIO_READ, vp, (caddr_t)magic, sizeof(magic), 0,
+			    UIO_SYSSPACE, 0, vfs_context_ucred(vfs_context_current()), &resid,
+			    current_proc()) == 0) {
+				printf("LIUQIN INPUT: %s present, %lld bytes, magic "
+				    "%02x%02x%02x%02x %02x%02x%02x%02x\n", paths[i],
+				    (long long)va.va_data_size, magic[0], magic[1], magic[2], magic[3],
+				    magic[4], magic[5], magic[6], magic[7]);
+			} else {
+				printf("LIUQIN INPUT: %s present, %lld bytes, unreadable\n",
+				    paths[i], (long long)va.va_data_size);
+			}
+		}
+		vnode_put(vp);
+	}
+}
+
+static uint32_t tch_last_x[NVT_MAX_FINGERS], tch_last_y[NVT_MAX_FINGERS];
+
+/* Frames with at least one decoded contact since boot: the recovery thread
+ * watches it to tell "the panel scans" from "the panel is stuck in its
+ * bootloader even though the state register says running". */
+static volatile unsigned tch_valid_frames;
+/* Liveness counters for the heartbeat: reads that came back at all say whether
+ * the bus works, and the gap to tch_valid_frames says whether the panel scans. */
+static volatile unsigned tch_evt_reads;
+static volatile unsigned tch_evt_errors;
+/* Consecutive report reads whose record area is all 0xFD/0xFE: the vendor's own
+ * nvt_wdt_fw_recovery() reads that pattern as "the application firmware hung"
+ * and re-downloads after ten of them. */
+static volatile unsigned tch_hang_hits;
+static volatile int tch_fw_dead;
+static unsigned tch_fw_revive;
+/* Frame reads to ignore after the host poked INT itself: the edge that poke
+ * makes is ours, not a report from the controller, and must not decide a
+ * firmware hang (the keep-alive poke was reloading the firmware every few
+ * seconds that way). */
+static volatile unsigned tch_poke_grace;
+/*
+ * touch181: the budget was 10, and every revive costs about 3 s of download
+ * plus the 30 s wait that triggers it - which is why "touch dies after 7-8
+ * minutes" (the counter runs out and the panel is then dead for the rest of
+ * the session).  The counter now only limits *consecutive* failures: a single
+ * valid frame gives the part its budget back.
+ */
+#define TCH_REVIVE_MAX  100000u
+
+static int
+tch_frame_decode(const uint8_t *frame, bool *down)
+{
+	uint32_t mask = 0;
+
+	for (int i = 0; i < NVT_MAX_FINGERS; i++) {
+		const unsigned id = tch_rec_id(frame, i);
+		const unsigned event = tch_rec_event(frame, i);
+
+		if (id == 0 || id > NVT_MAX_FINGERS) {
+			continue;
+		}
+		if (event != 1 && event != 2) {         /* 3 = release, 0/4+ invalid */
+			continue;
+		}
+		unsigned x = tch_rec_x(frame, i);
+		unsigned y = tch_rec_y(frame, i);
+		uint32_t rx = tch.max_x, ry = tch.max_y;
+
+		if (tch.swap) {
+			const unsigned t = x;
+
+			x = y;
+			y = t;
+			rx = tch.max_y;
+			ry = tch.max_x;
+		}
+		if (x > rx || y > ry) {
+			continue;
+		}
+		tch_valid_frames++;
+		tch_fw_revive = 0;
+		{
+			static unsigned raw_logs;
+
+			if (raw_logs < 6) {
+				raw_logs++;
+				printf("LIUQIN TOUCH: finger %u ev %u raw %u,%u of %ux%u\n",
+				    id, event, x, y, rx, ry);
+			}
+		}
+		unsigned sx = tch_scale(x, rx, NVT_TOUCH_W);
+		unsigned sy = tch_scale(y, ry, NVT_TOUCH_H);
+
+		if (tch.flip_x) {
+			sx = NVT_TOUCH_W - 1 - sx;
+		}
+		if (tch.flip_y) {
+			sy = NVT_TOUCH_H - 1 - sy;
+		}
+		mask |= 1u << (id - 1);
+		liuqin_hid_touch((int)id - 1, 1, (int)sx, (int)sy);
+		/* The userland injector wants display-normalised samples. */
+		{
+			uint32_t nx = (uint32_t)((uint64_t)sx * 65535u / (NVT_TOUCH_W - 1));
+			uint32_t ny = (uint32_t)((uint64_t)sy * 65535u / (NVT_TOUCH_H - 1));
+
+			pong_touch_post(down[id - 1] ? PONG_TOUCH_MOVE : PONG_TOUCH_DOWN,
+			    id - 1, nx, ny);
+			tch_last_x[id - 1] = nx;
+			tch_last_y[id - 1] = ny;
+		}
+	}
+	for (int slot = 0; slot < NVT_MAX_FINGERS; slot++) {
+		if (down[slot] && !(mask & (1u << slot))) {
+			liuqin_hid_touch(slot, 0, 0, 0);
+			pong_touch_post(PONG_TOUCH_UP, slot, tch_last_x[slot], tch_last_y[slot]);
+		}
+		down[slot] = (mask & (1u << slot)) != 0;
+	}
+	return __builtin_popcount(mask);
+}
+
+static void
+tch_dump_frame(const char *what, const uint8_t *frame)
+{
+	printf("LIUQIN TOUCH: %s %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x\n",
+	    what, frame[0], frame[1], frame[2], frame[3], frame[4],
+	    frame[5], frame[6], frame[7], frame[8], frame[9]);
+	printf("LIUQIN TOUCH: %s %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x\n",
+	    what, frame[10], frame[11], frame[12], frame[13], frame[14],
+	    frame[15], frame[16], frame[17], frame[18], frame[19]);
+}
+
+/*
+ * Idle wake: this panel stops answering once it has been idle for a while (the
+ * display going to sleep is the usual trigger).  Driving the INT line low for a
+ * moment is the cheap wake some Novatek parts accept; if that does not bring the
+ * buffer back within a few tries the caller falls back to a full reset.
+ */
+static bool
+tch_int_wake(void)
+{
+	tch_bb_dir(21, true, 0);
+	delay(200);
+	tch_bb_dir(21, false, 0);
+	tch_wr(tch.tlmm, TLMM_CTL(21), (0u << 2) | (3u << 6));   /* mux 0 (GPIO), pull-up, input */
+	tch_poke_grace = 100;
+	delay(1000);
+	return false;
+}
+
+/* Diagnostics for the "panel asserts INT but no frame decodes" state: dump the
+ * report page at the moment the controller says it has data, twice, plus the
+ * registers that prove the bus still answers. */
+static unsigned tch_int_dumps;
+
+static void
+tch_dump_event_page(unsigned n)
+{
+	uint8_t b[96];
+	uint8_t st = 0;
+	uint8_t fw[4] = { 0 };
+	uint32_t saved_dummy = tch.dummy;
+	unsigned i;
+
+	printf("LIUQIN TOUCH: int-dump %u at pace %u us\n", n, tch.bb_pace_us);
+	if (tch_nvt_read(NVT_EVENT_BUF_ADDR, b, sizeof(b)) == 0) {
+		printf("LIUQIN TOUCH: dump%u 125800:", n);
+		for (i = 0; i < 24; i++) {
+			printf(" %02x", b[i]);
+		}
+		printf("\nLIUQIN TOUCH: dump%u 125818:", n);
+		for (i = 24; i < 48; i++) {
+			printf(" %02x", b[i]);
+		}
+		printf("\n");
+	} else {
+		printf("LIUQIN TOUCH: dump%u 125800 read failed\n", n);
+	}
+	/* The two addresses the older NT36xxx maps use, in case this firmware
+	 * keeps its report somewhere else than the vendor map says. */
+	if (tch_nvt_read(0x2fe00, b, 32) == 0) {
+		printf("LIUQIN TOUCH: dump%u 2fe00:", n);
+		for (i = 0; i < 16; i++) {
+			printf(" %02x", b[i]);
+		}
+		printf("\n");
+	}
+	if (tch_nvt_read(0x11a00, b, 32) == 0) {
+		printf("LIUQIN TOUCH: dump%u 11a00:", n);
+		for (i = 0; i < 16; i++) {
+			printf(" %02x", b[i]);
+		}
+		printf("\n");
+	}
+	/* Same address without the dummy byte: a shift here means the framing
+	 * (not the data) is what we get wrong. */
+	tch.dummy = 0;
+	if (tch_nvt_read(NVT_EVENT_BUF_ADDR, b, 24) == 0) {
+		printf("LIUQIN TOUCH: dump%u nodummy:", n);
+		for (i = 0; i < 16; i++) {
+			printf(" %02x", b[i]);
+		}
+		printf("\n");
+	}
+	tch.dummy = saved_dummy;
+	(void)tch_nvt_read(NVT_EVENT_RESET_STATE, &st, 1);
+	(void)tch_nvt_read(NVT_FWINFO_ADDR, fw, sizeof(fw));
+	printf("LIUQIN TOUCH: dump%u: state 0x%02x fwinfo %02x %02x %02x %02x\n",
+	    n, st, fw[0], fw[1], fw[2], fw[3]);
+}
+
+/*
+ * nvt_wdt_fw_recovery() counts *interrupts* that carry 0xFD/0xFE in the record
+ * area, not reads: after a normal lift the buffer also sits at 0xFD, so a plain
+ * read counter fires on every gesture.  Three interrupts without a frame, on the
+ * other hand, means the part is in its CRC-fail reboot loop (its state register
+ * even reads 0xFC in that loop).
+ */
+static void
+tch_frame_streak(const uint8_t *frame, bool int_edge)
+{
+	if (tch_poke_grace) {
+		tch_poke_grace--;
+		if (int_edge) return;
+	}
+	if (tch_frame_valid(frame)) {
+		tch_hang_hits = 0;
+		return;
+	}
+	if (!int_edge) {
+		return;
+	}
+	if (++tch_hang_hits >= 3) {
+		tch_hang_hits = 0;
+		/*
+		 * touch175: before paying for a whole re-download, give the firmware
+		 * the one thing the vendor gives it after boot - the host-alive write
+		 * to event+0x51 - and look at the report area again.  touch172 ran
+		 * 216 s with the panel reporting and touch171/173/174 lost it 10-18 s
+		 * after boot with the same 0x51 write done once, so this asks whether
+		 * the byte is what the part is waiting for rather than a boot step.
+		 */
+		(void)tch_nvt_write8(NVT_FW_STATUS_BYTE, 0x00);
+		/* A lift, or a read that lands between two reports, also shows
+		 * 0xfd.  Give the part 200 ms (20 frames at its report rate) to
+		 * send a valid frame before paying for a re-download. */
+		for (unsigned wait = 0; wait < 20; wait++) {
+			uint8_t again[NVT_POINT_LEN] = { 0 };
+
+			delay(10 * 1000);
+			if (tch_nvt_read(NVT_EVENT_BUF_ADDR, again, sizeof(again)) == 0 &&
+			    tch_frame_valid(again)) {
+				printf("LIUQIN TOUCH: a valid frame arrived after the "
+				    "0x51 ack, keeping the firmware running\n");
+				return;
+			}
+		}
+		printf("LIUQIN TOUCH: three interrupts with 0xFD in the report area: the "
+		    "firmware is stuck (vendor's CRC-fail loop pattern), %u valid "
+		    "frames so far\n", tch_valid_frames);
+		tch_fw_dead = 1;
+	}
+}
+
+/* touch179: what the report area is doing when frames stop arriving.  A frozen
+ * buffer means the firmware stopped writing; one that keeps changing without
+ * ever validating means the reads race its writes. */
+static unsigned tch_evt_changes;
+static uint8_t tch_evt_head[8];
+
+static bool
+tch_evt_changed(const uint8_t *a, uint8_t *b)
+{
+	memcpy(tch_evt_head, a, sizeof(tch_evt_head));
+	if (memcmp(a, b, NVT_POINT_LEN) != 0) {
+		memcpy(b, a, NVT_POINT_LEN);
+		tch_evt_changes++;
+		return true;
+	}
+	return false;
+}
+
+static void
+liuqin_touch_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint8_t frame[NVT_POINT_LEN];
+	uint8_t last[NVT_POINT_LEN];
+	uint8_t prevbuf[NVT_POINT_LEN];
+	bool down[NVT_MAX_FINGERS] = { false };
+	unsigned errors = 0;
+	unsigned edge_logs = 0;
+	unsigned evt_logs = 0;
+	unsigned polls = 0;
+	bool prev_high = false;
+	int force_poll = 0;
+	bool saw_gpio = false;
+	bool dumped = false;
+	bool fw_released = false;       /* held fingers already released */
+	unsigned empty_run = 0;         /* consecutive frames with no record */
+
+	PE_parse_boot_argn("liuqintouchpoll", &force_poll, sizeof(force_poll));
+	memset(frame, 0, sizeof(frame));
+	memset(last, 0, sizeof(last));
+	memset(prevbuf, 0, sizeof(prevbuf));
+	printf("LIUQIN TOUCH: report thread up, %s\n",
+	    force_poll ? "event-buffer polling" : "INT on gpio21");
+
+	for (;;) {
+		const int ticks = hz / 100 > 0 ? hz / 100 : 1;
+
+		/*
+		 * A firmware download owns the bus and a chunk transfer holds it
+		 * for about a second; a read in between is not just wasted, it
+		 * interleaves page commands with the download and corrupts both.
+		 */
+		if (tch_fw_active) {
+			(void)tsleep(&liuqin_touch_chan, PZERO, "liuqintouch", ticks);
+			continue;
+		}
+		/*
+		 * touch177: the firmware can die in the middle of a drag (the last
+		 * frame it wrote stays "down"), and iOS then keeps the finger
+		 * pressed.  Release every slot as soon as the driver knows the part
+		 * stopped reporting, instead of waiting for the empty-frame run.
+		 */
+		if (tch_fw_dead && !fw_released) {
+			for (int slot = 0; slot < NVT_MAX_FINGERS; slot++) {
+				if (down[slot]) {
+					down[slot] = false;
+					liuqin_hid_touch(slot, 0, 0, 0);
+					/* The userland injector has its own held-finger state;
+					 * a release that only goes to the old kernel HID path
+					 * leaves that state stuck and its next contacts are
+					 * treated as duplicates. */
+					pong_touch_post(PONG_TOUCH_UP, slot,
+					    tch_last_x[slot], tch_last_y[slot]);
+				}
+			}
+			empty_run = 0;
+			fw_released = true;
+			printf("LIUQIN TOUCH: firmware stopped mid-gesture, releasing "
+			    "every held finger\n");
+		} else if (!tch_fw_dead) {
+			fw_released = false;
+		}
+
+		const uint32_t gpio = tch_rd(tch.tlmm, TLMM_CTL(21) + TLMM_IN_OUT);
+		bool go = force_poll || (gpio & TLMM_IN_BIT) != 0;
+
+		const bool int_high = (gpio & TLMM_IN_BIT) != 0;
+
+		const bool int_edge = int_high && !prev_high;
+
+		if (int_edge && tch_int_dumps < 8) {
+			tch_int_dumps++;
+			tch_dump_event_page(tch_int_dumps);
+		}
+		if (int_high != prev_high && edge_logs < 40) {
+			edge_logs++;
+			printf("LIUQIN TOUCH: gpio21 %s (level %u)\n",
+			    int_high ? "asserted" : "released", int_high ? 1 : 0);
+			if (edge_logs <= 6) {
+				char mark[24];
+
+				snprintf(mark, sizeof(mark), "touch int %u", int_high ? 1u : 0u);
+				tch_visible_mark(mark);
+			}
+		}
+		prev_high = int_high;
+		if (!saw_gpio) {
+			saw_gpio = true;
+			printf("LIUQIN TOUCH: gpio21 in/out 0x%08x (in %u out %u) mux %u pull %u\n",
+			    gpio, (gpio & TLMM_IN_BIT) ? 1 : 0, (gpio & TLMM_OUT_BIT) ? 1 : 0,
+			    TLMM_MUX(tch_rd(tch.tlmm, TLMM_CTL(21))),
+			    TLMM_PULL(tch_rd(tch.tlmm, TLMM_CTL(21))));
+		}
+		/*
+		 * With no interrupt the buffer still has to be watched: read it on
+		 * every tick (10 ms) for the first minute of the thread's life, then
+		 * back off to once a second so the path stays alive without cost.
+		 */
+		polls++;
+		/*
+		 * No idle watchdog here any more.  It poked the INT line every
+		 * two seconds without a finger and pulsed the reset line every
+		 * third poke, which put a running panel back into its bootloader
+		 * about every six seconds; the next download then took 70 s and
+		 * mostly failed, so touch never survived.  Silence with nobody
+		 * touching the glass is not a fault: the recovery thread decides
+		 * that from the controller's own state register, and only when
+		 * the part really stopped answering.
+		 */
+		/*
+		 * The interrupt line of this panel never asserts, so the event buffer
+		 * has to be polled for the lifetime of the thread.  This used to skip
+		 * the read entirely once "polls" passed 6000, which is exactly the
+		 * "touch works for a minute and then stops" this port showed: after
+		 * the first minute nothing was read at all any more.
+		 */
+		const bool health = !go;
+		/* touch179: does the report area still change after the panel stops
+		 * producing frames?  A frozen buffer means the firmware stopped
+		 * writing; a buffer that keeps changing but never validates means we
+		 * are racing its writes.  Counted here, printed in the heartbeat. */
+
+		/*
+		 * One read per tick, not two: reading the 109-byte block and then
+		 * the 65-byte frame races the controller's single buffer and was
+		 * what made a held finger alternate between "frame" and "empty".
+		 */
+		/*
+		 * The candidate-address hunt and the 0x11a00 read that used to
+		 * live here were for the NT36523 map; the event buffer of this
+		 * part is 0x125800 (refs/novatek/nt36532_vendor_map.md).
+		 */
+		/* Every attempt is counted so the heartbeat can say whether "no
+		 * frames" means a dead bus or a panel that simply is not sending. */
+		if (tch_nvt_read(NVT_EVENT_BUF_ADDR, frame, sizeof(frame)) != 0) {
+			tch_evt_errors++;
+			if (errors++ < 4) {
+				printf("LIUQIN TOUCH: event read failed (irq 0x%08x dma tx 0x%08x rx 0x%08x)\n",
+				    tch.last_irq, tch.dma_tx_status, tch.dma_rx_status);
+			}
+		} else if (tch_evt_changed(frame, prevbuf), tch_evt_reads++,
+		    tch_frame_streak(frame, int_edge),
+		    !tch_frame_valid(frame) && evt_logs < 12 &&
+		    memcmp(frame, last, sizeof(frame)) != 0) {
+			evt_logs++;
+			printf("LIUQIN TOUCH: evt data %02x %02x %02x %02x %02x %02x %02x %02x (no record)\n",
+			    frame[0], frame[1], frame[2], frame[3],
+			    frame[4], frame[5], frame[6], frame[7]);
+			if (evt_logs <= 4) {
+				char mark[32];
+
+				snprintf(mark, sizeof(mark), "touch evt %02x%02x%02x%02x",
+				    frame[0], frame[1], frame[2], frame[3]);
+				tch_visible_mark(mark);
+			}
+			memcpy(last, frame, sizeof(frame));
+		} else if (!tch_frame_valid(frame)) {
+			/*
+			 * A lift shows up as an empty frame (all 0xff, then 0xfd at
+			 * the end of a gesture), but so does a read that lands between
+			 * two reports.  Releasing on the first empty frame turned a
+			 * drag into a stream of taps (55 ups in one swipe on touch45),
+			 * so a release needs a run of them - ~6 ticks, 120 ms at the
+			 * loop's rate.  A real lift still ends the finger within a
+			 * gesture timeout.
+			 */
+			if (empty_run < 0xff) {
+				empty_run++;
+			}
+			if (empty_run >= 6) {
+				for (int slot = 0; slot < NVT_MAX_FINGERS; slot++) {
+					if (down[slot]) {
+						down[slot] = false;
+						liuqin_hid_touch(slot, 0, 0, 0);
+						pong_touch_post(PONG_TOUCH_UP, slot,
+						    tch_last_x[slot], tch_last_y[slot]);
+					}
+				}
+			}
+		} else if (tch_frame_valid(frame)) {
+			empty_run = 0;
+			if (memcmp(frame, last, sizeof(frame)) != 0) {
+				if (!dumped) {
+					dumped = true;
+					tch_dump_frame("first frame", frame);
+				}
+				memcpy(last, frame, sizeof(frame));
+				const int fingers = tch_frame_decode(frame, down);
+
+				if (fingers > 0) {
+					static unsigned frame_marks;
+
+					if (frame_marks < 6) {
+						char mark[32];
+
+						frame_marks++;
+						snprintf(mark, sizeof(mark), "touch frame %d", fingers);
+						tch_visible_mark(mark);
+					}
+				}
+
+				if (health && !force_poll && fingers > 0) {
+					/* A touch arrived without the interrupt line
+					 * asserting: wrong pin read, wrong polarity or
+					 * no INT at all.  Poll from now on. */
+					force_poll = 1;
+					printf("LIUQIN TOUCH: gpio21 did not assert for a touch, "
+					    "polling the event buffer\n");
+				}
+			}
+		}
+		(void)tsleep(&liuqin_touch_chan, PZERO, "liuqintouch", ticks);
+	}
+}
+
+/*
+ * Is the SMMU reachable at all?  UFS carries iommus = <&apps_smmu 0xe0 0> in the
+ * vendor DTB and moves 16 MiB/s with physical addresses, so the TCU is powered
+ * and that stream bypasses - yet the first read of the GR0 window aborts with a
+ * synchronous external abort.  This probe reads four windows in order, printing
+ * before each read, so the last line on screen names the window that dies.
+ * liuqinsmmuprobe=1 enables it.
+ */
+static void
+tch_smmu_probe_windows(void)
+{
+	static const struct {
+		uint32_t pa;
+		const char *what;
+	} w[] = {
+		{ 0x151ce000u, "tcru" },
+		{ 0x151d1000u, "anoc_1_tbu" },
+		{ 0x3da0000u,  "kgsl_smmu" },
+		{ 0x15000000u, "apps_smmu_gr0" },
+	};
+	int on = 0;
+
+	(void)PE_parse_boot_argn("liuqinsmmuprobe", &on, sizeof(on));
+	if (on <= 0) {
+		return;
+	}
+	liuqin_console_force = 1;
+	for (unsigned i = 0; i < sizeof(w) / sizeof(w[0]); i++) {
+		vm_offset_t v;
+		uint32_t a, b;
+
+		printf("LIUQIN TOUCH: smmu-probe %s: mapping 0x%x\n", w[i].what, w[i].pa);
+		v = ml_io_map(w[i].pa, PAGE_SIZE);
+		printf("LIUQIN TOUCH: smmu-probe %s: va 0x%llx, reading\n", w[i].what,
+		    (uint64_t)v);
+		a = tch_rd(v, 0x0000);
+		b = tch_rd(v, 0x0020);
+		printf("LIUQIN TOUCH: smmu-probe %s: [0x00] 0x%08x [0x20] 0x%08x\n",
+		    w[i].what, a, b);
+	}
+	printf("LIUQIN TOUCH: smmu-probe done\n");
+	liuqin_console_force = 0;
+}
+
+/* The SPI bring-up runs from its own thread a few seconds after the boot has
+ * settled, not from the mount path: a hang here must not take the boot down
+ * with it, and by then the persistent log has flushed everything that led to
+ * it.  The boot marks are drawn even with liuqinmute=1, so the screen alone
+ * tells how far it got. */
+static void
+liuqin_touch_setup_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	int delay_s = 10;
+
+	(void)PE_parse_boot_argn("liuqintouchdelay", &delay_s, sizeof(delay_s));
+	if (delay_s < 0) {
+		delay_s = 0;
+	}
+	if (delay_s > 120) {
+		delay_s = 120;
+	}
+	printf("LIUQIN TOUCH: driver %s\n", TCH_BUILD);
+	printf("LIUQIN TOUCH: SPI bring-up in %d s\n", delay_s);
+	(void)tsleep(&liuqin_touch_chan, PZERO, "liuqintspi", hz * delay_s);
+
+	tch_smmu_probe_windows();
+	liuqin_boot_mark("touch spi start");
+	/* Draw the bring-up lines as well: with liuqinmute=1 they would only
+	 * reach the persistent log, and a wedge here freezes the log thread
+	 * before it flushes.  The last line on screen then names the step. */
+	liuqin_console_force = 1;
+	if (liuqin_touch_spi_setup() != 0) {
+		liuqin_console_force = 0;
+		liuqin_boot_mark("touch spi failed");
+		return;
+	}
+	const bool valid = tch_novatek_info();
+
+	liuqin_console_force = 0;
+	if (!valid) {
+		/* No trustworthy id: do not feed the HID layer garbage.  Watch the
+		 * INT line instead, which still says whether the MCU scans. */
+		thread_t watcher;
+
+		liuqin_boot_mark("touch no valid id");
+		if (kernel_thread_start(liuqin_touch_int_watch, NULL, &watcher) == KERN_SUCCESS) {
+			thread_deallocate(watcher);
+		}
+		return;
+	}
+	liuqin_boot_mark("touch id read");
+	liuqin_touch_reports_start();
+	liuqin_boot_mark("touch reports up");
+}
+
+/*
+ * No SPI involved: watch gpio21, the controller's interrupt line.  A running
+ * touch MCU asserts it when a finger lands, so a transition while the user
+ * touches the panel proves the die is alive and only our bus is wrong.  Sixty
+ * seconds of 1 ms sampling, started when the bit-bang probe gives up.
+ */
+static void
+liuqin_touch_int_watch(__unused void *arg, __unused wait_result_t wr)
+{
+	int last = bb_get(21);
+	unsigned changes = 0;
+
+	liuqin_boot_mark("touch int watch");
+	extern int liuqin_marks_draw;
+	if (liuqin_marks_draw) {
+		liuqin_console_force = 1;       /* the transitions must be visible */
+	}
+	printf("LIUQIN TOUCH: watching gpio21 (INT) for 60 s, start is %d - touch the panel now\n", last);
+	for (unsigned i = 0; i < 60000; i++) {
+		const int v = bb_get(21);
+
+		if (v != last) {
+			printf("LIUQIN TOUCH: gpio21 -> %d after %u ms (%u transitions)\n",
+			    v, i, ++changes);
+			last = v;
+		}
+		delay(1000);
+	}
+	printf("LIUQIN TOUCH: gpio21 watch finished, %u transitions\n", changes);
+	liuqin_console_force = 0;
+}
+
+/*
+ * Is the application firmware running?  Two independent answers, because one
+ * register is not proof: a part still in its bootloader can answer 0x00, and the
+ * DLM download can come back with a wrong checksum while the firmware runs
+ * anyway.  The version byte in FWINFO and its complement are the second
+ * witness.
+ */
+static bool
+tch_panel_running_once(void)
+{
+	uint8_t st = 0;
+	uint8_t fw[4] = { 0 };
+
+	if (tch_nvt_read(NVT_EVENT_RESET_STATE, &st, 1) == 0 && st >= 0xa0 && st <= 0xaf) {
+		return true;
+	}
+	if (tch_nvt_read(NVT_FWINFO_ADDR, fw, sizeof(fw)) == 0 &&
+	    fw[0] != 0x00 && fw[0] != 0xff && (uint8_t)(fw[0] + fw[1]) == 0xff) {
+		return true;
+	}
+	return false;
+}
+
+/* Three tries fifty milliseconds apart: the bit-banged bus drops a bit now and
+ * then, and one corrupt read must never be taken for a dead panel when the
+ * answer is to download the firmware again. */
+static bool
+tch_panel_running(void)
+{
+	for (int i = 0; i < 3; i++) {
+		if (tch_panel_running_once()) {
+			return true;
+		}
+		delay(50 * 1000);
+	}
+	return false;
+}
+
+/* The trim id comes from ROM even in the bootloader, so a part that answers it
+ * is reachable and a software reset plus a download is enough to revive it. */
+static bool
+tch_id_reads(void)
+{
+	uint8_t id[6] = { 0 };
+
+	if (tch_nvt_read(NVT_CHIP_VER_TRIM_ADDR, id, sizeof(id)) != 0) {
+		return false;
+	}
+	return id[4] == 0x65 && id[5] == 0x03;
+}
+
+/*
+ * Panel recovery, driven by what the controller says about itself instead of by
+ * the contact counter.  A panel with no finger on it reports no contact, and
+ * that is not a fault; the old thread read it as one and reset the part five
+ * seconds after every boot, which threw it back into its bootloader where the
+ * bit-banged download needs 70 s and mostly fails.  Now the state is checked
+ * every five seconds, a reset is only considered after fifteen seconds of a
+ * part that does not answer at all, and a part that still answers its trim id
+ * is revived with a software reset and a download - not with a reset pulse,
+ * because the pulse is what left the post-reset downloads reading a garbage
+ * BLD descriptor.  Boot arg liuqinrecover=0 disables the thread.
+ */
+static void
+liuqin_touch_recover_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	int level = 1;
+	int silent = 0;
+	int rounds = 0;
+	unsigned beats = 0;
+	unsigned last_frames = 0;
+	unsigned tch_quiet_checks = 0;
+	unsigned keepalive_ms = 0;
+
+	(void)PE_parse_boot_argn("liuqinrecover", &level, sizeof(level));
+	if (level <= 0) {
+		printf("LIUQIN TOUCH: recovery disabled (liuqinrecover=0)\n");
+		return;
+	}
+	/* liuqinkeepalive=<ms>: poke INT on that period no matter what, to keep a
+	 * panel that naps from ever reaching its low-power state.  0 (default)
+	 * keeps the reactive behaviour: poke after five seconds of silence. */
+	/*
+	 * touch176: liuqinkeepalive=2000 has been in the boot line since touch141,
+	 * and it drives the controller's INT output pin low from the host every two
+	 * seconds whenever the panel is idle.  That is the only thing this driver
+	 * does differently when nobody is touching, and every boot that died did so
+	 * while idle (touch174 14 s, touch173 10 s, touch175 about a minute after
+	 * the last contact), while the boot that ran 216 s was being touched the
+	 * whole time.  The poke is the vendor's own wake path for a napping part,
+	 * but it is not free: it now needs liuqintouchwake=1 to run at all.
+	 */
+	{
+		int ka = 0, wake = 0;
+
+		(void)PE_parse_boot_argn("liuqinkeepalive", &ka, sizeof(ka));
+		(void)PE_parse_boot_argn("liuqintouchwake", &wake, sizeof(wake));
+		tch_int_poke_ok = wake != 0;
+		if (wake != 0 && ka >= 500 && ka <= 60000) {
+			keepalive_ms = (unsigned)ka;
+		}
+	}
+	if (keepalive_ms) {
+		printf("LIUQIN TOUCH: keep-alive: poking INT every %u ms\n", keepalive_ms);
+	}
+	for (;;) {
+		bool running;
+		const int period = keepalive_ms ? (int)(keepalive_ms / 1000 ? keepalive_ms / 1000 : 1) : 5;
+
+		(void)tsleep(&tch_valid_frames, PZERO, "liuqinrcv", hz * period);
+		if (tch_int_poke_ok && keepalive_ms && bb_get(21) == 0) {
+			/* Only poke while the controller is not driving INT itself. */
+			(void)tch_int_wake();
+		}
+		running = tch_panel_running();
+		/* Every 30 s one line that says where the chain stands: does the bus
+		 * answer at all, does the state register say the firmware runs, and
+		 * has a single frame with a contact ever arrived. */
+		if ((++beats % 6) == 0) {
+			printf("LIUQIN TOUCH: beat %us: %s, %u event reads (%u failed, "
+			    "%u changes), %u contact frames, fw 0x51=0x%02x, buf %02x "
+			    "%02x %02x %02x\n", beats * (unsigned)period,
+			    running ? "running" : "silent", tch_evt_reads,
+			    tch_evt_errors, tch_evt_changes, tch_valid_frames,
+			    tch_fw_status_byte(), tch_evt_head[0], tch_evt_head[1],
+			    tch_evt_head[2], tch_evt_head[3]);
+		}
+		/* touch172: keep the handshake byte clear for the whole run, not just
+		 * once after boot.  If the firmware sets it and nobody clears it, it
+		 * stops scanning ~18 s in and the report area turns to 0xfd. */
+		if (tch_fw_status_byte() != 0x00 && ++tch_status_clears <= 8) {
+			tch_clear_fw_status("heartbeat");
+		}
+		/* Frame bookkeeping, and both revive paths, must stay *above* the
+		 * `if (running)` branch: the part keeps answering state 0xa3 even
+		 * after it has stopped reporting, so everything placed below that
+		 * branch never runs - which is why touch142 never revived. */
+		if (tch_valid_frames == last_frames) {
+			tch_quiet_checks++;
+		} else {
+			last_frames = tch_valid_frames;
+			tch_quiet_checks = 0;
+		}
+		if (tch_fw_dead && tch_fw_revive < TCH_REVIVE_MAX) {
+			tch_fw_revive++;
+			printf("LIUQIN TOUCH: revive %u: interrupts without a frame, "
+			    "software reset and re-download\n", tch_fw_revive);
+			/* touch171: this used to write 0xa5 to 0x00000, the first
+			 * byte of ILM, so the latch that parks the part in the 0xfd
+			 * loop was never cleared; the flag lives at 0x1fb535. */
+			tch_crc_flag("revive", true);
+			/* touch178: this used to write 0x69 and read the info back,
+			 * which is not a recovery at all - the log right after it says
+			 * `fw state 0xa3 (running)`, so nothing was reset and nothing
+			 * was downloaded, and the panel went on reporting nothing for
+			 * the rest of the boot.  The full download is the only thing
+			 * that restarts a Novatek part. */
+			(void)tch_fw_download();
+			(void)tch_novatek_info();
+			/* touch180: a reload that reports "BOOTED" is not the same as a
+			 * panel that reports touches - 178's log has revives after which
+			 * the frame counter never moved again.  Print what the part says
+			 * about itself right after the reload so the next log separates
+			 * "the download failed" from "the firmware booted but does not
+			 * scan". */
+			{
+				uint8_t b[8] = { 0 };
+
+				(void)tch_nvt_read(NVT_EVENT_BUF_ADDR, b, sizeof(b));
+				printf("LIUQIN TOUCH: after the reload the report area reads "
+				    "%02x %02x %02x %02x, 0x51 0x%02x, state %s\n",
+				    b[0], b[1], b[2], b[3], tch_fw_status_byte(),
+				    tch_panel_running() ? "running" : "not ready");
+			}
+			tch_fw_dead = 0;
+			tch_hang_hits = 0;
+			tch_quiet_checks = 0;
+			last_frames = tch_valid_frames;
+			silent = 0;
+			continue;
+		}
+		/* The part can also simply go to sleep: it keeps answering its
+		 * registers but stops scanning and never asserts INT.  A Novatek part
+		 * in deep sleep wakes when the host pulls INT low for a moment. */
+		{
+			const unsigned quiet_s = tch_quiet_checks * (unsigned)period;
+
+			if (quiet_s >= 5 && quiet_s < 5 + (unsigned)period) {
+				if (tch_int_poke_ok) {
+					printf("LIUQIN TOUCH: %u s without a frame, poking INT "
+					    "to wake the panel\n", quiet_s);
+					(void)tch_int_wake();
+				} else {
+					printf("LIUQIN TOUCH: %u s without a frame, INT poke "
+					    "disabled (liuqintouchwake=1 enables it)\n", quiet_s);
+				}
+			}
+		}
+		/* The panel naps after a lift; the INT wake (liuqintouchwake=1)
+		 * brings it back in milliseconds.  Keep the reload only as a
+		 * fallback for a part that does not wake at all. */
+		/* Only a last resort: a panel that answers no interrupt at all.
+		 * A real touch asserts INT and the frame streak above reloads it. */
+		if (tch_quiet_checks * (unsigned)period >= 300 &&
+		    tch_fw_revive < TCH_REVIVE_MAX) {
+			tch_fw_revive++;
+			printf("LIUQIN TOUCH: revive %u: no contact frame for %u s, "
+			    "re-downloading the firmware\n", tch_fw_revive,
+			    tch_quiet_checks * (unsigned)period);
+			/* touch171: this used to write 0xa5 to 0x00000, the first
+			 * byte of ILM, so the latch that parks the part in the 0xfd
+			 * loop was never cleared; the flag lives at 0x1fb535. */
+			tch_crc_flag("revive", true);
+			/* touch178: this used to write 0x69 and read the info back,
+			 * which is not a recovery at all - the log right after it says
+			 * `fw state 0xa3 (running)`, so nothing was reset and nothing
+			 * was downloaded, and the panel went on reporting nothing for
+			 * the rest of the boot.  The full download is the only thing
+			 * that restarts a Novatek part. */
+			(void)tch_fw_download();
+			(void)tch_novatek_info();
+			/* touch180: a reload that reports "BOOTED" is not the same as a
+			 * panel that reports touches - 178's log has revives after which
+			 * the frame counter never moved again.  Print what the part says
+			 * about itself right after the reload so the next log separates
+			 * "the download failed" from "the firmware booted but does not
+			 * scan". */
+			{
+				uint8_t b[8] = { 0 };
+
+				(void)tch_nvt_read(NVT_EVENT_BUF_ADDR, b, sizeof(b));
+				printf("LIUQIN TOUCH: after the reload the report area reads "
+				    "%02x %02x %02x %02x, 0x51 0x%02x, state %s\n",
+				    b[0], b[1], b[2], b[3], tch_fw_status_byte(),
+				    tch_panel_running() ? "running" : "not ready");
+			}
+			tch_fw_dead = 0;
+			tch_hang_hits = 0;
+			tch_quiet_checks = 0;
+			last_frames = tch_valid_frames;
+			silent = 0;
+			continue;
+		}
+		if (running) {
+			if (silent >= 3) {
+				printf("LIUQIN TOUCH: panel answers again, no reset needed\n");
+			}
+			silent = 0;
+			continue;
+		}
+		silent++;
+		if (silent < 3) {
+			printf("LIUQIN TOUCH: panel silent (check %d of 3)\n", silent);
+			continue;
+		}
+		if (rounds >= 3) {
+			printf("LIUQIN TOUCH: recovery gave up after %d rounds\n", rounds);
+			return;
+		}
+		rounds++;
+		printf("LIUQIN TOUCH: recovery %d: panel silent for %d checks, waking it\n",
+		    rounds, silent);
+		(void)tch_int_wake();
+		delay(20 * 1000);
+		if (tch_panel_running()) {
+			printf("LIUQIN TOUCH: recovery %d: awake after the poke\n", rounds);
+			silent = 0;
+			continue;
+		}
+		if (!tch_id_reads()) {
+			printf("LIUQIN TOUCH: recovery %d: no answer at all, pulsing reset\n",
+			    rounds);
+			tch_bb_dir(tch.pin_reset, true, 0);
+			delay(100 * 1000);
+			tch_bb_dir(tch.pin_reset, true, 1);
+			delay(200 * 1000);
+			for (int i = 0; i < 10 && !tch_id_reads(); i++) {
+				delay(20 * 1000);
+			}
+		} else {
+			printf("LIUQIN TOUCH: recovery %d: part answers, software reset and "
+			    "download\n", rounds);
+		}
+		(void)tch_novatek_info();
+		silent = 0;
+	}
+}
+
+static void
+liuqin_touch_reports_start(void)
+{
+	thread_t thread;
+
+	tch_probe_injection_files();
+	if (kernel_thread_start(liuqin_touch_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("LIUQIN TOUCH: report thread not started\n");
+	}
+	if (kernel_thread_start(liuqin_touch_recover_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+void liuqin_touch_probe(void);
+
+void
+pong_nt36532_init(void)
+{
+	if (!pong_touch_device_ready()) {
+		printf("PONG TOUCH: /dev/pong-touch unavailable; probe skipped\n");
+		return;
+	}
+	liuqin_touch_probe();
+}
+
+void
+liuqin_touch_probe(void)
+{
+	int level = 0;
+	if (!PE_parse_boot_argn("pong_touch", &level, sizeof(level))) {
+		(void)PE_parse_boot_argn("liuqintouch", &level, sizeof(level));
+	}
+	if (level <= 0) {
+		return;
+	}
+	{
+		int div = 32, swap = 0, flip = 0, dlpace = (int)tch_dl_pace;
+
+		(void)PE_parse_boot_argn("liuqintouchdiv", &div, sizeof(div));
+		(void)PE_parse_boot_argn("liuqintouchswap", &swap, sizeof(swap));
+		(void)PE_parse_boot_argn("liuqintouchflip", &flip, sizeof(flip));
+		(void)PE_parse_boot_argn("liuqintouchdlpace", &dlpace, sizeof(dlpace));
+		tch.div = div < 2 ? 2 : (div > (int)CLK_DIV_MSK ? CLK_DIV_MSK : (uint32_t)div);
+		tch.swap = swap != 0;
+		tch.flip_x = (flip & 1) != 0;
+		tch.flip_y = (flip & 2) != 0;
+		if (dlpace >= 1 && dlpace <= 50) {
+			tch_dl_pace = (uint32_t)dlpace;
+		}
+	}
+	vm_offset_t gcc = ml_io_map(GCC_PA, GCC_SIZE);
+	vm_offset_t tlmm = ml_io_map(TLMM_PA, TLMM_SIZE);
+	if (gcc == 0 || tlmm == 0) {
+		printf("LIUQIN TOUCH: map failed (gcc %d tlmm %d)\n", gcc != 0, tlmm != 0);
+		return;
+	}
+	tch.tlmm = tlmm;
+
+	/* --- GCC: is the wrapper clocked at all? --- */
+	const uint32_t cbcr = tch_rd(gcc, GCC_QUPV3_WRAP0_CBCR);
+	printf("LIUQIN TOUCH: GCC QUPV3_WRAP0_CBCR 0x%08x [m_ahb %d s_ahb %d core %d core2x %d s4 %d]\n",
+	    cbcr,
+	    (cbcr & QUP_CBCR_M_AHB) != 0, (cbcr & QUP_CBCR_S_AHB) != 0,
+	    (cbcr & QUP_CBCR_CORE) != 0, (cbcr & QUP_CBCR_CORE_2X) != 0,
+	    (cbcr & QUP_CBCR_S4) != 0);
+	const uint32_t s4_halt = tch_rd(gcc, GCC_S4_CBCR);
+	const uint32_t cmd = tch_rd(gcc, GCC_S4_CMD_RCGR);
+	const uint32_t cfg = tch_rd(gcc, GCC_S4_CFG_RCGR);
+	const uint32_t m = tch_rd(gcc, GCC_S4_M);
+	const uint32_t n = tch_rd(gcc, GCC_S4_N);
+	const uint32_t d = tch_rd(gcc, GCC_S4_D);
+	printf("LIUQIN TOUCH: GCC S4 halt 0x%08x cmd 0x%08x cfg 0x%08x m %u n %u d %u (%s)\n",
+	    s4_halt, cmd, cfg, m, n, d,
+	    (s4_halt & CBCR_CLK_OFF) ? "off" : "running");
+
+	/* --- TLMM: what function do the five pins carry? --- */
+	const uint32_t pins[5] = { 16, 17, 18, 19, 21 };
+	for (unsigned i = 0; i < 5; i++) {
+		const uint32_t ctl = tch_rd(tlmm, TLMM_CTL(pins[i]));
+		printf("LIUQIN TOUCH: gpio%u ctl 0x%08x mux %u pull %u drive %u %s\n",
+		    pins[i], ctl, TLMM_MUX(ctl), TLMM_PULL(ctl), TLMM_DRIVE(ctl),
+		    TLMM_MUX(ctl) == 1 ? "(qup4)" : "(not qup4)");
+	}
+
+	/* --- stage 2: switch the engine on, then read it --- */
+	if (level >= 2) {
+		uint32_t v = tch_rd(gcc, GCC_QUPV3_WRAP0_CBCR);
+		if (!(v & QUP_CBCR_S4)) {
+			*(volatile uint32_t *)(gcc + GCC_QUPV3_WRAP0_CBCR) = v | QUP_CBCR_S4;
+			__asm__ volatile ("dmb oshst" ::: "memory");
+			printf("LIUQIN TOUCH: GCC QUPV3_WRAP0_CBCR 0x%08x -> 0x%08x\n", v,
+			    tch_rd(gcc, GCC_QUPV3_WRAP0_CBCR));
+		}
+		/* RCG: BI_TCXO (src 0) in MND mode, no divider, then root on. */
+		*(volatile uint32_t *)(gcc + GCC_S4_M) = 0;
+		*(volatile uint32_t *)(gcc + GCC_S4_N) = 0;
+		*(volatile uint32_t *)(gcc + GCC_S4_D) = 0;
+		*(volatile uint32_t *)(gcc + GCC_S4_CFG_RCGR) = 0;
+		__asm__ volatile ("dmb oshst" ::: "memory");
+		*(volatile uint32_t *)(gcc + GCC_S4_CMD_RCGR) = RCG_CMD_UPDATE | RCG_CMD_ROOT_EN;
+		int spin;
+		for (spin = 0; spin < 1000; spin++) {
+			if (!(tch_rd(gcc, GCC_S4_CMD_RCGR) & RCG_CMD_UPDATE)) {
+				break;
+			}
+			delay(10);
+		}
+		const uint32_t cmd2 = tch_rd(gcc, GCC_S4_CMD_RCGR);
+		const uint32_t halt2 = tch_rd(gcc, GCC_S4_CBCR);
+		printf("LIUQIN TOUCH: s4 RCG cmd 0x%08x (%s%s) halt 0x%08x (%s)\n", cmd2,
+		    (cmd2 & RCG_CMD_ROOT_OFF) ? "root-off " : "root-on ",
+		    (cmd2 & RCG_CMD_UPDATE) ? "update-stuck" : "update-done",
+		    halt2, (halt2 & CBCR_CLK_OFF) ? "off" : "running");
+		/* Pins: data/clk/cs to qup4.  The mux value is the index of the
+		 * function in the pin's function list, and pinctrl-sm8450.c lists
+		 * gpio16..19 as PINGROUP(n, qup4, phase_flag, ...), so qup4 is 1
+		 * and 2 is phase_flag (touch4 wrote 2 and left the SPI unconnected).
+		 * Drive 6 mA, no bias: the DT's qup_spi4_data_clk/qup_spi4_cs. */
+		for (unsigned i = 0; i < 4; i++) {
+			const uint32_t pin = 16 + i;
+			const uint32_t ctl = (1u << 2) | (0u << 0) | (2u << 6);
+			*(volatile uint32_t *)(tlmm + TLMM_CTL(pin)) = ctl;
+			__asm__ volatile ("dmb oshst" ::: "memory");
+			printf("LIUQIN TOUCH: gpio%u ctl 0x%08x -> 0x%08x\n", pin,
+			    tch_rd(tlmm, TLMM_CTL(pin)), ctl);
+		}
+		/* 2 is keeper bias on this SoC, not pull-up (pinctrl-msm:
+		 * MSM_KEEPER 2, MSM_PULL_UP 3); the INT line wants a pull-up. */
+		*(volatile uint32_t *)(tlmm + TLMM_CTL(21)) = (0u << 2) | (3u << 0);
+		__asm__ volatile ("dmb oshst" ::: "memory");
+		printf("LIUQIN TOUCH: gpio21 ctl 0x%08x (input, pull-up)\n", tch_rd(tlmm, TLMM_CTL(21)));
+	}
+
+	/* --- SE4: only when its clocks are up, otherwise the bus would hang. --- */
+	/* Re-read: stage 2 may just have switched the engine on. */
+	const uint32_t now = tch_rd(gcc, GCC_QUPV3_WRAP0_CBCR);
+	const bool clocked = (now & (QUP_CBCR_M_AHB | QUP_CBCR_CORE | QUP_CBCR_CORE_2X | QUP_CBCR_S4)) ==
+	    (QUP_CBCR_M_AHB | QUP_CBCR_CORE | QUP_CBCR_CORE_2X | QUP_CBCR_S4);
+	if (!clocked) {
+		printf("LIUQIN TOUCH: SE4 not clocked, registers not read\n");
+		return;
+	}
+	vm_offset_t se = ml_io_map(SE4_PA, SE4_SIZE);
+	if (se == 0) {
+		printf("LIUQIN TOUCH: SE4 map failed\n");
+		return;
+	}
+	tch.se = se;
+	printf("LIUQIN TOUCH: SE4 status 0x%08x fwrev 0x%08x s_cmd 0x%08x s_irq 0x%08x\n",
+	    tch_rd(se, SE_GENI_STATUS), tch_rd(se, GENI_FW_REVISION_RO),
+	    tch_rd(se, SE_GENI_S_CMD0), tch_rd(se, SE_GENI_S_IRQ_STATUS));
+
+	/* Buttons live on the PMICs and need nothing from the touch engine. */
+	/* pong_buttons.c owns the PMIC keys; do not start a second SPMI consumer. */
+
+	/* --- stage 3: SPI master, Novatek chip id, report thread --- */
+	if (level >= 3) {
+		thread_t thread;
+
+		if (kernel_thread_start(liuqin_touch_setup_thread, NULL, &thread) == KERN_SUCCESS) {
+			thread_deallocate(thread);
+			liuqin_boot_mark("touch clocks+pins ready");
+		} else {
+			printf("LIUQIN TOUCH: SPI bring-up thread not started\n");
+		}
+	}
+}
+
+/*
+ * ---------------------------------------------------------------- PMIC keys
+ *
+ * None of the tablet's three buttons is on a TLMM pin.  The device tree (both
+ * the stock overlay and the mainline liuqin DTS) puts them on the PMICs, which
+ * are only reachable over SPMI:
+ *
+ *   power        PMK8350 PON, SPMI SID 0, PON_RT_STS at 0x1310, bit 7
+ *                (qcom,pmk8350-pwrkey, code KEY_POWER)
+ *   volume down  the same PON byte, bit 6 - PON RESIN, wired to
+ *                qcom,pmk8350-resin with linux,code = KEY_VOLUMEDOWN
+ *   volume up    PM8350 GPIO6, SPMI SID 1, base 0x8d00, RT_STS at 0x8d10
+ *                (gpio-keys/key-volume-up, PM8350_ACTIVE_LOW)
+ *
+ * The SPMI master is the PMIC arbiter at 0xc42d000 ("qcom,spmi-pmic-arb").
+ * This part is arbiter v7.  Two details matter, and both were wrong in
+ * touch173, which is why ppid 0x013 was never found:
+ *
+ *   - the v7 APID->PPID table is at core + 0x2000 + 4*apid, not at 0x0b00
+ *     (Linux drivers/spmi/spmi-pmic-arb.c: pmic_arb_apid_map_offset_v7());
+ *   - an entry is (ppid << 8) | flags and PPID is 12 bits
+ *     (PMIC_ARB_PPID_MASK = 0xfff), so masking 13 bits folds the reserved
+ *     bit 20 into the comparison.
+ *
+ * Reading the reserved 0x0b00 window is also what made each old scan read cost
+ * ~26 ms: those offsets are not implemented and the interconnect waits for a
+ * timeout.  The real table reads take a normal MMIO access.
+ *
+ * Only reads are used here: writing a PMIC register from a port with no PMIC
+ * driver would be able to change a rail, and nothing about the buttons needs
+ * it.  The arbiter's own command register is written; that is the SPMI master,
+ * not a PMIC register.
+ */
+#define SPMI_CORE_PA            0x0c400000u
+#define SPMI_CORE_SIZE          0x3000u
+#define SPMI_CFG0_PA            0x0c42d000u
+#define SPMI_CFG1_PA            0x0c432000u
+#define SPMI_CFG_SIZE           0x4000u
+#define SPMI_OBS_PA             0x0c440000u
+#define SPMI_OBS_SIZE           0x80000u
+
+#define SPMI_REG_VERSION        0x0000u
+#define SPMI_REG_FEATURES0      0x0004u
+#define SPMI_REG_FEATURES1      0x0008u
+#define SPMI_FEATURES_MASK      0x7ffu
+#define SPMI_APID_MAP(i)        (0x2000u + 4u * (i))
+#define SPMI_APID_MAX           1024u
+#define SPMI_PPID_MASK          0x0fffu
+#define SPMI_IRQ_OWNER          (1u << 24)
+#define SPMI_OWNER(apid)        (4u * (apid))
+
+#define SPMI_CH_CMD             0x00u
+#define SPMI_CH_STATUS          0x08u
+#define SPMI_CH_RDATA0          0x18u
+#define SPMI_CH_STRIDE          0x20u
+#define SPMI_OP_READ            15u
+#define SPMI_ST_DONE            (1u << 0)
+#define SPMI_ST_ERR             0x7eu
+
+#define PMIC_PON_RT_STS         0x1310u
+#define PMIC_PON_KPDPWR         (1u << 7)
+#define PMIC_PON_RESIN          (1u << 6)
+#define PMIC_VOLUP_RT_STS       0x8d10u
+#define PMIC_GPIO_VAL           (1u << 0)
+
+/* A real SPMI byte read is tens of microseconds.  Anything past this is a bad
+ * APID or an unimplemented offset; the hardware's own timeout can be ~26 ms,
+ * and waiting for it on every sample would make the poll useless. */
+#define PMIC_READ_TIMEOUT_NS    (20ull * 1000 * 1000)
+
+static vm_offset_t pmic_core, pmic_cfg0, pmic_cfg1, pmic_obs;
+static uint32_t pmic_bus0_apids, pmic_bus1_apids;
+static int liuqin_keys_chan;
+
+static uint64_t
+pmic_ns_since(uint64_t t0)
+{
+	uint64_t ns = 0;
+
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	return ns;
+}
+
+/* Owner (EE) of an APID.  v7 keeps one ownership table per bus, indexed from
+ * that bus's base APID, inside that bus's "cfg" region. */
+static uint32_t
+pmic_owner(uint32_t apid)
+{
+	if (apid < pmic_bus0_apids) {
+		return pmic_cfg0 == 0 ? 0xfu :
+		    (tch_rd(pmic_cfg0, SPMI_OWNER(apid)) & 0x7u);
+	}
+	if (apid < pmic_bus0_apids + pmic_bus1_apids) {
+		return pmic_cfg1 == 0 ? 0xfu :
+		    (tch_rd(pmic_cfg1,
+		    SPMI_OWNER(apid - pmic_bus0_apids)) & 0x7u);
+	}
+	return 0xfu;
+}
+
+/*
+ * One SPMI register read.  The command word is the arbiter's own format
+ * (opcode << 27 | register << 4 | byte-count-1); the channel reports
+ * completion in STATUS bit 0 and any bus failure in bits 1..6.
+ *
+ * The timeout is wall-clock.  If a read is aimed at an APID that is not
+ * mapped, the status read itself can take ~26 ms; the old fixed 4000-iteration
+ * loop would then wait for over a minute.
+ */
+static int
+pmic_read_ex(uint32_t apid, uint32_t addr, uint8_t *buf, size_t len,
+    uint32_t *status_out, uint64_t *ns_out)
+{
+	const uint32_t ch = apid * SPMI_CH_STRIDE;
+	const uint32_t cmd = (SPMI_OP_READ << 27) |
+	    ((addr & 0xffu) << 4) | (uint32_t)(len - 1);
+	const uint64_t t0 = mach_absolute_time();
+	uint32_t st = 0;
+	unsigned i;
+
+	tch_wr(pmic_obs, ch + SPMI_CH_CMD, cmd);
+	for (i = 0; i < 100000; i++) {
+		st = tch_rd(pmic_obs, ch + SPMI_CH_STATUS);
+		if ((st & SPMI_ST_DONE) != 0) {
+			break;
+		}
+		if (pmic_ns_since(t0) >= PMIC_READ_TIMEOUT_NS) {
+			break;
+		}
+		delay(1);
+	}
+	if (ns_out != NULL) {
+		*ns_out = pmic_ns_since(t0);
+	}
+	if (status_out != NULL) {
+		*status_out = st;
+	}
+	if ((st & SPMI_ST_DONE) == 0 || (st & SPMI_ST_ERR) != 0) {
+		return -1;
+	}
+	for (i = 0; i < len; i++) {
+		const uint32_t r = tch_rd(pmic_obs,
+		    ch + (i < 4 ? SPMI_CH_RDATA0 : SPMI_CH_RDATA0 + 4u));
+		buf[i] = (uint8_t)((r >> (8 * (i & 3))) & 0xff);
+	}
+	return 0;
+}
+
+static int
+pmic_read(uint32_t apid, uint32_t addr, uint8_t *buf, size_t len)
+{
+	return pmic_read_ex(apid, addr, buf, len, NULL, NULL);
+}
+
+/*
+ * touch183 keys-spmi-map: one diagnostic pass, then the normal 50 ms poll.
+ *
+ * The first SPMI access waits 120 s so this thread cannot shift the touch
+ * bring-up, which is the exact failure mode touch173 hit: its synchronous
+ * 3 x 768-entry scan in probe moved "touch clocks+pins ready" from 47 s to
+ * 130 s.  A thread of its own, started after the panel is up, costs nothing.
+ */
+static void
+liuqin_keys_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint32_t pon_apid = (uint32_t)-1, volup_apid = (uint32_t)-1;
+	uint32_t arb_version, features0, features1, count;
+	uint32_t apid, mapped, shown;
+	uint64_t t0, ns;
+	uint32_t status;
+	uint8_t v;
+	int slow;
+
+	if (pmic_core == 0 || pmic_obs == 0) {
+		return;
+	}
+	printf("LIUQIN KEYS: thread up, waiting 120 s before the first SPMI read\n");
+	(void)tsleep(&liuqin_keys_chan, PZERO, "liuqinkeys", 120 * hz);
+
+	t0 = mach_absolute_time();
+	arb_version = tch_rd(pmic_core, SPMI_REG_VERSION);
+	ns = pmic_ns_since(t0);
+	features0 = tch_rd(pmic_core, SPMI_REG_FEATURES0);
+	features1 = tch_rd(pmic_core, SPMI_REG_FEATURES1);
+	count = features0 & SPMI_FEATURES_MASK;
+	pmic_bus0_apids = count;
+	pmic_bus1_apids = features1 & SPMI_FEATURES_MASK;
+	printf("LIUQIN KEYS: arbiter version 0x%08x read in %llu ns\n",
+	    arb_version, ns);
+	printf("LIUQIN KEYS: features 0x%08x/0x%08x -> bus0 %u apids, bus1 %u apids\n",
+	    features0, features1, pmic_bus0_apids, pmic_bus1_apids);
+	if (arb_version < 0x70000000u || arb_version >= 0x80000000u) {
+		printf("LIUQIN KEYS: not a v7 arbiter (the 0x2000 table is v7-only), stopping\n");
+		return;
+	}
+	if (count == 0 || count > SPMI_APID_MAX) {
+		printf("LIUQIN KEYS: bad bus0 APID count, stopping\n");
+		return;
+	}
+	if (pmic_bus1_apids > SPMI_APID_MAX - count) {
+		pmic_bus1_apids = SPMI_APID_MAX - count;
+	}
+
+	/* The handoff's first guess: APID == PPID == 0x13.  One transaction,
+	 * before the table scan, tells us whether the bus works at all. */
+	if (pmic_read_ex(19, PMIC_PON_RT_STS, &v, 1, &status, &ns) == 0) {
+		printf("LIUQIN KEYS: direct apid 19 addr 0x1310 -> 0x%02x "
+		    "(status 0x%08x, %llu us)\n", v, status, ns / 1000ull);
+	} else {
+		printf("LIUQIN KEYS: direct apid 19 addr 0x1310 failed "
+		    "(status 0x%08x, %llu us)\n", status, ns / 1000ull);
+	}
+
+	/* Time the first table read: if the old 26 ms cost is still there, do
+	 * not stall for 20 s scanning 768 entries. */
+	t0 = mach_absolute_time();
+	(void)tch_rd(pmic_core, SPMI_APID_MAP(0));
+	ns = pmic_ns_since(t0);
+	slow = ns > 2000ull * 1000ull;
+	printf("LIUQIN KEYS: first map read at 0x%x took %llu ns%s\n",
+	    SPMI_APID_MAP(0), ns, slow ? " (slow: the scan yields every 64 APIDs)" : "");
+
+	{
+		uint32_t scanned;
+
+		t0 = mach_absolute_time();
+		mapped = 0;
+		shown = 0;
+		for (apid = 0; apid < count; apid++) {
+			const uint32_t m = tch_rd(pmic_core, SPMI_APID_MAP(apid));
+			const uint32_t ppid = (m >> 8) & SPMI_PPID_MASK;
+
+			if (m != 0) {
+				mapped++;
+				if (shown < 24) {
+					printf("LIUQIN KEYS: map[%u] ppid 0x%03x irq %u\n",
+					    apid, ppid, (m & SPMI_IRQ_OWNER) ? 1 : 0);
+					shown++;
+				}
+				if (ppid == 0x013 && pon_apid == (uint32_t)-1) {
+					pon_apid = apid;
+				}
+				if (ppid == 0x18d && volup_apid == (uint32_t)-1) {
+					volup_apid = apid;
+				}
+			}
+			if (pon_apid != (uint32_t)-1 && volup_apid != (uint32_t)-1) {
+				break;
+			}
+			if (slow && (apid & 63u) == 63u) {
+				printf("LIUQIN KEYS: bus0 scan %u/%u\n", apid + 1, count);
+				(void)tsleep(&liuqin_keys_chan, PZERO,
+				    "liuqinkeys", hz / 50);
+			}
+		}
+		scanned = (apid < count) ? apid + 1 : count;
+		ns = pmic_ns_since(t0);
+		printf("LIUQIN KEYS: bus0 scan %u apids in %llu us "
+		    "(%llu ns/read), %u mapped\n", scanned, ns / 1000ull,
+		    scanned ? ns / scanned : 0, mapped);
+	}
+	printf("LIUQIN KEYS: bus0 lookup: power 0x013 -> %d, volume up 0x18d -> %d\n",
+	    (int)pon_apid, (int)volup_apid);
+
+	/* If the PON block is not on bus 0, try bus 1.  v7 splits the APID
+	 * space: bus1 starts at bus0's count, and its table entries and
+	 * ownership table use the global APID. */
+	if ((pon_apid == (uint32_t)-1 || volup_apid == (uint32_t)-1) &&
+	    pmic_bus1_apids != 0) {
+		const uint32_t first = pmic_bus0_apids;
+		const uint32_t scan = pmic_bus1_apids;
+		uint32_t scanned;
+
+		printf("LIUQIN KEYS: trying bus1 apids %u..%u\n",
+		    first, first + scan - 1);
+		t0 = mach_absolute_time();
+		for (apid = first; apid < first + scan; apid++) {
+			const uint32_t m = tch_rd(pmic_core, SPMI_APID_MAP(apid));
+			const uint32_t ppid = (m >> 8) & SPMI_PPID_MASK;
+
+			if (m != 0) {
+				if (ppid == 0x013 && pon_apid == (uint32_t)-1) {
+					pon_apid = apid;
+				}
+				if (ppid == 0x18d && volup_apid == (uint32_t)-1) {
+					volup_apid = apid;
+				}
+			}
+			if (pon_apid != (uint32_t)-1 && volup_apid != (uint32_t)-1) {
+				break;
+			}
+			if (slow && ((apid - first) & 63u) == 63u) {
+				printf("LIUQIN KEYS: bus1 scan %u/%u\n",
+				    apid - first + 1, scan);
+				(void)tsleep(&liuqin_keys_chan, PZERO,
+				    "liuqinkeys", hz / 50);
+			}
+		}
+		scanned = (apid < first + scan) ? apid - first + 1 : scan;
+		ns = pmic_ns_since(t0);
+		printf("LIUQIN KEYS: bus1 scan %u apids in %llu us: "
+		    "power -> %d, volume up -> %d\n", scanned,
+		    ns / 1000ull, (int)pon_apid, (int)volup_apid);
+	}
+	if (pon_apid == (uint32_t)-1 && volup_apid == (uint32_t)-1) {
+		printf("LIUQIN KEYS: neither PPID found; stopping (no polling)\n");
+		return;
+	}
+	if (pon_apid != (uint32_t)-1) {
+		printf("LIUQIN KEYS: power/volume down ppid 0x013 -> apid %u "
+		    "(owner EE %u)\n", pon_apid, pmic_owner(pon_apid));
+	}
+	if (volup_apid != (uint32_t)-1) {
+		printf("LIUQIN KEYS: volume up ppid 0x18d -> apid %u "
+		    "(owner EE %u)\n", volup_apid, pmic_owner(volup_apid));
+	}
+
+	/* One annotated read of each register before the poll starts. */
+	{
+		uint8_t pon = 0;
+		uint8_t volup = 0;
+		uint32_t pon_st = 0, volup_st = 0;
+
+		if (pon_apid != (uint32_t)-1) {
+			if (pmic_read_ex(pon_apid, PMIC_PON_RT_STS, &pon, 1,
+			    &pon_st, NULL) == 0) {
+				printf("LIUQIN KEYS: pon reads 0x%02x "
+				    "(power %s, volume down %s)\n", pon,
+				    (pon & PMIC_PON_KPDPWR) ? "pressed" : "released",
+				    (pon & PMIC_PON_RESIN) ? "pressed" : "released");
+			} else {
+				printf("LIUQIN KEYS: pon read failed (status 0x%08x)\n",
+				    pon_st);
+				pon_apid = (uint32_t)-1;
+			}
+		}
+		if (volup_apid != (uint32_t)-1) {
+			if (pmic_read_ex(volup_apid, PMIC_VOLUP_RT_STS, &volup, 1,
+			    &volup_st, NULL) == 0) {
+				printf("LIUQIN KEYS: volume up reads 0x%02x "
+				    "(active low: %s)\n", volup,
+				    (volup & PMIC_GPIO_VAL) ? "released" : "pressed");
+			} else {
+				printf("LIUQIN KEYS: volume up read failed "
+				    "(status 0x%08x)\n", volup_st);
+				volup_apid = (uint32_t)-1;
+			}
+		}
+	}
+	if (pon_apid == (uint32_t)-1 && volup_apid == (uint32_t)-1) {
+		printf("LIUQIN KEYS: no readable key register, stopping\n");
+		return;
+	}
+
+	printf("LIUQIN KEYS: polling power/volume down every 50 ms; "
+	    "press a key (volume up is active low)\n");
+	{
+		uint8_t last_pon = 0, last_volup = 0;
+		bool power = false, voldown = false, volup = false;
+		unsigned agree_power = 0, agree_voldown = 0, agree_volup = 0;
+		unsigned failures = 0;
+		bool have_pon = false, have_volup = false;
+		const int ticks = (hz / 20) > 0 ? hz / 20 : 1;
+
+		for (;;) {
+			uint8_t pon = last_pon, vu = last_volup;
+			bool power_now = power, voldown_now = voldown;
+			bool volup_now = volup;
+
+			(void)tsleep(&liuqin_keys_chan, PZERO, "liuqinkeys", ticks);
+			if (pon_apid != (uint32_t)-1) {
+				if (pmic_read(pon_apid, PMIC_PON_RT_STS, &pon, 1) == 0) {
+					failures = 0;
+					have_pon = true;
+					power_now = (pon & PMIC_PON_KPDPWR) != 0;
+					voldown_now = (pon & PMIC_PON_RESIN) != 0;
+				} else {
+					failures++;
+				}
+			}
+			if (volup_apid != (uint32_t)-1) {
+				if (pmic_read(volup_apid, PMIC_VOLUP_RT_STS, &vu, 1) == 0) {
+					failures = 0;
+					have_volup = true;
+					/* DTS: gpios = <&pm8350_gpios 6 GPIO_ACTIVE_LOW> */
+					volup_now = (vu & PMIC_GPIO_VAL) == 0;
+				} else {
+					failures++;
+				}
+			}
+			if (failures >= 20) {
+				printf("LIUQIN KEYS: 20 consecutive SPMI failures, stopping\n");
+				return;
+			}
+			if ((have_pon && pon != last_pon) ||
+			    (have_volup && vu != last_volup)) {
+				printf("LIUQIN KEYS: raw pon 0x%02x volup 0x%02x\n",
+				    pon, vu);
+				last_pon = pon;
+				last_volup = vu;
+			}
+
+			/* Two equal samples (100 ms) debounce a press. */
+			if (power_now != power) {
+				if (++agree_power >= 2) {
+					power = power_now;
+					agree_power = 0;
+					pong_touch_post(power ? PONG_BUTTON_DOWN :
+					    PONG_BUTTON_UP, PONG_BUTTON_LOCK, 0, 0);
+					printf("LIUQIN KEYS: power %s\n",
+					    power ? "down" : "up");
+				}
+			} else {
+				agree_power = 0;
+			}
+			if (voldown_now != voldown) {
+				if (++agree_voldown >= 2) {
+					voldown = voldown_now;
+					agree_voldown = 0;
+					pong_touch_post(voldown ? PONG_BUTTON_DOWN :
+					    PONG_BUTTON_UP, PONG_BUTTON_VOLUME_DOWN, 0, 0);
+					printf("LIUQIN KEYS: volume down %s\n",
+					    voldown ? "down" : "up");
+				}
+			} else {
+				agree_voldown = 0;
+			}
+			if (volup_now != volup) {
+				if (++agree_volup >= 2) {
+					volup = volup_now;
+					agree_volup = 0;
+					pong_touch_post(volup ? PONG_BUTTON_DOWN :
+					    PONG_BUTTON_UP, PONG_BUTTON_VOLUME_UP, 0, 0);
+					printf("LIUQIN KEYS: volume up %s\n",
+					    volup ? "down" : "up");
+				}
+			} else {
+				agree_volup = 0;
+			}
+		}
+	}
+}
+
+/*
+ * touch183 keys-spmi-map: this diagnostic build enables the poller by default
+ * because the 567-byte boot line must not change.  The released driver keeps
+ * the keys off unless liuqinkeys=1; `liuqinkeys=0` still disables this build.
+ */
+static void
+liuqin_keys_start(void)
+{
+	int on = 1;
+	thread_t thread;
+
+	if (PE_parse_boot_argn("liuqinkeys", &on, sizeof(on)) && on == 0) {
+		printf("LIUQIN KEYS: disabled by liuqinkeys=0\n");
+		return;
+	}
+	pmic_core = ml_io_map(SPMI_CORE_PA, SPMI_CORE_SIZE);
+	pmic_obs = ml_io_map(SPMI_OBS_PA, SPMI_OBS_SIZE);
+	pmic_cfg0 = ml_io_map(SPMI_CFG0_PA, SPMI_CFG_SIZE);
+	pmic_cfg1 = ml_io_map(SPMI_CFG1_PA, SPMI_CFG_SIZE);
+	if (pmic_core == 0 || pmic_obs == 0) {
+		printf("LIUQIN KEYS: spmi map failed (core %d obs %d)\n",
+		    pmic_core != 0, pmic_obs != 0);
+		return;
+	}
+	printf("LIUQIN KEYS: touch183 diagnostic build, keys enabled by default "
+	    "(liuqinkeys=0 disables)\n");
+	if (kernel_thread_start(liuqin_keys_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("LIUQIN KEYS: thread not started\n");
+	}
+}
