+/*
+ * The QUPv3 serial engine control block.  These registers sit past the GENI
+ * window (0x0000..0x0fff) and past the firmware RAM (0x1000..0x1fff), and no
+ * run so far has ever read them.  geni_load_se_fw() programs exactly this
+ * block when it sets an engine's transfer mode: the DMA *interface* enable
+ * decides whether the engine may touch memory at all, and SE_FIFO_IF_DISABLE
+ * is the writable twin of the read-only GENI_IF_DISABLE_RO@0x64 (which reads
+ * 1 here).  An engine whose FIFO interface is disabled and whose DMA
+ * interface was never enabled takes a data command, holds it
+ * (GENI_STATUS.M_GENI_CMD_ACTIVE), moves nothing and raises no interrupt -
+ * which is what touch150 logged.
+ */
+#define SE_GENI_CLK_CTRL        0x2000
+#define SE_DMA_IF_EN            0x2004
+#define SE_FIFO_IF_DISABLE      0x2008
+#define DMA_IF_EN               (1u << 0)
+#define DMA_IF_EN_RO            0xe20
+
+/* SE_DMA_*_IRQ_STAT fields and the enable bits of geni_se_tx/rx_init_dma(). */
+#define TX_DMA_DONE             (1u << 0)
+#define TX_EOT                  (1u << 1)
+#define TX_SBE                  (1u << 2)
+#define TX_RESET_DONE           (1u << 3)
+#define RX_DMA_DONE             (1u << 0)
+#define RX_EOT                  (1u << 1)
+#define RX_SBE                  (1u << 2)
+#define RX_RESET_DONE           (1u << 3)
+#define GENI_SE_DMA_DONE_EN     (1u << 0)
+#define GENI_SE_DMA_EOT_EN      (1u << 1)
+#define GENI_SE_DMA_AHB_ERR_EN  (1u << 2)
+#define GENI_SE_DMA_EOT_BUF     (1u << 0)
+#define DMA_IRQ_EN              (GENI_SE_DMA_DONE_EN | GENI_SE_DMA_EOT_EN | GENI_SE_DMA_AHB_ERR_EN)
+#define SE_GSI_EVENT_EN         0xe18
+#define SE_IRQ_EN               0xe1c
+#define SE_HW_PARAM_0           0xe24
+#define SE_HW_PARAM_1           0xe28
+#define SE_DMA_GENERAL_CFG      0xe30
+
