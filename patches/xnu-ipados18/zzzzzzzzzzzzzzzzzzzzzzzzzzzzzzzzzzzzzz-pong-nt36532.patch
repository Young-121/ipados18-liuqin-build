+#define FW_REV_PROTOCOL_SHFT    8
+#define GENI_SE_SPI             1u
+
+/* SE_GENI_DMA_MODE_EN */
+#define GENI_DMA_MODE_EN        (1u << 0)
+
+/* GENI_M_CMD0 fields */
+#define M_OPCODE_SHFT           27
+#define M_PARAMS_MSK            0x07ffffffu
+
+/* GENI_M_CMD0 / M_CMD_CTRL opcodes and params for SPI.
+ *
+ * touch166 settled the duplex opcode: Linux's 3 (SPI_TX_ONLY | SPI_RX_ONLY) is
+ * the one this SE accepts - "rx route A1 opcode 3: 20 00 00 32 65 03 (MATCH)"
+ * against "opcode 7: 00 00 02 01 aa aa (no match)" in the same walk, same
+ * clock, same buffers.  Opcode 7 clocks the bytes out correctly (the wire
+ * capture has always matched) but the receive side reports garbage, which is
+ * why twenty rounds blamed the RX DMA, the packing and the pads.  The U-Boot
+ * driver this port copied 7 from is not the firmware in this SE. */
+#define SPI_TX_ONLY             1u
+#define SPI_RX_ONLY             2u
+#define SPI_DUPLEX              3u
+#define SPI_TX_RX               7u      /* what the vendor firmware wants; wrong here */
+#define SPI_CS_ASSERT           8u
+#define SPI_CS_DEASSERT         9u
+#define FRAGMENTATION           (1u << 2)
+
