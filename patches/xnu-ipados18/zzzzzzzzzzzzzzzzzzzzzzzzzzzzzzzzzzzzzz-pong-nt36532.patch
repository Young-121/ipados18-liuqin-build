+#define FORCE_DEFAULT           1u
+#define DEFAULT_IO_OUTPUT_CTRL_MSK 0x7fu
+#define DEFAULT_CGC_EN          0x7fu
+/* SE_DMA_GENERAL_CFG: the four clock-gating enables Linux always sets. */
+#define DMA_GENERAL_CFG_DEFAULT 0xfu
+/* SE_IRQ_EN: GENI_M_IRQ_EN | GENI_S_IRQ_EN | DMA_TX_IRQ_EN | DMA_RX_IRQ_EN */
+#define SE_IRQ_EN_DEFAULT       0xfu
