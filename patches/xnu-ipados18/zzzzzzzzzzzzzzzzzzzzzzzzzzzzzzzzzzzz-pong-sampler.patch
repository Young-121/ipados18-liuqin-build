+#if defined(ARM64_BOARD_CONFIG_PONG)
+#include <arm/thread.h>
+#include <vm/vm_shared_region_xnu.h>
+
+/*
+ * Pong process sampler: print the user pc/lr/sp and a short frame-pointer
+ * backtrace of every thread of a task.  bsd_init starts a thread that calls
+ * this for SpringBoard and backboardd, so a stuck userspace process can be
+ * attributed without rebuilding the OS image.
+ */
+void
+pong_sample_task(const char *name, int pid, task_t task)
+{
+	vm_map_t map = get_task_map(task);
+	uint64_t slide = 0;
+	int tn = 0;
+	thread_t thread;
+	vm_shared_region_t sr = vm_shared_region_get(task);
+
+	if (sr != NULL) {
+		slide = sr->sr_slide;
+		vm_shared_region_deallocate(sr);
+	}
+	printf("SMP %s[%d] slide 0x%llx mh 0x%llx\n", name, pid, slide,
+	    (uint64_t)task->mach_header_vm_address);
+
+	task_lock(task);
+	queue_iterate(&task->threads, thread, thread_t, task_threads) {
+		arm_saved_state_t *ss = find_user_regs(thread);
+		char line[240];
+		int n;
+		uint64_t fp;
+
+		if (ss == NULL || !is_saved_state64(ss)) {
+			continue;
+		}
+		fp = get_saved_state_fp(ss);
+		n = snprintf(line, sizeof(line), "SMP %s t%d pc 0x%llx lr 0x%llx sp 0x%llx bt",
+		    name, tn++, get_saved_state_pc(ss), get_saved_state_lr(ss),
+		    get_saved_state_sp(ss));
+		for (int i = 0; i < 10 && fp != 0 && (fp & 7) == 0 &&
+		    n < (int)sizeof(line) - 20; i++) {
+			uint64_t frame[2];
+			if (vm_map_read_user(map, fp, frame, sizeof(frame)) != KERN_SUCCESS) {
+				break;
+			}
+			n += snprintf(line + n, sizeof(line) - n, " 0x%llx", frame[1]);
+			if (frame[0] <= fp) {
+				break;
+			}
+			fp = frame[0];
+		}
+		printf("%s\n", line);
+	}
+	task_unlock(task);
+}
+#endif /* ARM64_BOARD_CONFIG_PONG */
+
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -562,6 +562,75 @@
 	}
 }
 #endif
+
+
+/* Pong: periodic SpringBoard/backboardd thread sampler (see exception.c). */
+extern void pong_sample_task(const char *name, int pid, task_t task);
+
+static char pong_sample_names[128];
+
+static bool
+pong_sample_wanted(const char *name)
+{
+	size_t n = strlen(name);
+	for (const char *t = pong_sample_names; *t;) {
+		const char *end = strchr(t, ',');
+		size_t tl = end ? (size_t)(end - t) : strlen(t);
+		if (tl == n && n > 0 && strncmp(t, name, n) == 0) {
+			return true;
+		}
+		if (!end) {
+			break;
+		}
+		t = end + 1;
+	}
+	return false;
+}
+
+static int
+pong_sample_proc(proc_t p, void *arg)
+{
+	char name[32];
+	task_t task;
+	(void)arg;
+	proc_name(proc_pid(p), name, sizeof(name));
+	if (pong_sample_wanted(name)) {
+		task = proc_task(p);
+		if (task != TASK_NULL) {
+			pong_sample_task(name, proc_pid(p), task);
+		}
+	}
+	return PROC_RETURNED;
+}
+
+static void
+pong_sample_thread(void *arg, wait_result_t wr)
+{
+	static int chan;
+	(void)arg;
+	(void)wr;
+	if (!PE_parse_boot_argn("pong_sample", pong_sample_names, sizeof(pong_sample_names))) {
+		strlcpy(pong_sample_names, "SpringBoard,backboardd", sizeof(pong_sample_names));
+	}
+	if (pong_sample_names[0] == '-') {
+		return;
+	}
+	(void)tsleep(&chan, PZERO, "pongsmpl", 60 * hz);
+	for (int i = 0; i < 15; i++) {
+		printf("SMP --- pong sample %d\n", i);
+		proc_iterate(PROC_ALLPROCLIST, pong_sample_proc, NULL, NULL, NULL);
+		(void)tsleep(&chan, PZERO, "pongsmpl", 60 * hz);
+	}
+}
+
+static void
+pong_sample_start(void)
+{
+	thread_t thread;
+	if (kernel_thread_start(pong_sample_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
 
 void
 bsd_init(void)
@@ -1247,6 +1316,7 @@
 	machine_timeout_bsd_init();
 #endif /* DEVELOPMENT || DEBUG */
 
+	pong_sample_start();
 	bsd_init_kprintf("done\n");
 }
 
