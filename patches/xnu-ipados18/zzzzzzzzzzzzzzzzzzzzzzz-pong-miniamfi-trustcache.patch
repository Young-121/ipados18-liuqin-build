+ * prelinked collection, so this stand-in performs the module validation and
+ * hash lookup the shared-cache registration path needs.
+ */
 
+static size_t
+mini_tc_entry_size(uint32_t version)
+{
+	switch (version) {
+	case kTCVersion0:
+		return sizeof(TrustCacheEntry0_t);
+	case kTCVersion1:
+		return sizeof(TrustCacheEntry1_t);
+	case kTCVersion2:
+		return sizeof(TrustCacheEntry2_t);
+	default:
+		return 0;
+	}
+}
+
+static bool
+mini_tc_module_shape(const TrustCacheModuleBase_t *module, size_t module_size,
+    uint32_t *version_out, uint32_t *count_out)
+{
+	uint32_t version;
+	uint32_t count;
+	size_t entry_size;
+
+	if (module == NULL || module_size < sizeof(TrustCacheModule2_t)) {
+		return false;
+	}
+	version = module->version;
+	entry_size = mini_tc_entry_size(version);
+	if (entry_size == 0) {
+		return false;
+	}
+	memcpy(&count, (const uint8_t *)module + 20, sizeof(count));
+	/* load_static_trust_cache() hands each module the whole remainder of
+	 * the trust cache segment, not just that module.  The module header's
+	 * count defines its real length; trailing modules/padding are fine. */
+	if (count > (module_size - sizeof(TrustCacheModule2_t)) / entry_size) {
+		return false;
+	}
+	if (version_out != NULL) {
+		*version_out = version;
+	}
+	if (count_out != NULL) {
+		*count_out = count;
+	}
+	return true;
+}
+
+static bool
+mini_tc_module_valid(const TrustCacheModuleBase_t *module, size_t module_size,
+    uint32_t *version_out, uint32_t *count_out)
+{
+	uint32_t version;
+	uint32_t count;
+	size_t entry_size;
+	const uint8_t *entries;
+
+	if (!mini_tc_module_shape(module, module_size, &version, &count)) {
+		return false;
+	}
+	if (version != kTCVersion0) {
+		entry_size = mini_tc_entry_size(version);
+		entries = (const uint8_t *)module + sizeof(TrustCacheModule2_t);
+		for (uint32_t i = 0; i < count; i++) {
+			const uint8_t *entry = entries + (size_t)i * entry_size;
+			uint8_t hash_type = entry[20];
+			if (hash_type < 1 || hash_type > 4) {
+				return false;
+			}
+			if (i != 0 && memcmp(entry - entry_size, entry, kTCEntryHashSize) >= 0) {
+				return false;
+			}
+		}
+	}
+	if (version_out != NULL) {
+		*version_out = version;
+	}
+	if (count_out != NULL) {
+		*count_out = count;
+	}
+	return true;
+}
+
+static const void *
+mini_tc_find(const TrustCache_t *trust_cache, const uint8_t cdhash[kTCEntryHashSize])
+{
+	uint32_t version;
+	uint32_t count;
+	size_t entry_size;
+	const uint8_t *entries;
+	size_t low;
+	size_t high;
+
+	if (trust_cache == NULL ||
+	    !mini_tc_module_shape(trust_cache->module, trust_cache->moduleSize, &version, &count)) {
+		return NULL;
+	}
+	entry_size = mini_tc_entry_size(version);
+	entries = (const uint8_t *)trust_cache->module + sizeof(TrustCacheModule2_t);
+	if (version == kTCVersion0) {
+		for (size_t i = 0; i < count; i++) {
+			if (memcmp(entries + i * entry_size, cdhash, kTCEntryHashSize) == 0) {
+				return entries + i * entry_size;
+			}
+		}
+		return NULL;
+	}
+	low = 0;
+	high = count;
+	while (low < high) {
+		size_t middle = low + (high - low) / 2;
+		const uint8_t *entry = entries + middle * entry_size;
+		int order = memcmp(entry, cdhash, kTCEntryHashSize);
+		if (order == 0) {
+			return entry;
+		}
+		if (order < 0) {
+			low = middle + 1;
+		} else {
+			high = middle;
+		}
+	}
+	return NULL;
+}
+
+static void
+mini_tc_link(TrustCacheRuntime_t *runtime, TCType_t type, TrustCache_t *trust_cache)
+{
+	TrustCache_t **head = NULL;
+
+	if (type == kTCTypeStatic) {
+		head = &runtime->staticTCHead;
+	} else if (type == kTCTypeEngineering) {
+		head = &runtime->engineeringTCHead;
+	} else if (type == kTCTypeLegacy && runtime->mutableRT != NULL) {
+		head = &runtime->mutableRT->loadableTCHead;
+	}
+	if (head != NULL) {
+		trust_cache->prev = NULL;
+		trust_cache->next = *head;
+		if (*head != NULL) {
+			(*head)->prev = trust_cache;
+		}
+		*head = trust_cache;
+	}
+}
